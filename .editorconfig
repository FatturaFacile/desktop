dotnet_diagnostic.ide0007.severity = error # Use var where appropriate
dotnet_diagnostic.ide0008.severity = error # Use explicit type when var is not preferred
dotnet_diagnostic.ide0011.severity = error # Add braces to if/else/loops
dotnet_diagnostic.ide0028.severity = error # Simplify collection initialization
dotnet_diagnostic.ide0040.severity = error # Add accessibility modifiers
dotnet_diagnostic.ide0044.severity = error # Add readonly modifier
dotnet_diagnostic.ide0051.severity = error # Remove unused private members
dotnet_diagnostic.ide0052.severity = error # Remove unread private members
dotnet_diagnostic.ide0055.severity = error # Fix formatting violations
dotnet_diagnostic.ide0059.severity = error # Remove unnecessary value assignment
dotnet_diagnostic.ide0060.severity = error # Remove unused parameter
dotnet_diagnostic.ide0065.severity = error # Placement of using directives
dotnet_diagnostic.ide0073.severity = error # File header required
dotnet_diagnostic.ide0130.severity = error # Namespace does not match folder structure
dotnet_diagnostic.ide0160.severity = error # Convert to block scoped namespace
dotnet_diagnostic.ide0161.severity = error # Convert to file-scoped namespace
dotnet_diagnostic.ide0290.severity = error # Use primary constructor
dotnet_diagnostic.ide0300.severity = error # Use collection expression

####################################################
# PERFORMANCE & RESOURCE MANAGEMENT
####################################################

dotnet_diagnostic.ca1805.severity = error # Do not initialize unnecessarily
dotnet_diagnostic.ca1806.severity = error # Do not ignore method results
dotnet_diagnostic.ca1812.severity = error # Avoid uninstantiated internal classes
dotnet_diagnostic.ca1819.severity = error # Properties should not return arrays
dotnet_diagnostic.ca1822.severity = error # Mark members as static
dotnet_diagnostic.ca1827.severity = error # Do not use Count()/LongCount() when Any() can be used
dotnet_diagnostic.ca1829.severity = error # Use Length/Count property instead of Enumerable.Count()
dotnet_diagnostic.ca1834.severity = error # Use StringBuilder.Append(char) instead of string
dotnet_diagnostic.ca1845.severity = error # Use string.Concat instead of string.Format/interpolation for primitives
dotnet_diagnostic.ca1852.severity = error # Seal internal types
dotnet_diagnostic.ca1860.severity = error # Avoid using Enumerable.Any() on empty checks where possible
dotnet_diagnostic.ca1871.severity = error # Do not pass a nullable struct to ArgumentNullException.ThrowIfNull
dotnet_diagnostic.ca2000.severity = error # Dispose objects before losing scope
dotnet_diagnostic.ca2007.severity = none # Consider calling ConfigureAwait on the awaited task (library projects)
dotnet_diagnostic.ca2016.severity = error # Forward the CancellationToken parameter to methods that take one

####################################################
# RELIABILITY, USAGE & DESIGN
####################################################

dotnet_diagnostic.ca1001.severity = error # Types that own disposable fields should be disposable
dotnet_diagnostic.ca1031.severity = error # Do not catch general exception types
dotnet_diagnostic.ca1062.severity = error # Validate arguments of public methods
dotnet_diagnostic.ca1063.severity = error # Implement IDisposable Correctly
dotnet_diagnostic.ca1303.severity = error # Do not pass literals as localized parameters
dotnet_diagnostic.ca1508.severity = error # Avoid dead conditional code
dotnet_diagnostic.ca1716.severity = error # Identifiers should not match keywords
dotnet_diagnostic.ca1720.severity = error # Identifier contains type name
dotnet_diagnostic.ca1724.severity = error # Type names should not match namespaces
dotnet_diagnostic.ca2201.severity = error # Do not raise reserved exception types (System.Exception, ApplicationException)
dotnet_diagnostic.ca2208.severity = error # Instantiate argument exceptions correctly
dotnet_diagnostic.ca2211.severity = error # Non-constant fields should not be visible
dotnet_diagnostic.ca2219.severity = error # Do not raise exceptions in exception clauses
dotnet_diagnostic.ca2254.severity = error # Template should be a static expression for logging methods

####################################################
# PUBLIC API INTEGRITY
####################################################

dotnet_public_api_analyzer.require_api_files = true

####################################################
# severity none
####################################################

# ReSharper properties
resharper_csharp_keep_existing_enum_arrangement = false
resharper_csharp_wrap_after_declaration_lpar = true
resharper_csharp_wrap_after_invocation_lpar = true
resharper_csharp_wrap_arguments_style = wrap_if_long
resharper_csharp_wrap_parameters_style = chop_always
resharper_empty_string = string_empty
resharper_instance_members_qualify_declared_in =
resharper_keep_existing_declaration_block_arrangement = false
resharper_keep_existing_embedded_block_arrangement = false
resharper_trailing_comma_in_multiline_lists = true
resharper_wrap_after_lambda_and_anonymous_function_declaration_lpar = false
resharper_csharp_max_line_length = 120
resharper_wrap_arguments_style = wrap_if_long

resharper_inconsistent_naming_highlighting = none

dotnet_diagnostic.sa1101.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.MA0051.severity = none

