{
  "compactThresholdPercent": 50,
  "maxBashOutputChars": 15000,
  "permissions": {
    "deny": [
      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./**/.vs/**)",
      "Read(./**/TestResults/**)",
      "Read(./**/installer/output/**)",
      "Read(./**/*.sqlite*)",
      "Read(./**/*.log)",
      "Read(./**/.env*)",
      "Read(./**/auth.json)"
    ]
  }
}
