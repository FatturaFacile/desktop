<UserControl
    x:Class="FatturaFacile.Wpf.Views.ExecutiveDssView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ExecutiveDssViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="DeltaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeltaState}" Value="Good">
                    <Setter Property="Foreground" Value="#3FB950" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeltaState}" Value="Bad">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SimDeltaText" TargetType="TextBlock" BasedOn="{StaticResource DeltaText}" />

        <DataTemplate x:Key="KpiCardTemplate" DataType="{x:Type viewModels:DssKpiCard}">
            <Border Style="{StaticResource CardBorder}" Width="230" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValueText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{lex:Loc Dss_NOT_AVAILABLE}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,6,0,0">
                        <syncfusion:SfChart
                            DockPanel.Dock="Right"
                            Width="110"
                            Height="40"
                            Visibility="{Binding HasSparkline, Converter={StaticResource BoolToVisibility}}">
                            <syncfusion:SfChart.PrimaryAxis>
                                <syncfusion:NumericalAxis Visibility="Collapsed" ShowGridLines="False" />
                            </syncfusion:SfChart.PrimaryAxis>
                            <syncfusion:SfChart.SecondaryAxis>
                                <syncfusion:NumericalAxis Visibility="Collapsed" ShowGridLines="False" />
                            </syncfusion:SfChart.SecondaryAxis>
                            <syncfusion:FastLineSeries ItemsSource="{Binding Sparkline}" XBindingPath="Index" YBindingPath="Value" />
                        </syncfusion:SfChart>
                        <TextBlock Text="{Binding DeltaText}" Style="{StaticResource DeltaText}" VerticalAlignment="Center" Visibility="{Binding HasDelta, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                    <ProgressBar Height="4" Maximum="100" Margin="0,8,0,0" Value="{Binding TargetProgress, Mode=OneWay, TargetNullValue=0}" Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlertTemplate" DataType="{x:Type viewModels:DssAlertItem}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6" BorderThickness="4,1,1,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SeverityText}" FontWeight="Bold" Width="90" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#58A6FF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                        <Setter Property="Foreground" Value="#F85149" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                                        <Setter Property="Foreground" Value="#D29922" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <DockPanel>
            <!-- Strategic filter ribbon -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{lex:Loc Dss_FilterEntity}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" Width="180" ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{lex:Loc Dss_FilterCurrency}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" Width="90" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{lex:Loc Dss_FilterPeriod}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" Width="130" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{lex:Loc Dss_FilterBaseline}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" Width="160" ItemsSource="{Binding Baselines}" SelectedItem="{Binding SelectedBaseline}" DisplayMemberPath="Label" />
                    </StackPanel>
                    <Button Command="{Binding SyncCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,0">
                        <TextBlock Text="{lex:Loc Dss_SyncNow}" />
                    </Button>
                    <Button Command="{Binding ExportBoardPackCommand}" CommandParameter="pdf" Style="{StaticResource ToolbarButton}" VerticalAlignment="Bottom" Margin="0,0,8,0">
                        <TextBlock Text="{lex:Loc Dss_EXPORT_BOARD_PACK}" />
                    </Button>
                    <Button Command="{Binding ExportBoardPackCommand}" CommandParameter="xlsx" Style="{StaticResource ToolbarButton}" VerticalAlignment="Bottom" Margin="0,0,12,0">
                        <TextBlock Text="{lex:Loc Dss_EXPORT_XLSX}" />
                    </Button>
                    <Border CornerRadius="10" Padding="10,2" VerticalAlignment="Bottom" Margin="0,0,10,2" Background="#238636" x:Name="ConnectionBadge">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#238636" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                        <Setter Property="Background" Value="#9E6A03" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{lex:Loc Dss_Online}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                            <Setter Property="Text" Value="{lex:Loc Dss_Offline}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding LastSyncedText}" Foreground="#8B949E" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </WrapPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,6,0,0" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Balanced scorecard -->
                    <TextBlock Text="{lex:Loc Dss_GROUP_FINANCIAL}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding FinancialKpis}" ItemTemplate="{StaticResource KpiCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{lex:Loc Dss_GROUP_CUSTOMER}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding CustomerKpis}" ItemTemplate="{StaticResource KpiCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{lex:Loc Dss_GROUP_EFFICIENCY}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding EfficiencyKpis}" ItemTemplate="{StaticResource KpiCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Strategic alerts -->
                    <TextBlock Text="{lex:Loc Dss_ALERTS_TITLE}" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                    <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertTemplate}" />
                    <TextBlock Text="{lex:Loc Dss_NO_ALERTS}" Foreground="#8B949E" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                            <Condition Binding="{Binding Alerts.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Variance bridge and Whale Curve -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{lex:Loc Dss_BRIDGE_TITLE}" Style="{StaticResource SectionHeader}" />
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{lex:Loc Dss_BRIDGE_REVENUE}" IsChecked="{Binding ShowRevenueBridge}" VerticalAlignment="Center" />
                                </DockPanel>
                                <syncfusion:SfChart Height="300" AutomationProperties.Name="{lex:Loc Dss_BRIDGE_TITLE}">
                                    <syncfusion:SfChart.PrimaryAxis>
                                        <syncfusion:CategoryAxis ShowGridLines="False" />
                                    </syncfusion:SfChart.PrimaryAxis>
                                    <syncfusion:SfChart.SecondaryAxis>
                                        <syncfusion:NumericalAxis />
                                    </syncfusion:SfChart.SecondaryAxis>
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="Base" Interior="Transparent" ShowTooltip="False" />
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="TotalPositive" Interior="#58A6FF" />
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="TotalNegative" Interior="#58A6FF" />
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="IncreasePositive" Interior="#3FB950" />
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="IncreaseNegative" Interior="#3FB950" />
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="DecreasePositive" Interior="#F85149" />
                                    <syncfusion:StackingColumnSeries ItemsSource="{Binding BridgeBars}" XBindingPath="Label" YBindingPath="DecreaseNegative" Interior="#F85149" />
                                </syncfusion:SfChart>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{lex:Loc Dss_WHALE_CURVE}" Style="{StaticResource SectionHeader}" />
                                <syncfusion:SfChart Height="300" AutomationProperties.Name="{lex:Loc Dss_WHALE_CURVE}">
                                    <syncfusion:SfChart.PrimaryAxis>
                                        <syncfusion:NumericalAxis ShowGridLines="False" Interval="1" />
                                    </syncfusion:SfChart.PrimaryAxis>
                                    <syncfusion:SfChart.SecondaryAxis>
                                        <syncfusion:NumericalAxis LabelFormat="0'%'" />
                                    </syncfusion:SfChart.SecondaryAxis>
                                    <syncfusion:LineSeries ItemsSource="{Binding WhalePoints}" XBindingPath="Rank" YBindingPath="CumulativeProfitPct" Label="{lex:Loc Dss_COL_NET_PROFIT}" />
                                </syncfusion:SfChart>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Profitability matrix -->
                    <TextBlock Text="{lex:Loc Dss_PROFIT_TITLE}" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                    <syncfusion:SfDataGrid
                        Height="320"
                        ItemsSource="{Binding MatrixRows}"
                        SelectedItem="{Binding SelectedMatrixRow, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        AllowSorting="True"
                        AllowGrouping="True"
                        ShowGroupDropArea="True"
                        AllowResizingColumns="True"
                        ColumnSizer="Auto"
                        SelectionMode="Single"
                        NavigationMode="Row">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="Rank" HeaderText="#" />
                            <syncfusion:GridTextColumn MappingName="Label" HeaderText="{lex:Loc Dss_COL_ENTITY}" />
                            <syncfusion:GridNumericColumn MappingName="NetRevenue" HeaderText="{lex:Loc Dss_COL_NET_REVENUE}" NumberDecimalDigits="0" />
                            <syncfusion:GridNumericColumn MappingName="GrossMargin" HeaderText="{lex:Loc Dss_COL_GROSS_MARGIN}" NumberDecimalDigits="0" />
                            <syncfusion:GridNumericColumn MappingName="ContributionMargin1" HeaderText="{lex:Loc Dss_COL_CM1}" NumberDecimalDigits="0" />
                            <syncfusion:GridNumericColumn MappingName="ContributionMargin2" HeaderText="{lex:Loc Dss_COL_CM2}" NumberDecimalDigits="0" />
                            <syncfusion:GridNumericColumn MappingName="Ebitda" HeaderText="{lex:Loc Dss_COL_EBITDA}" NumberDecimalDigits="0" />
                            <syncfusion:GridNumericColumn MappingName="NetOperatingProfit" HeaderText="{lex:Loc Dss_COL_NET_PROFIT}" NumberDecimalDigits="0" />
                            <syncfusion:GridNumericColumn MappingName="NetMarginPct" HeaderText="{lex:Loc Dss_COL_MARGIN_PCT}" NumberDecimalDigits="1">
                                <syncfusion:GridNumericColumn.CellStyle>
                                    <Style TargetType="syncfusion:GridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValueDestroying}" Value="True">
                                                <Setter Property="Foreground" Value="#F85149" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding InParetoCore}" Value="True">
                                                <Setter Property="Foreground" Value="#3FB950" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </syncfusion:GridNumericColumn.CellStyle>
                            </syncfusion:GridNumericColumn>
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <!-- What-if simulator -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,12">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ResetScenarioCommand}" Style="{StaticResource ToolbarButton}">
                                    <TextBlock Text="{lex:Loc Dss_SIM_RESET}" />
                                </Button>
                                <TextBlock Text="{lex:Loc Dss_WHATIF_TITLE}" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <TextBlock Text="{lex:Loc Dss_OfflineSimulator}" Foreground="#8B949E" FontSize="12" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <DockPanel><TextBlock Text="{Binding PricePct, StringFormat={}{0:+0.#;-0.#;0}%}" DockPanel.Dock="Right" Foreground="#8B949E" /><TextBlock Text="{lex:Loc Dss_SIM_PRICE_PCT}" Style="{StaticResource FieldLabel}" /></DockPanel>
                                    <Slider Minimum="-30" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding PricePct, Mode=TwoWay}" />
                                    <DockPanel><TextBlock Text="{Binding CogsPct, StringFormat={}{0:+0.#;-0.#;0}%}" DockPanel.Dock="Right" Foreground="#8B949E" /><TextBlock Text="{lex:Loc Dss_SIM_COGS_PCT}" Style="{StaticResource FieldLabel}" /></DockPanel>
                                    <Slider Minimum="-30" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding CogsPct, Mode=TwoWay}" />
                                    <DockPanel><TextBlock Text="{Binding OpexPct, StringFormat={}{0:+0.#;-0.#;0}%}" DockPanel.Dock="Right" Foreground="#8B949E" /><TextBlock Text="{lex:Loc Dss_SIM_OPEX_PCT}" Style="{StaticResource FieldLabel}" /></DockPanel>
                                    <Slider Minimum="-30" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding OpexPct, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <DockPanel><TextBlock Text="{Binding DsoDaysDelta, StringFormat={}{0:+0;-0;0}}" DockPanel.Dock="Right" Foreground="#8B949E" /><TextBlock Text="{lex:Loc Dss_SIM_DSO_DAYS_DELTA}" Style="{StaticResource FieldLabel}" /></DockPanel>
                                    <Slider Minimum="-60" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DsoDaysDelta, Mode=TwoWay}" />
                                    <DockPanel><TextBlock Text="{Binding FxShiftPct, StringFormat={}{0:+0.#;-0.#;0}%}" DockPanel.Dock="Right" Foreground="#8B949E" /><TextBlock Text="{lex:Loc Dss_SIM_FX_SHIFT_PCT}" Style="{StaticResource FieldLabel}" /></DockPanel>
                                    <Slider Minimum="-20" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding FxShiftPct, Mode=TwoWay}" />
                                    <DockPanel><TextBlock Text="{Binding FteDelta, StringFormat={}{0:+0;-0;0}}" DockPanel.Dock="Right" Foreground="#8B949E" /><TextBlock Text="{lex:Loc Dss_SIM_FTE_DELTA}" Style="{StaticResource FieldLabel}" /></DockPanel>
                                    <Slider Minimum="-20" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FteDelta, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{lex:Loc Dss_SIM_HINT}" Foreground="#8B949E" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSimulation}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SimulationRows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:DssSimulationRow}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Baseline}" Foreground="#8B949E" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Simulated}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource DeltaText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Drill-down detail of a profitability row -->
        <Border Background="#99000000" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardBorder}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Dss_Detail}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding DetailLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DssDetailLine}">
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Label}" Foreground="#8B949E" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding CloseDetailCommand}" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="{lex:Loc Dss_Close}" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
