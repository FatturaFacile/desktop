<UserControl
    x:Class="FatturaFacile.Wpf.Views.Copilot.CopilotDrawerView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FatturaFacile.Wpf.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:vm="clr-namespace:FatturaFacile.Wpf.ViewModels.Copilot"
    d:DataContext="{d:DesignInstance Type=vm:CopilotViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#58A6FF" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Visualization: chart (bar / line / pie), KPI card or table -->
        <DataTemplate DataType="{x:Type vm:CopilotVisualizationViewModel}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,4" TextWrapping="Wrap" />
                <syncfusion:SfChart
                    Height="220"
                    behaviors:CopilotChartBehavior.Visualization="{Binding Model}"
                    Visibility="{Binding IsChart, Converter={StaticResource BoolToVisibility}}" />
                <Border
                    Padding="14"
                    Background="#0D1117"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsKpi, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Metric}" FontSize="11" Foreground="#8B949E" />
                        <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" Foreground="#58A6FF" />
                    </StackPanel>
                </Border>
                <syncfusion:SfDataGrid
                    MaxHeight="260"
                    behaviors:BubbleMouseWheel.IsEnabled="True"
                    AllowSorting="True"
                    AutoGenerateColumns="True"
                    ColumnSizer="Auto"
                    ItemsSource="{Binding Table}"
                    Visibility="{Binding IsTable, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Human-in-the-loop action card -->
        <DataTemplate DataType="{x:Type vm:CopilotActionViewModel}">
            <Border Margin="0,8,0,0" Padding="10" Background="#0D1117" BorderBrush="#D29922" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Copilot_Action_Title}" FontSize="10" FontWeight="Bold" Foreground="#D29922" />
                    <TextBlock Text="{Binding Action.Summary}" Margin="0,4,0,6" Foreground="#E6EDF3" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CopilotDetailItem}">
                                <DockPanel Margin="0,1">
                                    <TextBlock Width="110" Text="{Binding Label}" Foreground="#8B949E" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Value}" Foreground="#E6EDF3" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding HasEditableFields, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{lex:Loc Copilot_Action_Editable}" Margin="0,8,0,4" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" />
                        <ItemsControl ItemsSource="{Binding EditableFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CopilotEditableFieldViewModel}">
                                    <DockPanel Margin="0,2">
                                        <TextBlock Width="110" VerticalAlignment="Center" Text="{Binding Path}" Foreground="#8B949E" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBox Padding="6,3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsPending, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <Button Margin="0,0,8,0" Padding="12,5" Command="{Binding ConfirmCommand}" Content="{lex:Loc Copilot_Action_Confirm}" />
                        <Button Padding="12,5" Command="{Binding RejectCommand}" Content="{lex:Loc Copilot_Action_Cancel}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#3FB950" Text="{Binding StatusText}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,4,0,0" Foreground="#E6EDF3" Text="{Binding ResultText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="#F85149" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One message -->
        <DataTemplate DataType="{x:Type vm:CopilotMessageViewModel}">
            <Border Margin="0,0,0,10" Padding="10" CornerRadius="8" HorizontalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#21262D" />
                        <Setter Property="Margin" Value="0,0,24,10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter Property="Background" Value="#1F3A5F" />
                                <Setter Property="Margin" Value="24,0,0,10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <FlowDocumentScrollViewer
                        behaviors:BubbleMouseWheel.IsEnabled="True"
                        behaviors:MarkdownBehavior.Citations="{Binding Citations}"
                        behaviors:MarkdownBehavior.LinkCommand="{Binding OpenLinkCommand}"
                        behaviors:MarkdownBehavior.Source="{Binding ContentMarkdown}"
                        HorizontalScrollBarVisibility="Disabled"
                        IsToolBarVisible="False"
                        VerticalScrollBarVisibility="Hidden" />
                    <StackPanel Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Activity}" FontSize="11" Foreground="#8B949E" />
                        <ProgressBar Height="3" Margin="0,4,0,0" IsIndeterminate="{Binding IsStreaming}" />
                    </StackPanel>
                    <ContentControl Content="{Binding Visualization}" />
                    <ContentControl Content="{Binding Action}" />
                    <ItemsControl ItemsSource="{Binding CitationChips}" Margin="0,8,0,0" Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CopilotCitationViewModel}">
                                <Button
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding Citation}"
                                    Content="{Binding Label}"
                                    Style="{StaticResource ChipButton}"
                                    ToolTip="{Binding ToolTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1,0,0,0">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#E6EDF3" Text="{lex:Loc Copilot_Title}" />
                <Button DockPanel.Dock="Right" Padding="8,3" Command="{Binding CloseCommand}" Content="✕" ToolTip="{lex:Loc Copilot_Close}" />
                <Button DockPanel.Dock="Right" Margin="0,0,6,0" Padding="8,3" Command="{Binding DeleteConversationCommand}" Content="🗑" ToolTip="{lex:Loc Copilot_Delete}" />
                <Button DockPanel.Dock="Right" Margin="0,0,6,0" Padding="8,3" Command="{Binding NewConversationCommand}" Content="＋" ToolTip="{lex:Loc Copilot_New}" />
            </DockPanel>

            <!-- Online-required badge: live model calls need a connection, cached history stays viewable -->
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6" Background="#3B2A12" BorderBrush="#D29922" BorderThickness="1" CornerRadius="6" Visibility="{Binding ShowOnlineBadge, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Foreground="#D29922" Text="{lex:Loc Copilot_OnlineRequired}" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="#C9A55B" Text="{lex:Loc Copilot_OfflineCached}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ComboBox Grid.Row="2" Margin="0,0,0,8" DisplayMemberPath="Title" ItemsSource="{Binding Conversations}" ToolTip="{lex:Loc Copilot_History}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectConversationCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock Margin="8" Foreground="#8B949E" Text="{lex:Loc Copilot_Empty}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Messages}" />
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Margin="0,6,0,0" Foreground="#D29922" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

            <DockPanel Grid.Row="5" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Command="{Binding SendCommand}" Content="{lex:Loc Copilot_Send}" />
                <TextBox
                    Padding="8,6"
                    VerticalContentAlignment="Center"
                    behaviors:FocusOnRequest.Request="{Binding FocusRequest}"
                    MaxLength="4000"
                    Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{lex:Loc Copilot_Placeholder}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
