<UserControl
    x:Class="FatturaFacile.Wpf.Views.ProductsView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ProductsViewModel}"
    mc:Ignorable="d">
<DockPanel Margin="16">
<Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10" Background="#1E232A" CornerRadius="6">
<DockPanel LastChildFill="False">
<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
<Button Command="{Binding LoadCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Refresh}" />
</Button>
</StackPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#8B949E" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
</DockPanel>
</Border>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*" />
<ColumnDefinition Width="480" />
</Grid.ColumnDefinitions>
<Border Grid.Column="0" Margin="0,0,12,0">
<syncfusion:SfDataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" >
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="Sku" HeaderText="{lex:Loc Products_Sku}" />
<syncfusion:GridTextColumn MappingName="Name" HeaderText="{lex:Loc Products_Name}" />
<syncfusion:GridTextColumn MappingName="UnitMeasure" HeaderText="{lex:Loc Products_Uom}" />
<syncfusion:GridCurrencyColumn MappingName="SalePrice" HeaderText="{lex:Loc Products_SalePrice}" CurrencySymbol="" />
<syncfusion:GridNumericColumn MappingName="TaxRate" HeaderText="{lex:Loc Products_TaxRate}" NumberDecimalDigits="2" />
<syncfusion:GridCheckBoxColumn MappingName="IsActive" HeaderText="{lex:Loc Common_Active}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
</Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
<Border Style="{StaticResource CardBorder}">
<StackPanel>
<TextBlock Text="{lex:Loc Products_Edit}" Style="{StaticResource SectionHeader}" />
<WrapPanel>
<StackPanel Width="120">
<TextBlock Text="{lex:Loc Products_Sku}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Sku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="260">
<TextBlock Text="{lex:Loc Products_Name}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="140">
<TextBlock Text="{lex:Loc Products_Barcode}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Barcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<StackPanel Width="420">
<TextBlock Text="{lex:Loc Common_Description}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<StackPanel Width="70">
<TextBlock Text="{lex:Loc Products_Uom}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.UnitMeasure, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="120">
<TextBlock Text="{lex:Loc Products_SalePrice}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.SalePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="120">
<TextBlock Text="{lex:Loc Products_CostPrice}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.CostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Products_TaxRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.TaxRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<CheckBox IsChecked="{Binding Editing.TrackInventory}" Content="{lex:Loc Products_Track}" Foreground="#E6EDF3" Margin="0,18,12,10" Width="150" />
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Products_MinStock}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.MinStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<CheckBox IsChecked="{Binding Editing.IsActive}" Content="{lex:Loc Common_Active}" Foreground="#E6EDF3" Margin="0,18,12,10" Width="80" />
</WrapPanel>
<StackPanel Orientation="Horizontal">
<Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
<TextBlock Text="{lex:Loc Common_Save}" />
</Button>
<Button Command="{Binding NewCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_New}" />
</Button>
<Button Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Delete}" />
</Button>
</StackPanel>
</StackPanel>
</Border>
</ScrollViewer>
</Grid>
</DockPanel>
</UserControl>
