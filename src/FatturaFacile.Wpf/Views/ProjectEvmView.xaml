<UserControl
    x:Class="FatturaFacile.Wpf.Views.ProjectEvmView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ProjectEvmViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="LightDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Fill" Value="#3FB950" />
        </Style>

        <Style x:Key="LightText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3FB950" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CpiLightText" TargetType="TextBlock" BasedOn="{StaticResource LightText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CpiLight}" Value="Amber">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CpiLight}" Value="Red">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpiLightText" TargetType="TextBlock" BasedOn="{StaticResource LightText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpiLight}" Value="Amber">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SpiLight}" Value="Red">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowCpiText" TargetType="TextBlock" BasedOn="{StaticResource LightText}">
            <Setter Property="Text" Value="{Binding Cpi}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CpiLight}" Value="Amber">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CpiLight}" Value="Red">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowSpiText" TargetType="TextBlock" BasedOn="{StaticResource LightText}">
            <Setter Property="Text" Value="{Binding Spi}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpiLight}" Value="Amber">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SpiLight}" Value="Red">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="KpiCard">
            <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                <ContentPresenter Content="{Binding}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <DockPanel Margin="0,0,0,12">
                <Button
                    DockPanel.Dock="Right"
                    Command="{Binding SyncCommand}"
                    Content="{lex:Loc ProjectEvm_Sync}"
                    Padding="14,6" />
                <TextBlock Text="{lex:Loc ProjectEvm_Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="{lex:Loc ProjectEvm_Project}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox
                    Width="320"
                    ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject}"
                    DisplayMemberPath="Label" />
                <TextBlock Text="{Binding LastSyncedText}" Foreground="#8B949E" VerticalAlignment="Center" Margin="16,0,0,0" />
            </WrapPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#D29922" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <WrapPanel Visibility="{Binding HasFigures, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ProjectEvm_Bac}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{Binding BacText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ProjectEvm_Cpi}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{Binding CpiText}" FontSize="20" Margin="0,4,0,0" Style="{StaticResource CpiLightText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ProjectEvm_Spi}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{Binding SpiText}" FontSize="20" Margin="0,4,0,0" Style="{StaticResource SpiLightText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ProjectEvm_Eac}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{Binding EacText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding VacText}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{lex:Loc ProjectEvm_ManualEtc}" Foreground="#58A6FF" FontSize="11" Visibility="{Binding HasManualEtc, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ProjectEvm_Margin}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{Binding MarginText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ProjectEvm_Absorption}" Foreground="#8B949E" FontSize="12" />
                        <TextBlock Text="{Binding AbsorptionText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ProgressBar Height="4" Maximum="100" Margin="0,6,0,0" Value="{Binding AbsorptionPercent, Mode=OneWay}" />
                        <TextBlock Text="{lex:Loc ProjectEvm_AbsorptionWarning}" Foreground="#D29922" FontSize="11" TextWrapping="Wrap" Visibility="{Binding AbsorptionWarning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="{Binding AlertText}" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="{Binding HasFigures, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc ProjectEvm_Scurve}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <syncfusion:SfChart Height="260">
                        <syncfusion:SfChart.Legend>
                            <syncfusion:ChartLegend />
                        </syncfusion:SfChart.Legend>
                        <syncfusion:SfChart.PrimaryAxis>
                            <syncfusion:DateTimeAxis LabelFormat="MMM yy" />
                        </syncfusion:SfChart.PrimaryAxis>
                        <syncfusion:SfChart.SecondaryAxis>
                            <syncfusion:NumericalAxis />
                        </syncfusion:SfChart.SecondaryAxis>
                        <syncfusion:LineSeries ItemsSource="{Binding ScurvePoints}" XBindingPath="Date" YBindingPath="Pv" Label="PV" />
                        <syncfusion:LineSeries ItemsSource="{Binding ScurvePoints}" XBindingPath="Date" YBindingPath="Ev" Label="EV" />
                        <syncfusion:LineSeries ItemsSource="{Binding ScurvePoints}" XBindingPath="Date" YBindingPath="Ac" Label="AC" />
                        <syncfusion:LineSeries ItemsSource="{Binding ForecastPoints}" XBindingPath="Date" YBindingPath="Eac" Label="EAC" StrokeDashArray="4,3" />
                    </syncfusion:SfChart>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc ProjectEvm_Waterfall}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding WaterfallSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" />
                                        <TextBlock Text="{Binding Label}" />
                                    </DockPanel>
                                    <ProgressBar Height="6" Maximum="100" Value="{Binding Share, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc ProjectEvm_Wbs}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        CanUserAddRows="False"
                        ItemsSource="{Binding Rows}"
                        MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{lex:Loc ProjectEvm_ColWbs}" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="{Binding Indent}">
                                            <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColBac}" Binding="{Binding Bac}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColCommitted}" Binding="{Binding Committed}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColActual}" Binding="{Binding Actual}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColExposure}" Binding="{Binding Exposure}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColEv}" Binding="{Binding Ev}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColPv}" Binding="{Binding Pv}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColCv}" Binding="{Binding Cv}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColSv}" Binding="{Binding Sv}" />
                            <DataGridTemplateColumn Header="{lex:Loc ProjectEvm_ColCpi}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource RowCpiText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{lex:Loc ProjectEvm_ColSpi}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource RowSpiText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColEac}" Binding="{Binding Eac}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColEtc}" Binding="{Binding Etc}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColVac}" Binding="{Binding Vac}" />
                            <DataGridTextColumn Header="{lex:Loc ProjectEvm_ColMargin}" Binding="{Binding Margin}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="{Binding HasReconciliation, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc ProjectEvm_ReconTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ReconciliationText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReconciliationState}" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
