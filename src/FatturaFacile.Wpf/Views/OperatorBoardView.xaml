<UserControl
    x:Class="FatturaFacile.Wpf.Views.OperatorBoardView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:OperatorBoardViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TouchButton" TargetType="Button">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryTouchButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="BorderBrush" Value="#2EA043" />
        </Style>

        <Style x:Key="WarningTouchButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Background" Value="#9E6A03" />
            <Setter Property="BorderBrush" Value="#D29922" />
        </Style>

        <Style x:Key="DangerTouchButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Background" Value="#B62324" />
            <Setter Property="BorderBrush" Value="#F85149" />
        </Style>

        <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="FontSize" Value="24" />
        </Style>

        <Style x:Key="FieldButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Good" />
                        <Condition Binding="{Binding DataContext.IsScrapActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#58A6FF" />
                    <Setter Property="BorderThickness" Value="3" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Scrap" />
                        <Condition Binding="{Binding DataContext.IsScrapActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#58A6FF" />
                    <Setter Property="BorderThickness" Value="3" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CounterText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="BannerBorder" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <DataTemplate x:Key="PhaseCardTemplate" DataType="{x:Type viewModels:MesPhaseCard}">
            <Border Style="{StaticResource CardBorder}" Width="460" Margin="0,0,12,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding OrderNumber}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding ItemText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OperationText}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1F6FEB" CornerRadius="12" Padding="12,4" VerticalAlignment="Top">
                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding OpenIntervalText}" Foreground="#58A6FF" FontSize="13" Margin="0,6,0,0" />

                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{lex:Loc Mes_Man}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding ManText}" Style="{StaticResource CounterText}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{lex:Loc Mes_Machine}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding MachineText}" Style="{StaticResource CounterText}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{lex:Loc Mes_Downtime}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding DowntimeText}" Style="{StaticResource CounterText}" Foreground="#F0883E" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Mes_Setup}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding SetupText}" FontSize="16" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Mes_Run}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding RunText}" FontSize="16" FontFamily="Consolas" />
                        </StackPanel>
                    </UniformGrid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Mes_Good}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding GoodText}" Style="{StaticResource CounterText}" Foreground="#3FB950" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{lex:Loc Mes_Scrap}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding ScrapText}" Style="{StaticResource CounterText}" Foreground="#F85149" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{lex:Loc Mes_Target}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource CounterText}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,10" Foreground="#3FB950" Background="#30363D" />

                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryTouchButton}" Content="{lex:Loc Mes_Action_TakeOver}"
                                Command="{Binding DataContext.TakeOverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Action_StartSetup}"
                                Command="{Binding DataContext.StartSetupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanStartSetup, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource PrimaryTouchButton}" Content="{lex:Loc Mes_Action_StartAttended}"
                                Command="{Binding DataContext.StartAttendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanStartProduction, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Action_StartUnattended}"
                                Command="{Binding DataContext.StartUnattendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanStartProduction, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource PrimaryTouchButton}" Content="{lex:Loc Mes_Action_Resume}"
                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource WarningTouchButton}" Content="{lex:Loc Mes_Action_Suspend}"
                                Command="{Binding DataContext.OpenSuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanSuspend, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Action_DeclareProduction}"
                                Command="{Binding DataContext.OpenDeclarationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanDeclare, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Action_ConsumeMaterial}"
                                Command="{Binding DataContext.OpenLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanConsume, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource DangerTouchButton}" Content="{lex:Loc Mes_Action_Close}"
                                Command="{Binding DataContext.OpenCloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KeypadTemplate">
            <UniformGrid Columns="3" Width="300">
                <Button Style="{StaticResource KeypadButton}" Content="7" Command="{Binding KeypadCommand}" CommandParameter="7" />
                <Button Style="{StaticResource KeypadButton}" Content="8" Command="{Binding KeypadCommand}" CommandParameter="8" />
                <Button Style="{StaticResource KeypadButton}" Content="9" Command="{Binding KeypadCommand}" CommandParameter="9" />
                <Button Style="{StaticResource KeypadButton}" Content="4" Command="{Binding KeypadCommand}" CommandParameter="4" />
                <Button Style="{StaticResource KeypadButton}" Content="5" Command="{Binding KeypadCommand}" CommandParameter="5" />
                <Button Style="{StaticResource KeypadButton}" Content="6" Command="{Binding KeypadCommand}" CommandParameter="6" />
                <Button Style="{StaticResource KeypadButton}" Content="1" Command="{Binding KeypadCommand}" CommandParameter="1" />
                <Button Style="{StaticResource KeypadButton}" Content="2" Command="{Binding KeypadCommand}" CommandParameter="2" />
                <Button Style="{StaticResource KeypadButton}" Content="3" Command="{Binding KeypadCommand}" CommandParameter="3" />
                <Button Style="{StaticResource KeypadButton}" Content="." Command="{Binding KeypadCommand}" CommandParameter="." />
                <Button Style="{StaticResource KeypadButton}" Content="0" Command="{Binding KeypadCommand}" CommandParameter="0" />
                <Button Style="{StaticResource KeypadButton}" Content="⌫" Command="{Binding KeypadCommand}" CommandParameter="back" />
                <Button Style="{StaticResource KeypadButton}" Content="C" Command="{Binding KeypadCommand}" CommandParameter="clear" />
                <Button Style="{StaticResource KeypadButton}" Content="+1" Command="{Binding AddPiecesCommand}" CommandParameter="1" />
                <Button Style="{StaticResource KeypadButton}" Content="+10" Command="{Binding AddPiecesCommand}" CommandParameter="10" />
            </UniformGrid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{lex:Loc Mes_Title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding WorkCenters}" SelectedItem="{Binding SelectedWorkCenter}" DisplayMemberPath="Display"
                          MinHeight="48" FontSize="16" MaxWidth="520" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Refresh}" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_SendPending}" Command="{Binding FlushCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource BannerBorder}" Background="#3D2E00" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{lex:Loc Mes_Offline}" Foreground="#E3B341" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastSyncedText}" Foreground="#E3B341" Margin="12,0,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{lex:Loc Mes_Pending}" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{Binding PendingCount}" Foreground="#E6EDF3" FontWeight="SemiBold" Margin="6,0,0,0" />
                <TextBlock Text="{Binding LastSyncedText}" Style="{StaticResource CaptionText}" Margin="16,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource BannerBorder}" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}" Background="#3C1618">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Mes_ConflictsTitle}" Foreground="#FF7B72" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Conflicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:MesConflictItem}">
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Foreground="#FFA198">
                                        <Run Text="{Binding ActionText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                                        <Run Text="—" />
                                        <Run Text="{Binding Error, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Grid.Column="1" Style="{StaticResource TouchButton}" MinHeight="40" Content="{lex:Loc Mes_Dismiss}"
                                            Command="{Binding DataContext.DismissConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#3FB950" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#FF7B72" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <Grid>
                <ItemsControl ItemsSource="{Binding Phases}" ItemTemplate="{StaticResource PhaseCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC0D1117" Visibility="{Binding IsAnyPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760" Visibility="{Binding IsSuspendPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Mes_SuspendTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding SuspensionReasons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource WarningTouchButton}" MinWidth="210" MinHeight="72" Content="{Binding Label}"
                                            Command="{Binding DataContext.ConfirmSuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Cancel}" Command="{Binding ClosePanelCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsDeclarePanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Mes_DeclareTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,0">
                                <Button Style="{StaticResource FieldButton}" Command="{Binding SelectGoodFieldCommand}" Tag="Good">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Mes_Good}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding DeclarationGood}" FontSize="32" Foreground="#3FB950" FontFamily="Consolas" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FieldButton}" Command="{Binding SelectScrapFieldCommand}" Tag="Scrap">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Mes_Scrap}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding DeclarationScrap}" FontSize="32" Foreground="#F85149" FontFamily="Consolas" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{lex:Loc Mes_DefectReason}" Style="{StaticResource CaptionText}" Margin="4,12,0,4" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource KeypadTemplate}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DefectReasons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel MaxWidth="700" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TouchButton}" MinHeight="48" Content="{Binding Label}"
                                            Command="{Binding DataContext.ChooseDefectReasonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="4,6,0,0" FontSize="14" Foreground="#E3B341">
                            <Run Text="{lex:Loc Mes_DefectChosen}" />
                            <Run Text="{Binding SelectedDefectReason.Label, Mode=OneWay, FallbackValue=—}" FontWeight="SemiBold" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Cancel}" Command="{Binding ClosePanelCommand}" />
                            <Button Style="{StaticResource PrimaryTouchButton}" Content="{lex:Loc Mes_Confirm}" Command="{Binding ConfirmDeclarationCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLotPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Mes_LotTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="360" Margin="0,0,24,0">
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TouchButton}" HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.ChooseComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding ItemCode, Mode=OneWay}" />
                                                    <Run Text="{Binding ItemName, Mode=OneWay}" FontWeight="Normal" />
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedComponent.ItemCode, FallbackValue=—}" Foreground="#58A6FF" FontWeight="SemiBold" Margin="4,8,0,0" />
                                <TextBlock Text="{lex:Loc Mes_LotCode}" Style="{StaticResource CaptionText}" Margin="4,10,0,4" />
                                <TextBox x:Name="LotCodeBox" IsVisibleChanged="OnLotCodeBoxVisibleChanged" Text="{Binding LotCode, UpdateSourceTrigger=PropertyChanged}" FontSize="22" MinHeight="56" CharacterCasing="Upper" VerticalContentAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding ConfirmLotCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="{lex:Loc Mes_Quantity}" Style="{StaticResource CaptionText}" Margin="4,10,0,4" />
                                <TextBlock Text="{Binding LotQuantity}" FontSize="32" FontFamily="Consolas" Margin="4,0,0,0" />
                                <CheckBox Content="{lex:Loc Mes_OverConsumption}" IsChecked="{Binding OverConsumptionConfirmed}" FontSize="15" Margin="4,10,0,0"
                                          Visibility="{Binding NeedsOverConsumptionConfirm, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource KeypadTemplate}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Cancel}" Command="{Binding ClosePanelCommand}" />
                            <Button Style="{StaticResource PrimaryTouchButton}" Content="{lex:Loc Mes_Confirm}" Command="{Binding ConfirmLotCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Visibility="{Binding IsClosePanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Mes_CloseTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="{lex:Loc Mes_CloseMessage}" TextWrapping="Wrap" FontSize="15" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource TouchButton}" Content="{lex:Loc Mes_Cancel}" Command="{Binding ClosePanelCommand}" />
                            <Button Style="{StaticResource DangerTouchButton}" Content="{lex:Loc Mes_Action_Close}" Command="{Binding ConfirmCloseCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
