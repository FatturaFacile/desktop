<UserControl
    x:Class="FatturaFacile.Wpf.Views.PrimaNotaEntryView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:PrimaNotaViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="BalanceText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F85149" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                    <Setter Property="Foreground" Value="#3FB950" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!-- Header: ledger book, posting date, description -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{lex:Loc Gl_Ledger}" Foreground="#8B949E" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding LedgerBooks}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLedger, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{lex:Loc Accounting_PostingDate}" Foreground="#8B949E" Margin="0,0,0,2" />
                    <DatePicker SelectedDate="{Binding PostingDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{lex:Loc Accounting_Description}" Foreground="#8B949E" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!-- Template (causale contabile) hydration -->
            <Border Padding="8" Margin="0,0,0,8" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding PullTemplatesCommand}" Content="{lex:Loc Gl_PullTemplates}" Margin="8,0,0,0" Padding="10,4" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{lex:Loc Gl_Template}" Foreground="#8B949E" Margin="0,0,0,2" />
                                <ComboBox Width="260" ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{lex:Loc Gl_TemplateAmount}" Foreground="#8B949E" Margin="0,0,0,2" />
                                <TextBox Width="110" Text="{Binding TemplateAmount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" Visibility="{Binding TemplateNeedsRate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{lex:Loc Gl_TemplateRate}" Foreground="#8B949E" Margin="0,0,0,2" />
                                <TextBox Width="70" Text="{Binding TemplateTaxRate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button VerticalAlignment="Bottom" Command="{Binding ApplyTemplateCommand}" Content="{lex:Loc Gl_ApplyTemplate}" Padding="10,4" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TemplateAccounts}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock Text="{Binding Key}" Foreground="#8B949E" Margin="0,0,0,2" />
                                    <ComboBox Width="260" ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="DisplayText" SelectedItem="{Binding Account, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Lines -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{lex:Loc Gl_Account}" Foreground="#58A6FF" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{lex:Loc Accounting_Debit}" Foreground="#58A6FF" FontWeight="Bold" Margin="4,0" />
                <TextBlock Grid.Column="2" Text="{lex:Loc Accounting_Credit}" Foreground="#58A6FF" FontWeight="Bold" Margin="4,0" />
                <TextBlock Grid.Column="3" Text="{lex:Loc Accounting_Description}" Foreground="#58A6FF" FontWeight="Bold" Margin="4,0" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=ItemsControl}}" DisplayMemberPath="DisplayText" SelectedItem="{Binding Account, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Margin="4,0" HorizontalContentAlignment="Right" Text="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Margin="4,0" HorizontalContentAlignment="Right" Text="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="3" Margin="4,0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4" Content="X" ToolTip="{lex:Loc Gl_RemoveLine}" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left" Margin="0,4,0,8" Padding="10,4" Command="{Binding AddLineCommand}" Content="{lex:Loc Gl_AddLine}" />

            <!-- Live Dare / Avere / Differenza -->
            <Border Padding="10" Background="#1E232A" CornerRadius="6" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="{lex:Loc Gl_TotalDebit}" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                        <TextBlock Text="{lex:Loc Gl_TotalCredit}" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" FontWeight="Bold" Margin="6,0,24,0" VerticalAlignment="Center" />
                        <TextBlock Text="{lex:Loc Gl_Difference}" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Difference, StringFormat=N2}" Style="{StaticResource BalanceText}" Margin="6,0,24,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BalanceMessage}" Style="{StaticResource BalanceText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Command="{Binding NewEntryCommand}" Content="{lex:Loc Gl_NewEntry}" Margin="0,0,8,0" Padding="12,6" />
                        <Button Command="{Binding SaveDraftCommand}" Content="{lex:Loc Gl_SaveDraft}" Margin="0,0,8,0" Padding="12,6" />
                        <Button Command="{Binding PostCommand}" Content="{lex:Loc Gl_Post}" Padding="12,6" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#8B949E" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
