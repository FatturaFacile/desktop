<Window
    x:Class="FatturaFacile.Wpf.Views.ReportPreviewWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pdfviewer="clr-namespace:Syncfusion.Windows.PdfViewer;assembly=Syncfusion.PdfViewer.WPF"
    xmlns:sfSkinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ReportPreviewViewModel}"
    mc:Ignorable="d"
    sfSkinManager:SfSkinManager.VisualStyle="FluentDark"
    Title="{Binding Title}"
    Width="1000"
    Height="860"
    Background="#0D1117"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Background="#1E232A">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Command="{Binding ArchiveCommand}" Style="{StaticResource PrimaryButton}">
                    <TextBlock Text="{lex:Loc Report_Archive}" />
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding OpenArchiveFolderCommand}" Style="{StaticResource ToolbarButton}">
                    <TextBlock Text="{lex:Loc Report_OpenArchive}" />
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding SaveAsCommand}" Style="{StaticResource ToolbarButton}">
                    <TextBlock Text="{lex:Loc Report_SaveAs}" />
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding OpenExternalCommand}" Style="{StaticResource ToolbarButton}">
                    <TextBlock Text="{lex:Loc Report_OpenExternal}" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#8B949E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
            </DockPanel>
        </Border>

        <pdfviewer:PdfViewerControl Grid.Row="1" ItemSource="{Binding Document}" />
    </Grid>
</Window>
