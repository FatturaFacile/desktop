<UserControl
    x:Class="FatturaFacile.Wpf.Views.JournalListView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:PrimaNotaViewModel}"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <syncfusion:SfDataGrid
            Grid.Row="0"
            ItemsSource="{Binding Entries}"
            SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
            AutoGenerateColumns="False"
            AllowFiltering="True"
            AllowSorting="True"
            AllowResizingColumns="True"
            ColumnSizer="Star">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="EntryNumber" HeaderText="{lex:Loc Accounting_Voucher}" Width="140" />
                <syncfusion:GridDateTimeColumn MappingName="PostingDate" HeaderText="{lex:Loc Accounting_PostingDate}" Width="110" Pattern="ShortDate" />
                <syncfusion:GridTextColumn MappingName="LedgerLabel" HeaderText="{lex:Loc Gl_Ledger}" Width="170" />
                <syncfusion:GridTextColumn MappingName="Description" HeaderText="{lex:Loc Accounting_Description}" Width="300" />
                <syncfusion:GridCurrencyColumn MappingName="TotalDebit" HeaderText="{lex:Loc Accounting_Debit}" Width="120" CurrencySymbol="" />
                <syncfusion:GridCurrencyColumn MappingName="TotalCredit" HeaderText="{lex:Loc Accounting_Credit}" Width="120" CurrencySymbol="" />
                <syncfusion:GridTextColumn MappingName="StatusText" HeaderText="{lex:Loc Common_Status}" Width="120" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- Storno / post draft -->
        <Border Grid.Row="1" Margin="0,8" Padding="8" Background="#1E232A" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding PostSelectedCommand}" Content="{lex:Loc Gl_PostSelected}" Margin="8,0,0,0" Padding="12,6" />
                <Button DockPanel.Dock="Right" Command="{Binding ReverseSelectedCommand}" Content="{lex:Loc Gl_Reverse}" Margin="8,0,0,0" Padding="12,6" FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0">
                    <TextBlock Text="{lex:Loc Gl_ReversalDate}" Foreground="#8B949E" Margin="0,0,0,2" />
                    <DatePicker Width="140" SelectedDate="{Binding ReversalDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{lex:Loc Gl_ReversalReason}" Foreground="#8B949E" Margin="0,0,0,2" />
                    <TextBox Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Padding="8" Background="#0D1117" CornerRadius="4" BorderBrush="#30363D" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="#8B949E" Margin="0,0,0,6" TextWrapping="Wrap" />
                <syncfusion:SfDataGrid
                    ItemsSource="{Binding SelectedEntry.Lines}"
                    AutoGenerateColumns="False"
                    AllowResizingColumns="True"
                    ColumnSizer="Star">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="AccountCode" HeaderText="{lex:Loc Accounting_Code}" Width="120" />
                        <syncfusion:GridTextColumn MappingName="AccountName" HeaderText="{lex:Loc Accounting_AccountName}" Width="250" />
                        <syncfusion:GridTextColumn MappingName="Description" HeaderText="{lex:Loc Accounting_Description}" Width="200" />
                        <syncfusion:GridCurrencyColumn MappingName="Debit" HeaderText="{lex:Loc Accounting_Debit}" Width="120" CurrencySymbol="" />
                        <syncfusion:GridCurrencyColumn MappingName="Credit" HeaderText="{lex:Loc Accounting_Credit}" Width="120" CurrencySymbol="" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
