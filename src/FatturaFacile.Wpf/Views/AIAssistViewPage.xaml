<Page x:Class="FatturaFacile.Wpf.Views.AIAssistViewPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FatturaFacile.Wpf.ViewModels"
        xmlns:aiassistview="clr-namespace:Syncfusion.UI.Xaml.Chat;assembly=Syncfusion.SfChat.Wpf"
        xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        mc:Ignorable="d"
        Title="AI Assist View" Height="450" Width="800">
	<Page.Resources>
		<Style TargetType="{x:Type aiassistview:SfAIAssistView}">
			<Setter Property="Background" Value="White"/>
		</Style>
	</Page.Resources>
	<Grid>
	<aiassistview:SfAIAssistView Height="400" Width="600"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center"
										CurrentUser="{Binding CurrentUser}"   IsResponseToolbarVisible="False"
										TypingIndicator="{Binding TypingIndicator}" ShowTypingIndicator="True"
									   Messages="{Binding Chats}">
		<aiassistview:SfAIAssistView.BannerTemplate>
			<DataTemplate>
				<StackPanel>
					<TextBlock Text="AI Assist" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource ContentForeground}"/>
					<TextBlock Text="Your best AI Companion" HorizontalAlignment="Center" FontSize="16" Foreground="{DynamicResource ContentForeground}"/>
				</StackPanel>
			</DataTemplate>
		</aiassistview:SfAIAssistView.BannerTemplate> 
	</aiassistview:SfAIAssistView>
	</Grid>
</Page>
