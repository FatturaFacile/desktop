<UserControl
    x:Class="FatturaFacile.Wpf.Views.ReceivablesOpenItemsView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    xmlns:views="clr-namespace:FatturaFacile.Wpf.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:ReceivablesOpenItemsViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D29922" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ActionResult" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActionState}" Value="Good">
                    <Setter Property="Foreground" Value="#3FB950" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionState}" Value="Warn">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionState}" Value="Bad">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultState}" Value="Good">
                    <Setter Property="Foreground" Value="#3FB950" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultState}" Value="Warn">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultState}" Value="Bad">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Overdue">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Disputed">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Closed">
                    <Setter Property="Foreground" Value="#8B949E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="{lex:Loc Receivables_FilterStatus}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="130" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" />
                    <TextBlock Text="{lex:Loc Receivables_FilterBucket}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Width="130" ItemsSource="{Binding BucketChoices}" SelectedItem="{Binding SelectedBucket}" DisplayMemberPath="Label" />
                    <TextBlock Text="{lex:Loc Receivables_FilterDocType}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <TextBox Text="{Binding DocumentType}" Width="100" />
                    <TextBlock Text="{lex:Loc Receivables_FilterDueFrom}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <DatePicker SelectedDate="{Binding DueFrom}" Width="120" />
                    <TextBlock Text="{lex:Loc Receivables_FilterDueTo}" VerticalAlignment="Center" Margin="8,0,8,0" />
                    <DatePicker SelectedDate="{Binding DueTo}" Width="120" />
                    <CheckBox IsChecked="{Binding OpenOnly}" Content="{lex:Loc Receivables_FilterOpenOnly}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <Button Command="{Binding ApplyFiltersCommand}" Content="{lex:Loc Receivables_Apply}" Padding="12,2" />
                </WrapPanel>
                <TextBlock Text="{Binding NoticeText}" Style="{StaticResource Notice}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <DataGrid
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    RowStyle="{StaticResource ItemRowStyle}"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColNumber}" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColIssue}" Binding="{Binding IssueText}" />
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColDue}" Binding="{Binding DueText}" />
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColOriginal}" Binding="{Binding OriginalText}" />
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColOpen}" Binding="{Binding OpenText}" />
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColStatus}" Binding="{Binding StatusText}" Width="*" />
                        <DataGridTextColumn Header="{lex:Loc Receivables_ColDays}" Binding="{Binding DaysText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding NextPageCommand}" Content="{lex:Loc Receivables_Next}" Padding="10,2" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Command="{Binding PreviousPageCommand}" Content="{lex:Loc Receivables_Previous}" Padding="10,2" />
                <TextBlock Text="{Binding PageText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_ActionsTitle}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Command="{Binding BeginReconcileCommand}" Content="{lex:Loc Receivables_Reconcile}" Padding="12,4" Margin="0,0,8,4" />
                            <Button Command="{Binding BeginDisputeCommand}" Content="{lex:Loc Receivables_Dispute}" Padding="12,4" Margin="0,0,8,4" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ActionText}" Style="{StaticResource ActionResult}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_Allocations}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Allocations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button
                                            DockPanel.Dock="Right"
                                            Content="{lex:Loc Receivables_Reverse}"
                                            Command="{Binding DataContext.ReverseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanReverse}"
                                            Padding="8,2" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding TypeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding AmountText, Mode=OneWay}" />
                                                <Run Text="{Binding StateText, Mode=OneWay}" Foreground="#F85149" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding DateText, Mode=OneWay}" />
                                                <Run Text="{Binding ReferenceText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding IsDisputeOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CloseDisputeCommand}" Content="{lex:Loc Receivables_Close}" Padding="8,2" />
                            <TextBlock Text="{lex:Loc Receivables_DisputeTitle}" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="{lex:Loc Receivables_DisputeReason}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding DisputeReason}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,2,0,6" />
                        <WrapPanel>
                            <Button Command="{Binding MarkDisputedCommand}" Content="{lex:Loc Receivables_DisputeMark}" Padding="12,4" Margin="0,0,8,0" />
                            <Button Command="{Binding ClearDisputeCommand}" Content="{lex:Loc Receivables_DisputeClear}" Padding="12,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsReconcileOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Reconcile}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding DataContext.CloseReconcileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="{lex:Loc Receivables_Close}" Padding="8,2" />
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="{lex:Loc Receivables_ReconcileTitle}" />
                                <Run Text="{Binding DocumentNumber, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6">
                            <Run Text="{lex:Loc Receivables_OpenAmount}" />
                            <Run Text="{Binding OpenText, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="{lex:Loc Receivables_AllocationType}" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Margin="0,2,0,6" />

                        <StackPanel Visibility="{Binding ShowPayments, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{lex:Loc Receivables_UnreconciledPayment}" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding PaymentChoices}" SelectedItem="{Binding SelectedPayment}" DisplayMemberPath="Label" Margin="0,2,0,6" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowCreditNote, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{lex:Loc Receivables_CreditNoteId}" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding CreditNoteId}" Margin="0,2,0,6" />
                        </StackPanel>

                        <TextBlock Text="{lex:Loc Receivables_Amount}" Style="{StaticResource Caption}" />
                        <DockPanel Margin="0,2,0,6">
                            <Button DockPanel.Dock="Right" Command="{Binding SetFullCommand}" Content="{lex:Loc Receivables_FullAmount}" Padding="10,2" Margin="6,0,0,0" />
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Text="{lex:Loc Receivables_ValueDate}" Style="{StaticResource Caption}" />
                        <DatePicker SelectedDate="{Binding ValueDate}" Margin="0,2,0,6" />
                        <TextBlock Text="{lex:Loc Receivables_Reference}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Reference}" Margin="0,2,0,6" />
                        <TextBlock Text="{lex:Loc Receivables_Notes}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="0,2,0,6" />

                        <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Caption}" />
                        <Button Command="{Binding SubmitCommand}" Content="{lex:Loc Receivables_Submit}" Padding="12,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource ResultText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
