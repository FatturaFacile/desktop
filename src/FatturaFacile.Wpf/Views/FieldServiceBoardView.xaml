<UserControl
    x:Class="FatturaFacile.Wpf.Views.FieldServiceBoardView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FatturaFacile.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:FieldServiceBoardViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="PriorityText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="high">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="urgent">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="critical">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarBorder" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="en_route">
                    <Setter Property="Background" Value="#9E6A03" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="on_site">
                    <Setter Property="Background" Value="#238636" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="completed">
                    <Setter Property="Background" Value="#6E7681" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding PreviousWeekCommand}" Content="{lex:Loc FieldService_PreviousWeek}" Padding="12,5" Margin="0,0,6,0" />
                    <Button Command="{Binding NextWeekCommand}" Content="{lex:Loc FieldService_NextWeek}" Padding="12,5" Margin="0,0,6,0" />
                    <Button Command="{Binding SyncCommand}" Content="{lex:Loc FieldService_Sync}" Padding="12,5" Margin="0,0,6,0" />
                    <Button Command="{Binding RunPreventiveCommand}" Content="{lex:Loc FieldService_RunPreventive}" Padding="12,5" />
                </StackPanel>
                <TextBlock Text="{Binding WindowText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastSyncedText}" Foreground="#8B949E" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#D29922" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Grid Visibility="{Binding HasBoard, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc FieldService_Unassigned}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Unassigned}" SelectedItem="{Binding SelectedUnassigned}" MaxHeight="360" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PriorityText}" Style="{StaticResource PriorityText}" />
                                            <TextBlock>
                                                <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding TypeText}" Foreground="#8B949E" FontSize="11" />
                                        <TextBlock Text="{Binding SkillsText}" Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SiteText}" Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{lex:Loc FieldService_DispatchWindow}" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <DatePicker SelectedDate="{Binding DispatchDate}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{lex:Loc FieldService_StartTime}" VerticalAlignment="Center" Width="110" />
                            <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{lex:Loc FieldService_DurationHours}" VerticalAlignment="Center" Width="110" />
                            <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Button Command="{Binding DispatchCommand}" Content="{lex:Loc FieldService_Dispatch}" Padding="14,6" />
                        <ItemsControl ItemsSource="{Binding DispatchWarnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#F85149" TextWrapping="Wrap" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc FieldService_Timeline}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{lex:Loc FieldService_TimelineHint}" Foreground="#8B949E" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding Lanes}" SelectedItem="{Binding SelectedLane}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" Width="230" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SkillsText}" Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding VanText}" Foreground="#8B949E" FontSize="11" />
                                            </StackPanel>
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" HorizontalAlignment="Left"
                                                    Width="{Binding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <ItemsControl ItemsSource="{Binding Bars}" Height="30">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                            <Setter Property="Canvas.Top" Value="3" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource BarBorder}" Width="{Binding Width}" ToolTip="{Binding Tooltip}">
                                                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock
                                            Text="{Binding WarningText}"
                                            Foreground="#D29922"
                                            FontSize="11"
                                            TextWrapping="Wrap"
                                            Margin="238,2,0,0"
                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Visibility="{Binding HasBoard, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Map}">
                    <TextBlock Text="{lex:Loc FieldService_Map_Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{lex:Loc FieldService_Map_Hint}" Foreground="#8B949E" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MissingText}" Foreground="#D29922" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{lex:Loc FieldService_Map_Empty}" Foreground="#8B949E" Visibility="{Binding HasPins, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" HorizontalAlignment="Left"
                            Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                            Visibility="{Binding HasPins, Converter={StaticResource BoolToVisibility}}">
                        <Grid ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding Routes}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding PathData}" Stroke="{Binding Color}" StrokeThickness="2" StrokeDashArray="4 2" StrokeLineJoin="Round" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Pins}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.SelectPinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Tooltip}"
                                            Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{Binding Color}" Stroke="#0D1117" StrokeThickness="2" />
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Dot" Property="Stroke" Value="White" />
                                                            <Setter TargetName="Dot" Property="StrokeThickness" Value="3" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Routes}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SummaryText}" Foreground="#8B949E" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Ellipse Width="10" Height="10" Fill="{Binding UnassignedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{lex:Loc FieldService_Map_Unassigned}" Foreground="#8B949E" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{lex:Loc FieldService_Map_Disclaimer}" Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
