<UserControl
    x:Class="FatturaFacile.Wpf.Views.CustomerLifecycleView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:CustomerLifecycleViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="{lex:Loc CustomerLifecycle_Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="{lex:Loc CustomerLifecycle_Customer}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox
                    Width="320"
                    ItemsSource="{Binding Customers}"
                    SelectedItem="{Binding SelectedCustomer}"
                    DisplayMemberPath="Label" />
                <Button
                    Command="{Binding ShowCommand}"
                    Content="{lex:Loc CustomerLifecycle_Show}"
                    Padding="14,6"
                    Margin="8,0,0,0" />
            </WrapPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#D29922" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_Health}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding HealthText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Foreground="#8B949E" FontSize="12">
                                <Run Text="{lex:Loc CustomerLifecycle_Churn}" />
                                <Run Text="{Binding ChurnText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_Ltv}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding LifetimeValueText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_Pipeline}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding PipelineText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_Overdue}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding OverdueText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_OpenTickets}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding OpenTicketsText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Foreground="#8B949E" FontSize="12">
                                <Run Text="{lex:Loc CustomerLifecycle_SlaBreach}" />
                                <Run Text="{Binding SlaBreachText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_Mttr}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding MttrText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_Contracts}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding ContractsText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Foreground="#8B949E" FontSize="12">
                                <Run Text="{lex:Loc CustomerLifecycle_Coverage}" />
                                <Run Text="{Binding CoverageText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_HoursRemaining}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding HoursRemainingText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc CustomerLifecycle_InterventionsOpen}" Foreground="#8B949E" FontSize="12" />
                            <TextBlock Text="{Binding InterventionsOpenText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Foreground="#8B949E" FontSize="12">
                                <Run Text="{lex:Loc CustomerLifecycle_InterventionsDone}" />
                                <Run Text="{Binding InterventionsDoneText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc CustomerLifecycle_Timeline}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            HeadersVisibility="Column"
                            CanUserAddRows="False"
                            ItemsSource="{Binding Timeline}"
                            MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{lex:Loc CustomerLifecycle_ColWhen}" Binding="{Binding WhenText}" />
                                <DataGridTextColumn Header="{lex:Loc CustomerLifecycle_ColType}" Binding="{Binding TypeText}" />
                                <DataGridTextColumn Header="{lex:Loc CustomerLifecycle_ColTitle}" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="{lex:Loc CustomerLifecycle_ColStatus}" Binding="{Binding StatusText}" />
                                <DataGridTextColumn Header="{lex:Loc CustomerLifecycle_ColAmount}" Binding="{Binding AmountText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
