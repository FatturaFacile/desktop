<UserControl
    x:Class="FatturaFacile.Wpf.Views.PayrollView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:PayrollViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PayrollBoolToVisibility" />
    </UserControl.Resources>

    <Grid>
    <ContentControl Content="{Binding Swiss}" Visibility="{Binding IsSwiss, Converter={StaticResource PayrollBoolToVisibility}}" />
    <Grid Margin="16" Visibility="{Binding IsStandard, Converter={StaticResource PayrollBoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Action Toolbar -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12" Background="#1E232A" CornerRadius="6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Command="{Binding LoadEmployeesCommand}" Margin="0,0,8,0" Padding="12,6" FontWeight="SemiBold" Background="#2D333B" Foreground="#E6EDF3" BorderBrush="#444C56">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " />
                            <TextBlock Text="{lex:Loc Common_Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CalculatePayrollCommand}" Margin="0,0,8,0" Padding="12,6" FontWeight="SemiBold" Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#58A6FF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧮 " />
                            <TextBlock Text="{lex:Loc Payroll_PreviewButton}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#8B949E" VerticalAlignment="Center" FontWeight="Medium" />
            </DockPanel>
        </Border>

        <!-- Employees List -->
        <Border Grid.Row="1" Background="#161B22" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1">
            <syncfusion:SfDataGrid
                ItemsSource="{Binding Employees}"
                SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                AutoGenerateColumns="False"
                AllowFiltering="True"
                AllowSorting="True"
                AllowResizingColumns="True"
                ColumnSizer="Star">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="EmployeeNumber" HeaderText="{lex:Loc Payroll_EmployeeNumber}" Width="100" />
                    <syncfusion:GridTextColumn MappingName="FirstName" HeaderText="{lex:Loc Payroll_FullName}" Width="120" />
                    <syncfusion:GridTextColumn MappingName="LastName" HeaderText="{lex:Loc Payroll_FullName}" Width="140" />
                    <syncfusion:GridTextColumn MappingName="JobTitle" HeaderText="{lex:Loc Payroll_Role}" Width="180" />
                    <syncfusion:GridTextColumn MappingName="DepartmentName" HeaderText="{lex:Loc Payroll_Department}" Width="130" />
                    <syncfusion:GridTextColumn MappingName="SocialSecurityNumber" HeaderText="{lex:Loc Payroll_SocialSecurity}" Width="150" />
                    <syncfusion:GridCurrencyColumn MappingName="BaseAnnualSalary" HeaderText="{lex:Loc Payroll_GrossSalary}" Width="140" CurrencySymbol="" />
                    <syncfusion:GridTextColumn MappingName="EmploymentStatus" HeaderText="{lex:Loc Common_Status}" Width="90" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Border>

        <!-- Interactive Localized Payroll Deduction Preview Card (CH vs IT) -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="16" Background="#161B22" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Employee Summary Header -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{lex:Loc Payroll_Title}" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedEmployee.FirstName}" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedEmployee.LastName}" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedEmployee.JobTitle, StringFormat='Qualifica: {0}'}" Foreground="#8B949E" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CurrentCalculationResult.CountryCode, StringFormat='Giurisdizione Fiscale: {0}'}" Foreground="#3FB950" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CurrentCalculationResult.GrossMonthlySalary, StringFormat='Retribuzione Lorda: {0:N2}'}" Foreground="#E6EDF3" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CurrentCalculationResult.ComplianceNotes}" TextWrapping="Wrap" Foreground="#8B949E" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Detailed Deductions Breakdown -->
                <Border Grid.Column="1" Padding="12" Background="#0D1117" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1">
                    <DockPanel>
                        <!-- Net Result Bar at Bottom -->
                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" Background="#1C2128" CornerRadius="4">
                            <DockPanel>
                                <TextBlock Text="{Binding CurrentCalculationResult.TotalDeductions, StringFormat='Totale Trattenute: {0:N2}'}" Foreground="#F85149" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentCalculationResult.NetMonthlySalary, StringFormat='NETTO: {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#3FB950" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>

                        <!-- Deductions List (Key-Value breakdown) -->
                        <ItemsControl ItemsSource="{Binding CurrentCalculationResult.DeductionBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="6,4" Background="#161B22" CornerRadius="3">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Foreground="#E6EDF3" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, StringFormat='-{0:N2}'}" Foreground="#F85149" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Grid>
</UserControl>
