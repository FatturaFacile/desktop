<UserControl
    x:Class="FatturaFacile.Wpf.Views.SwissPayrollView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:payroll="clr-namespace:FatturaFacile.Wpf.ViewModels.Payroll"
    xmlns:tt="clr-namespace:FatturaFacile.Application.TimeTracking;assembly=FatturaFacile.Application"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:SwissPayrollViewModel}"
    mc:Ignorable="d">
<TabControl Margin="12">
<TabItem Header="{lex:Loc Payroll_Tab_Employees}">
<Grid DataContext="{Binding Employees}">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="320" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<DockPanel Grid.Column="0" Margin="0,0,12,0">
<Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10" Background="#1E232A" CornerRadius="6">
<DockPanel LastChildFill="False">
<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
<Button Command="{Binding LoadCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Refresh}" />
</Button>
</StackPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#8B949E" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
</DockPanel>
</Border>
<syncfusion:SfDataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" >
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="EmployeeNumber" HeaderText="{lex:Loc Payroll_EmployeeNumber}" />
<syncfusion:GridTextColumn MappingName="FullName" HeaderText="{lex:Loc Payroll_Name}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
</DockPanel>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
<StackPanel>
<Border Style="{StaticResource CardBorder}">
<StackPanel>
<TextBlock Text="{lex:Loc Payroll_Employee}" Style="{StaticResource SectionHeader}" />
<WrapPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_EmployeeNumber}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.EmployeeNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="170">
<TextBlock Text="{lex:Loc Payroll_FirstName}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="170">
<TextBlock Text="{lex:Loc Payroll_LastName}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="80">
<TextBlock Text="{lex:Loc Payroll_Gender}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Genders}" SelectedItem="{Binding Editing.Gender}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_DateOfBirth}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding Editing.DateOfBirth}" Margin="0,0,12,10" />
</StackPanel>
<StackPanel Width="160">
<TextBlock Text="{lex:Loc Payroll_AhvNumber}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.SocialSecurityNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="90">
<TextBlock Text="{lex:Loc Payroll_Nationality}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Nationality, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="90">
<TextBlock Text="{lex:Loc Payroll_Permit}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Permits}" SelectedItem="{Binding Editing.ResidencePermit}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_CivilStatus}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.CivilStatuses}" SelectedItem="{Binding Editing.CivilStatus}" Style="{StaticResource FieldCombo}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<StackPanel Width="200">
<TextBlock Text="{lex:Loc Common_Street}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Street, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="60">
<TextBlock Text="{lex:Loc Common_HouseNumber}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.HouseNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="80">
<TextBlock Text="{lex:Loc Common_PostalCode}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.PostalCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="160">
<TextBlock Text="{lex:Loc Common_City}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="90">
<TextBlock Text="{lex:Loc Payroll_ResidenceCountry}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.ResidenceCountry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_ResidenceCanton}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Cantons}" SelectedItem="{Binding Editing.ResidenceCanton}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="220">
<TextBlock Text="{lex:Loc Payroll_Iban}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.Iban, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_HireDate}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding Editing.HireDate}" Margin="0,0,12,10" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_TerminationDate}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding Editing.TerminationDate}" Margin="0,0,12,10" />
</StackPanel>
<CheckBox IsChecked="{Binding Editing.IsFixedTermContract}" Content="{lex:Loc Payroll_FixedTerm}" Foreground="#E6EDF3" Margin="0,18,12,10" Width="150" />
<StackPanel Width="160">
<TextBlock Text="{lex:Loc Payroll_JobTitle}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.JobTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_WorkCanton}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Cantons}" SelectedItem="{Binding Editing.WorkCanton}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_PayType}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.PayTypes}" SelectedItem="{Binding Editing.PayType}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="120">
<TextBlock Text="{lex:Loc Payroll_AnnualSalary}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.BaseAnnualSalary, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="80">
<TextBlock Text="{lex:Loc Payroll_Installments}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.SalaryInstallmentsPerYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="100">
<TextBlock Text="{lex:Loc Payroll_HourlyWage}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.HourlyWage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="100">
<TextBlock Text="{lex:Loc Payroll_WeeklyHours}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.WeeklyHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_HolidayWeeks}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.HolidayWeeks, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<CheckBox IsChecked="{Binding Editing.IsWithholdingTaxSubject}" Content="{lex:Loc Payroll_QstSubject}" Foreground="#E6EDF3" Margin="0,18,12,10" Width="140" />
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_QstCode}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.WithholdingTaxCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="120">
<TextBlock Text="{lex:Loc Payroll_QstManualRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.WithholdingTaxRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<CheckBox IsChecked="{Binding Editing.ChurchTax}" Content="{lex:Loc Payroll_ChurchTax}" Foreground="#E6EDF3" Margin="0,18,12,10" Width="130" />
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_NbuRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.NonOccupationalAccidentRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_BuRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.OccupationalAccidentRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="80">
<TextBlock Text="{lex:Loc Payroll_KtgRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.DailySicknessRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_FakRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.FamilyAllowanceFundRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="170">
<TextBlock Text="{lex:Loc Payroll_BvgPlanRate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.PensionFundEmployeeRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<WrapPanel>
<StackPanel Width="170">
<TextBlock Text="{lex:Loc Payroll_TimeMode}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static tt:TimeRecordingMode.All}" SelectedItem="{Binding Editing.TimeRecordingMode}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="190">
<TextBlock Text="{lex:Loc Payroll_LegalMaxWeekly}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.LegalMaxWeeklyHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_WorkDays}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding Editing.WorkDaysPerWeek, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="160">
<TextBlock Text="{lex:Loc Payroll_TimeAgreement}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding Editing.TimeRecordingAgreementDate}" Margin="0,0,12,10" />
</StackPanel>
</WrapPanel>
<StackPanel Orientation="Horizontal">
<Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
<TextBlock Text="{lex:Loc Common_Save}" />
</Button>
<Button Command="{Binding NewCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_New}" />
</Button>
<Button Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Delete}" />
</Button>
</StackPanel>
</StackPanel>
</Border>
<Border Style="{StaticResource CardBorder}">
<StackPanel>
<TextBlock Text="{lex:Loc Payroll_Children}" Style="{StaticResource SectionHeader}" />
<syncfusion:SfDataGrid ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" MaxHeight="160">
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="FirstName" HeaderText="{lex:Loc Payroll_FirstName}" />
<syncfusion:GridTextColumn MappingName="LastName" HeaderText="{lex:Loc Payroll_LastName}" />
<syncfusion:GridDateTimeColumn MappingName="DateOfBirth" HeaderText="{lex:Loc Payroll_DateOfBirth}" Pattern="ShortDate" />
<syncfusion:GridCheckBoxColumn MappingName="InEducation" HeaderText="{lex:Loc Payroll_InEducation}" />
<syncfusion:GridCheckBoxColumn MappingName="AllowanceEligible" HeaderText="{lex:Loc Payroll_AllowanceEligible}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
<WrapPanel>
<StackPanel Width="130">
<TextBlock Text="{lex:Loc Payroll_FirstName}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewChild.FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="130">
<TextBlock Text="{lex:Loc Payroll_LastName}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewChild.LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_DateOfBirth}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding NewChild.DateOfBirth}" Margin="0,0,12,10" />
</StackPanel>
<CheckBox IsChecked="{Binding NewChild.InEducation}" Content="{lex:Loc Payroll_InEducation}" Foreground="#E6EDF3" Margin="0,18,12,10" Width="110" />
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_EducationEnd}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding NewChild.EducationEndDate}" Margin="0,0,12,10" />
</StackPanel>
</WrapPanel>
<StackPanel Orientation="Horizontal">
<Button Command="{Binding AddChildCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Add}" />
</Button>
<Button Command="{Binding RemoveChildCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Remove}" />
</Button>
</StackPanel>
</StackPanel>
</Border>
<Border Style="{StaticResource CardBorder}">
<StackPanel>
<TextBlock Text="{lex:Loc Payroll_Absences}" Style="{StaticResource SectionHeader}" />
<syncfusion:SfDataGrid ItemsSource="{Binding Absences}" SelectedItem="{Binding SelectedAbsence, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" MaxHeight="160">
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="AbsenceType" HeaderText="{lex:Loc Payroll_AbsenceType}" />
<syncfusion:GridDateTimeColumn MappingName="StartDate" HeaderText="{lex:Loc Payroll_From}" Pattern="ShortDate" />
<syncfusion:GridDateTimeColumn MappingName="EndDate" HeaderText="{lex:Loc Payroll_To}" Pattern="ShortDate" />
<syncfusion:GridNumericColumn MappingName="Percent" HeaderText="{lex:Loc Payroll_Percent}" NumberDecimalDigits="2" />
<syncfusion:GridTextColumn MappingName="Note" HeaderText="{lex:Loc Common_Note}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
<WrapPanel>
<StackPanel Width="130">
<TextBlock Text="{lex:Loc Payroll_AbsenceType}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.AbsenceTypes}" SelectedItem="{Binding NewAbsence.AbsenceType}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_From}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding NewAbsence.StartDate}" Margin="0,0,12,10" />
</StackPanel>
<StackPanel Width="150">
<TextBlock Text="{lex:Loc Payroll_To}" Style="{StaticResource FieldLabel}" />
<DatePicker SelectedDate="{Binding NewAbsence.EndDate}" Margin="0,0,12,10" />
</StackPanel>
<StackPanel Width="60">
<TextBlock Text="{lex:Loc Payroll_Percent}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewAbsence.Percent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="200">
<TextBlock Text="{lex:Loc Common_Note}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewAbsence.Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<StackPanel Orientation="Horizontal">
<Button Command="{Binding AddAbsenceCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Add}" />
</Button>
<Button Command="{Binding RemoveAbsenceCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Remove}" />
</Button>
</StackPanel>
</StackPanel>
</Border>
</StackPanel>
</ScrollViewer>
</Grid>
</TabItem>
<TabItem Header="{lex:Loc Payroll_Tab_Inputs}">
<DockPanel DataContext="{Binding Inputs}">
<Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10" Background="#1E232A" CornerRadius="6">
<DockPanel LastChildFill="False">
<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
<TextBlock Text="{lex:Loc Payroll_Year}" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0,4,0" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Years}" SelectedItem="{Binding Year}" Width="80" Margin="0,0,8,0" />
<TextBlock Text="{lex:Loc Payroll_Month}" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Months}" SelectedItem="{Binding Month}" Width="60" Margin="0,0,8,0" />
<Button Command="{Binding LoadCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Refresh}" />
</Button>
<Button Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Common_Delete}" />
</Button>
</StackPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#8B949E" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
</DockPanel>
</Border>
<Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
<StackPanel>
<TextBlock Text="{lex:Loc Payroll_NewInput}" Style="{StaticResource SectionHeader}" />
<WrapPanel>
<StackPanel Width="220">
<TextBlock Text="{lex:Loc Payroll_Employee}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectedValue="{Binding NewInput.EmployeeId}" Style="{StaticResource FieldCombo}" />
</StackPanel>
<StackPanel Width="300">
<TextBlock Text="{lex:Loc Payroll_WageType}" Style="{StaticResource FieldLabel}" />
<ComboBox ItemsSource="{Binding WageTypes}" SelectedValuePath="Code" SelectedValue="{Binding NewInput.WageTypeCode}" Style="{StaticResource FieldCombo}">
<ComboBox.ItemTemplate>
<DataTemplate>
<TextBlock>
<Run Text="{Binding Code, Mode=OneWay}" />
<Run Text=" - " />
<Run Text="{Binding Name, Mode=OneWay}" />
</TextBlock>
</DataTemplate>
</ComboBox.ItemTemplate>
</ComboBox>
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_Quantity}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewInput.Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="100">
<TextBlock Text="{lex:Loc Payroll_Rate}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewInput.Rate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="110">
<TextBlock Text="{lex:Loc Payroll_Amount}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewInput.Amount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
<StackPanel Width="220">
<TextBlock Text="{lex:Loc Common_Note}" Style="{StaticResource FieldLabel}" />
<TextBox Text="{Binding NewInput.Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
</StackPanel>
</WrapPanel>
<Button Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}">
<TextBlock Text="{lex:Loc Common_Add}" />
</Button>
</StackPanel>
</Border>
<syncfusion:SfDataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" >
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="{lex:Loc Payroll_Employee}" />
<syncfusion:GridTextColumn MappingName="Code" HeaderText="{lex:Loc Payroll_Code}" />
<syncfusion:GridTextColumn MappingName="WageTypeName" HeaderText="{lex:Loc Payroll_WageType}" />
<syncfusion:GridNumericColumn MappingName="Quantity" HeaderText="{lex:Loc Payroll_Quantity}" NumberDecimalDigits="2" />
<syncfusion:GridNumericColumn MappingName="Rate" HeaderText="{lex:Loc Payroll_Rate}" NumberDecimalDigits="2" />
<syncfusion:GridCurrencyColumn MappingName="Amount" HeaderText="{lex:Loc Payroll_Amount}" CurrencySymbol="" />
<syncfusion:GridTextColumn MappingName="Note" HeaderText="{lex:Loc Common_Note}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
</DockPanel>
</TabItem>
<TabItem Header="{lex:Loc Payroll_Tab_Runs}">
<DockPanel DataContext="{Binding Runs}">
<Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10" Background="#1E232A" CornerRadius="6">
<DockPanel LastChildFill="False">
<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
<TextBlock Text="{lex:Loc Payroll_Year}" Foreground="#8B949E" VerticalAlignment="Center" Margin="8,0,4,0" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Years}" SelectedItem="{Binding Year}" Width="80" Margin="0,0,8,0" />
<TextBlock Text="{lex:Loc Payroll_Month}" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
<ComboBox ItemsSource="{x:Static payroll:PayrollLookups.Months}" SelectedItem="{Binding Month}" Width="60" Margin="0,0,8,0" />
<TextBlock Text="{lex:Loc Payroll_PaymentDate}" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
<DatePicker SelectedDate="{Binding PaymentDate}" Width="120" Margin="0,0,8,0" />
<Button Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryButton}">
<TextBlock Text="{lex:Loc Payroll_Calculate}" />
</Button>
<Button Command="{Binding FinalizeCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Payroll_Finalize}" />
</Button>
<Button Command="{Binding ReopenCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Payroll_Reopen}" />
</Button>
<Button Command="{Binding PrintPayslipCommand}" Style="{StaticResource ToolbarButton}">
<TextBlock Text="{lex:Loc Payroll_PrintPayslip}" />
</Button>
</StackPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="#8B949E" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
</DockPanel>
</Border>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="220" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="*" />
<RowDefinition Height="*" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
<Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,10,0">
<syncfusion:SfDataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" >
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="Year" HeaderText="{lex:Loc Payroll_Year}" />
<syncfusion:GridTextColumn MappingName="Month" HeaderText="{lex:Loc Payroll_Month}" />
<syncfusion:GridTextColumn MappingName="Status" HeaderText="{lex:Loc Common_Status}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
</Border>
<Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
<syncfusion:SfDataGrid ItemsSource="{Binding Payslips}" SelectedItem="{Binding SelectedPayslip, Mode=TwoWay}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" >
<syncfusion:SfDataGrid.Columns>
<syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="{lex:Loc Payroll_Employee}" />
<syncfusion:GridNumericColumn MappingName="PaidDays" HeaderText="{lex:Loc Payroll_PaidDays}" NumberDecimalDigits="2" />
<syncfusion:GridCurrencyColumn MappingName="GrossSalary" HeaderText="{lex:Loc Payroll_Gross}" CurrencySymbol="" />
<syncfusion:GridCurrencyColumn MappingName="EmployeeDeductions" HeaderText="{lex:Loc Payroll_Deductions}" CurrencySymbol="" />
<syncfusion:GridCurrencyColumn MappingName="NetSalary" HeaderText="{lex:Loc Payroll_Net}" CurrencySymbol="" />
<syncfusion:GridCurrencyColumn MappingName="PayoutAmount" HeaderText="{lex:Loc Payroll_Payout}" CurrencySymbol="" />
<syncfusion:GridCurrencyColumn MappingName="EmployerContributions" HeaderText="{lex:Loc Payroll_Employer}" CurrencySymbol="" />
<syncfusion:GridTextColumn MappingName="WithholdingTaxCode" HeaderText="{lex:Loc Payroll_QstCode}" />
<syncfusion:GridTextColumn MappingName="Warnings" HeaderText="{lex:Loc Payroll_Warnings}" />
</syncfusion:SfDataGrid.Columns>
</syncfusion:SfDataGrid>
</Border>
<Border Grid.Row="1" Grid.Column="1">
<syncfusion:SfDataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" AllowSorting="True" AllowFiltering="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" >
<syncfusion:SfDataGrid.Columns>
