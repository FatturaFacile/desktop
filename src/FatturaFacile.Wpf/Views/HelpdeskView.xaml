<UserControl
    x:Class="FatturaFacile.Wpf.Views.HelpdeskView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:HelpdeskViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TicketRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Breached">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="AtRisk">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RiskText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding RiskText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D29922" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Breached">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultState}" Value="Good">
                    <Setter Property="Foreground" Value="#3FB950" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultState}" Value="Warn">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultState}" Value="Bad">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <DataTemplate x:Key="QueueRowTemplate">
            <DockPanel Margin="0,2">
                <Button
                    DockPanel.Dock="Right"
                    Content="{lex:Loc Helpdesk_Dismiss}"
                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Padding="8,2"
                    Visibility="{Binding DataContext.HasConflicts, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding TicketNumber, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding ActionText, Mode=OneWay}" />
                    <Run Text="{Binding WhenText, Mode=OneWay}" Foreground="#8B949E" />
                    <Run Text="{Binding Error, Mode=OneWay}" Foreground="#F85149" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextRowTemplate">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding FlushCommand}" Content="{lex:Loc Helpdesk_FlushNow}" Padding="14,6" Margin="0,0,8,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
                        <Button Command="{Binding LoadCommand}" Content="{lex:Loc Helpdesk_Refresh}" Padding="14,6" />
                    </StackPanel>
                    <TextBlock Text="{lex:Loc Helpdesk_Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="{lex:Loc Helpdesk_Search}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                    <TextBlock Text="{lex:Loc Helpdesk_FilterPriority}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Width="120" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="Label" />
                    <TextBlock Text="{lex:Loc Helpdesk_FilterState}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Width="120" ItemsSource="{Binding StateChoices}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="Label" />
                    <TextBlock Text="{lex:Loc Helpdesk_FilterRisk}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <TextBox Text="{Binding MinRiskPercent, UpdateSourceTrigger=LostFocus}" Width="50" />
                </WrapPanel>

                <TextBlock Text="{Binding LastSyncedText}" Foreground="#8B949E" Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#D29922" Margin="0,0,0,8" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <DataGrid
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    RowStyle="{StaticResource TicketRowStyle}"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedTicket}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{lex:Loc Helpdesk_ColRisk}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource RiskText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc Helpdesk_ColNumber}" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="{lex:Loc Helpdesk_ColSubject}" Binding="{Binding Subject}" Width="*" />
                        <DataGridTextColumn Header="{lex:Loc Helpdesk_ColPriority}" Binding="{Binding Priority}" />
                        <DataGridTextColumn Header="{lex:Loc Helpdesk_ColStatus}" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="{lex:Loc Helpdesk_ColDue}" Binding="{Binding DueText}" />
                        <DataGridTextColumn Header="{lex:Loc Helpdesk_ColTargets}" Binding="{Binding TargetsText}" />
                        <DataGridCheckBoxColumn Header="{lex:Loc Helpdesk_ColQueued}" Binding="{Binding HasPending, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_QueueTitle}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueRowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_ConflictsTitle}" Style="{StaticResource SectionTitle}" Foreground="#F85149" />
                        <ItemsControl ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource QueueRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasContext, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_C360Title}" Style="{StaticResource SectionTitle}" FontSize="16" />
                        <TextBlock Text="{Binding ContextNote}" Foreground="#D29922" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <TextBlock Text="{lex:Loc Helpdesk_Contracts}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Contracts}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BankText}" Foreground="#8B949E" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{lex:Loc Helpdesk_Assets}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Assets}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding SerialNumber}" />
                                        <TextBlock Text="{Binding WarrantyText}" Foreground="#8B949E" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{lex:Loc Helpdesk_Invoices}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding InvoicesText}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="{lex:Loc Helpdesk_Recent}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding RecentTickets}" ItemTemplate="{StaticResource TextRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasEscalations, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_Escalations}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Escalations}" ItemTemplate="{StaticResource TextRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_KbTitle}" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Command="{Binding SearchKnowledgeCommand}" Content="{lex:Loc Helpdesk_KbSearch}" Padding="10,2" Margin="6,0,0,0" />
                            <TextBox Text="{Binding KnowledgeQuery, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{Binding KnowledgeStatus}" Foreground="#D29922" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding KnowledgeResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_ActionsTitle}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Command="{Binding BeginTimeLogCommand}" Content="{lex:Loc Helpdesk_TimeStart}" Padding="12,4" Margin="0,0,8,4" />
                            <Button Command="{Binding BeginEscalationCommand}" Content="{lex:Loc Helpdesk_EscalateStart}" Padding="12,4" Margin="0,0,8,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding IsTimeLogOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding TimeLog}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding DataContext.CloseTimeLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="{lex:Loc Helpdesk_Close}" Padding="8,2" />
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="{lex:Loc Helpdesk_TimeTitle}" />
                                <Run Text="{Binding TicketNumber, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{lex:Loc Helpdesk_TimeMinutes}" Foreground="#8B949E" FontSize="12" />
                        <TextBox Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <TextBlock Text="{lex:Loc Helpdesk_TimeDescription}" Foreground="#8B949E" FontSize="12" />
                        <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,2,0,6" />
                        <CheckBox IsChecked="{Binding IsBillable}" Content="{lex:Loc Helpdesk_TimeBillable}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PreviewText}" Foreground="#8B949E" TextWrapping="Wrap" />
                        <Button Command="{Binding SubmitCommand}" Content="{lex:Loc Helpdesk_TimeSubmit}" Padding="12,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource ResultText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsEscalationOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Escalation}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding DataContext.CloseEscalationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="{lex:Loc Helpdesk_Close}" Padding="8,2" />
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="{lex:Loc Helpdesk_EscalateTitle}" />
                                <Run Text="{Binding TicketNumber, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>

                        <TextBlock Text="{lex:Loc Helpdesk_FsTitle}" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <TextBlock Text="{lex:Loc Helpdesk_FsWorkType}" Foreground="#8B949E" FontSize="12" />
                        <TextBox Text="{Binding WorkType}" Margin="0,2,0,6" />
                        <TextBlock Text="{lex:Loc Helpdesk_FsStart}" Foreground="#8B949E" FontSize="12" />
                        <DatePicker SelectedDate="{Binding ScheduledStart}" Margin="0,2,0,6" />
                        <TextBlock Text="{lex:Loc Helpdesk_FsEnd}" Foreground="#8B949E" FontSize="12" />
                        <DatePicker SelectedDate="{Binding ScheduledEnd}" Margin="0,2,0,6" />
                        <TextBlock Text="{lex:Loc Helpdesk_FsLocation}" Foreground="#8B949E" FontSize="12" />
                        <TextBox Text="{Binding Location}" Margin="0,2,0,6" />
                        <Button Command="{Binding EscalateToFieldServiceCommand}" Content="{lex:Loc Helpdesk_FsSubmit}" Padding="12,4" HorizontalAlignment="Left" />

                        <TextBlock Text="{lex:Loc Helpdesk_RmaTitle}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock Text="{lex:Loc Helpdesk_RmaSerial}" Foreground="#8B949E" FontSize="12" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding Serials}" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <CheckBox IsChecked="{Binding Goodwill}" Content="{lex:Loc Helpdesk_RmaGoodwill}" Margin="0,0,0,6" />
                        <TextBlock Text="{lex:Loc Helpdesk_RmaSymptom}" Foreground="#8B949E" FontSize="12" />
                        <TextBox Text="{Binding Symptom}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,2,0,6" />
                        <Button Command="{Binding EscalateToRmaCommand}" Content="{lex:Loc Helpdesk_RmaSubmit}" Padding="12,4" HorizontalAlignment="Left" />

                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource ResultText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
