<syncfusion:ChromelessWindow
    x:Class="FatturaFacile.Wpf.Views.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FatturaFacile.Wpf.Behaviors"
    xmlns:converters="clr-namespace:FatturaFacile.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sfSkinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    xmlns:views="clr-namespace:FatturaFacile.Wpf.Views"
    Title="{lex:Loc App_Title}"
    sfSkinManager:SfSkinManager.VisualStyle="FluentDark"
    mc:Ignorable="d"
    Width="1360"
    Height="840"
    MinWidth="1024"
    MinHeight="700"
    WindowStartupLocation="CenterScreen">

    <syncfusion:ChromelessWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type viewModels:InvoicingViewModel}">
            <views:InvoicingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AccountingViewModel}">
            <views:AccountingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ContactsViewModel}">
            <views:ContactsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PayrollViewModel}">
            <views:PayrollView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TimeTrackingViewModel}">
            <views:TimeTrackingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SwissPayrollViewModel}">
            <views:SwissPayrollView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CompanySettingsViewModel}">
            <views:CompanySettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Top Header Bar -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <!-- Branding -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{lex:Loc App_BrandName}" FontSize="16" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0" Padding="6,2" Background="#1F6FEB" CornerRadius="4" VerticalAlignment="Center">
                        <TextBlock Text="{lex:Loc App_Tagline}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <!-- Multi-Tenant Switcher, Language Selector, and Security Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Signed-in User Badge -->
                    <Border Margin="0,0,12,0" Padding="8,4" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lex:Loc Shell_SignedInAs}" FontSize="11" Foreground="#8B949E" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentUserDisplayName}" FontSize="11" Foreground="#3FB950" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Language Selector ComboBox -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{lex:Loc Shell_Language}" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ComboBox
                            ItemsSource="{Binding SupportedCultures}"
                            SelectedItem="{Binding SelectedCulture, Mode=TwoWay}"
                            DisplayMemberPath="NativeName"
                            Width="120"
                            Padding="6,4"
                            Background="#21262D"
                            Foreground="#E6EDF3"
                            BorderBrush="#444C56" />
                    </StackPanel>

                    <!-- Active Tenant Indicator / Switcher -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{lex:Loc Shell_TenantSelector}" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ComboBox
                            ItemsSource="{Binding Tenants}"
                            SelectedItem="{Binding SelectedTenant, Mode=TwoWay}"
                            Width="260"
                            Padding="6,4"
                            Background="#21262D"
                            Foreground="#E6EDF3"
                            BorderBrush="#444C56">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1F6FEB" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Country}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E6EDF3" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DefaultCurrency, StringFormat=' ({0})'}" Foreground="#8B949E" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Lock Button -->
                    <Button
                        Command="{Binding LockApplicationCommand}"
                        Margin="10,0,0,0"
                        Padding="10,6"
                        Background="#21262D"
                        Foreground="#E6EDF3"
                        BorderBrush="#444C56"
                        Cursor="Hand"
                        ToolTip="{lex:Loc Shell_Lock}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lex:Loc Shell_Lock}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Logout Button -->
                    <Button
                        Command="{Binding LogoutCommand}"
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Background="#21262D"
                        Foreground="#F85149"
                        BorderBrush="#444C56"
                        Cursor="Hand"
                        ToolTip="{lex:Loc Shell_Logout}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lex:Loc Shell_Logout}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace: Sidebar Navigation + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation Menu -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="12,16,12,0">
                        <TextBlock Text="{lex:Loc Nav_SectionTitle}" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="8,0,0,12" />

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Invoicing" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Invoicing}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Accounting" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Accounting}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Contacts" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Contacts}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Products" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Products}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Payroll" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💼" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Payroll}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="TimeTracking" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_TimeTracking}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Finance" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏦" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Finance}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Administration (system administrators only) -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,16,12,0" Visibility="{Binding CanManageCompany, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{lex:Loc Nav_AdminSection}" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="8,0,0,12" />

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Company" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Company}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToModuleCommand}" CommandParameter="Users" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Users}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Button Command="{Binding OpenBackupDialogCommand}" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Backup}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenRestoreDialogCommand}" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Left" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♻️" Margin="0,0,10,0" FontSize="14" />
                                <TextBlock Text="{lex:Loc Nav_Restore}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active Module Footer -->
                    <Border DockPanel.Dock="Bottom" Margin="12,0,12,16" Padding="10" Background="#0D1117" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Footer_ActiveModule}" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            <TextBlock Text="{Binding ActiveModuleName}" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedTenant.Country, StringFormat='Paese Fiscale: {0}'}" FontSize="11" Foreground="#3FB950" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ShellStatusMessage}" FontSize="10" Foreground="#8B949E" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Focusable="False" />
        </Grid>

        <!-- ======================================================== -->
        <!-- LOCK SCREEN OVERLAY (password re-entry)                  -->
        <!-- ======================================================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#F20D1117"
            Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="32" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="🔒" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="{lex:Loc Lock_Title}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{lex:Loc Lock_Subtitle}" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />
                    <TextBlock Text="{lex:Loc Login_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding UnlockPassword, Mode=TwoWay}" Padding="10,8" Margin="0,0,0,16" />
                    <Button Command="{Binding UnlockApplicationCommand}" IsDefault="{Binding IsLocked}" Padding="16,12" Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#58A6FF" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <TextBlock Text="{lex:Loc Lock_Prompt}" />
                    </Button>
                    <TextBlock Text="{Binding LockStatusMessage}" Foreground="#F85149" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- BACKUP / RESTORE DIALOG                                  -->
        <!-- ======================================================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="150"
            Background="#CC0D1117"
            Visibility="{Binding IsBackupDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Padding="32" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Backup_Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" Visibility="{Binding IsRestoreMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock Text="{lex:Loc Backup_Subtitle}" FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,20" Visibility="{Binding IsRestoreMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock Text="{lex:Loc Restore_Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" Visibility="{Binding IsRestoreMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{lex:Loc Restore_Subtitle}" FontSize="12" Foreground="#F0883E" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding IsRestoreMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding BackupFilePath}" FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,16" Visibility="{Binding IsRestoreMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="{lex:Loc Login_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding BackupPassword, Mode=TwoWay}" Padding="10,8" Margin="0,0,0,12" />
                    <StackPanel Visibility="{Binding IsRestoreMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="{lex:Loc Setup_PasswordConfirm}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                        <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding BackupPasswordConfirm, Mode=TwoWay}" Padding="10,8" Margin="0,0,0,12" />
                    </StackPanel>

                    <syncfusion:SfBusyIndicator IsBusy="{Binding IsBusy}" AnimationType="DoubleCircle" Height="40" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Command="{Binding CancelBackupDialogCommand}" Padding="16,10" Margin="0,0,8,0" Background="#21262D" Foreground="#E6EDF3" BorderBrush="#444C56" Cursor="Hand">
                            <TextBlock Text="{lex:Loc Common_Cancel}" />
                        </Button>
                        <Button Command="{Binding ConfirmBackupDialogCommand}" Padding="16,10" Background="#238636" Foreground="#FFFFFF" BorderBrush="#3FB950" FontWeight="Bold" Cursor="Hand" Visibility="{Binding IsRestoreMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{lex:Loc Backup_Confirm}" />
                        </Button>
                        <Button Command="{Binding ConfirmBackupDialogCommand}" Padding="16,10" Background="#DA3633" Foreground="#FFFFFF" BorderBrush="#F85149" FontWeight="Bold" Cursor="Hand" Visibility="{Binding IsRestoreMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{lex:Loc Restore_Confirm}" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding BackupStatusMessage}" Foreground="#F85149" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- SIGN-IN OVERLAY (user name + password)                   -->
        <!-- ======================================================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="200"
            Background="#0D1117"
            Visibility="{Binding IsLoggedOut, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Padding="36" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="⚡" FontSize="28" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{lex:Loc App_BrandName}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{lex:Loc Login_Title}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{lex:Loc Login_Subtitle}" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <TextBlock Text="{lex:Loc Login_UserName}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBox Text="{Binding LoginUserName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,14" />
                    <TextBlock Text="{lex:Loc Login_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding LoginPassword, Mode=TwoWay}" Padding="10,8" Margin="0,0,0,20" />

                    <Button Command="{Binding LoginCommand}" IsDefault="{Binding IsLoggedOut}" Padding="16,12" Background="#238636" Foreground="#FFFFFF" BorderBrush="#3FB950" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <TextBlock Text="{lex:Loc Login_Button}" />
                    </Button>
                    <TextBlock Text="{Binding LoginStatusMessage}" Foreground="#F85149" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- FIRST-RUN SETUP OVERLAY (create system administrator)    -->
        <!-- ======================================================== -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="300"
            Background="#0D1117"
            Visibility="{Binding IsSetupRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Padding="36" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Setup_Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{lex:Loc Setup_Subtitle}" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <TextBlock Text="{lex:Loc Login_UserName}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SetupUserName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,12" />
                    <TextBlock Text="{lex:Loc Setup_DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SetupDisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,12" />
                    <TextBlock Text="{lex:Loc Login_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding SetupPassword, Mode=TwoWay}" Padding="10,8" Margin="0,0,0,12" />
                    <TextBlock Text="{lex:Loc Setup_PasswordConfirm}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding SetupPasswordConfirm, Mode=TwoWay}" Padding="10,8" Margin="0,0,0,20" />

                    <Button Command="{Binding CompleteSetupCommand}" IsDefault="{Binding IsSetupRequired}" Padding="16,12" Background="#238636" Foreground="#FFFFFF" BorderBrush="#3FB950" FontWeight="Bold" FontSize="14" Cursor="Hand">
                        <TextBlock Text="{lex:Loc Setup_Button}" />
                    </Button>
                    <TextBlock Text="{Binding SetupStatusMessage}" Foreground="#F85149" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>
