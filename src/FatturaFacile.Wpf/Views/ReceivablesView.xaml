<UserControl
    x:Class="FatturaFacile.Wpf.Views.ReceivablesView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    xmlns:views="clr-namespace:FatturaFacile.Wpf.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:ReceivablesViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D29922" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="QueueRowTemplate">
            <DockPanel Margin="0,2">
                <Button
                    DockPanel.Dock="Right"
                    Content="{lex:Loc Receivables_Dismiss}"
                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Padding="8,2"
                    Visibility="{Binding DataContext.HasConflicts, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding ActionText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Reference, Mode=OneWay}" />
                    <Run Text="{Binding WhenText, Mode=OneWay}" Foreground="#8B949E" />
                    <Run Text="{Binding Error, Mode=OneWay}" Foreground="#F85149" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding FlushCommand}" Content="{lex:Loc Receivables_FlushNow}" Padding="14,6" Margin="0,0,8,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
                    <Button Command="{Binding LoadCommand}" Content="{lex:Loc Receivables_Refresh}" Padding="14,6" />
                </StackPanel>
                <TextBlock Text="{lex:Loc Receivables_Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="{lex:Loc Receivables_Customer}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="260" ItemsSource="{Binding CustomerChoices}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Label" />
                <TextBlock Text="{lex:Loc Receivables_CustomerId}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox Text="{Binding CustomerIdText, UpdateSourceTrigger=PropertyChanged}" Width="280" />
                <Button Command="{Binding SelectCustomerIdCommand}" Content="{lex:Loc Receivables_Select}" Padding="10,2" Margin="6,0,0,0" />
                <TextBlock Text="{lex:Loc Receivables_Currency}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox Text="{Binding CurrencyText, UpdateSourceTrigger=LostFocus}" Width="60" MaxLength="3" />
            </WrapPanel>

            <TextBlock Text="{Binding LastSyncedText}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Notice}" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <WrapPanel Margin="0,0,0,8">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiExposure}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalExposureText}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiOpen}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalOpenText}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiOverdue}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OverdueText}" Style="{StaticResource KpiValue}" Foreground="#D29922" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiOver90}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Over90Text}" Style="{StaticResource KpiValue}" Foreground="#F85149" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiDso}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DsoText}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiProvision}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ProvisionText}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiNrv}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding NetRealizableText}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Receivables_KpiOverrides}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OverridesText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Receivables_BlockedTitle}" Style="{StaticResource SectionTitle}" Foreground="#F85149" />
                    <ItemsControl ItemsSource="{Binding Blocked}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button
                                        DockPanel.Dock="Right"
                                        Content="{lex:Loc Receivables_OpenCredit}"
                                        Command="{Binding DataContext.ShowBlockedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2" />
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding ExposureText, Mode=OneWay}" Foreground="#8B949E" />
                                        <Run Text="{Binding Reason, Mode=OneWay}" Foreground="#F85149" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Receivables_QueueTitle}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueRowTemplate}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Receivables_ConflictsTitle}" Style="{StaticResource SectionTitle}" Foreground="#F85149" />
                    <ItemsControl ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource QueueRowTemplate}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{lex:Loc Receivables_TabItems}">
                <views:ReceivablesOpenItemsView DataContext="{Binding OpenItems}" />
            </TabItem>
            <TabItem Header="{lex:Loc Receivables_TabAging}">
                <views:ReceivablesAgingView DataContext="{Binding Aging}" />
            </TabItem>
            <TabItem Header="{lex:Loc Receivables_TabProvision}">
                <views:ReceivablesProvisionView DataContext="{Binding Provision}" />
            </TabItem>
            <TabItem Header="{lex:Loc Receivables_TabCredit}">
                <views:ReceivablesCreditView DataContext="{Binding Credit}" />
            </TabItem>
            <TabItem Header="{lex:Loc Receivables_TabLedger}">
                <views:ReceivablesLedgerView DataContext="{Binding Ledger}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
