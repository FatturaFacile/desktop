<UserControl
    x:Class="FatturaFacile.Wpf.Views.PurchaseFulfilmentView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:PurchaseFulfilmentViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,6,8,2" />
        </Style>

        <Style x:Key="ReadGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MaxHeight" Value="260" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="{lex:Loc Procurement_Refresh}" Padding="14,6" />
            <TextBlock Text="{lex:Loc Procurement_Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{Binding LastSyncedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="{Binding QueueText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="{lex:Loc Procurement_Offline}" Foreground="#D29922" FontWeight="SemiBold" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="#D29922" Margin="0,0,0,6" TextWrapping="Wrap" />
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl>
            <!-- Overdue orders and reminders -->
            <TabItem Header="{lex:Loc Procurement_TabOverdue}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding OverdueOrders}" SelectedItem="{Binding SelectedOverdue}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{lex:Loc Procurement_Number}" Binding="{Binding Number}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Supplier}" Binding="{Binding SupplierName}" Width="*" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Promised}" Binding="{Binding PromisedText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_DaysOverdue}" Binding="{Binding DaysText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Reminders}" Binding="{Binding RemindersText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_LastReminder}" Binding="{Binding LastReminderText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_NextDue}" Binding="{Binding NextDueText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Command="{Binding RemindCommand}" Content="{lex:Loc Procurement_Remind}" HorizontalAlignment="Left" Padding="14,6" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Orders: lines with dual unit of measure and cascade, confirmation, dispatch -->
            <TabItem Header="{lex:Loc Procurement_TabOrders}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{lex:Loc Procurement_Status}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="220" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Label" />
                        </WrapPanel>
                        <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{lex:Loc Procurement_Number}" Binding="{Binding Number}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Supplier}" Binding="{Binding SupplierName}" Width="*" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Status}" Binding="{Binding StatusText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Expected}" Binding="{Binding ExpectedText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Promised}" Binding="{Binding PromisedText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_ConfirmationNumber}" Binding="{Binding ConfirmationText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Reminders}" Binding="{Binding RemindersText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_DropshipFlag}" Binding="{Binding DropshipText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Total}" Binding="{Binding TotalText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedOrderTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedOrderSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />

                            <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding OrderLines}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Line}" Binding="{Binding LineNumber}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Description}" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Quantity}" Binding="{Binding QuantityText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_BaseQuantity}" Binding="{Binding BaseQuantityText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Received}" Binding="{Binding ReceivedText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_UnitPrice}" Binding="{Binding UnitPriceText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Cascade}" Binding="{Binding CascadeText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_EffectiveDiscount}" Binding="{Binding EffectiveDiscountText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Promised}" Binding="{Binding PromisedText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_NetAmount}" Binding="{Binding NetText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Dispatch -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_DispatchSection}" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{lex:Loc Procurement_Channel}" Style="{StaticResource FormLabel}" />
                                        <ComboBox Width="140" ItemsSource="{Binding Channels}" SelectedValue="{Binding SelectedChannel}" SelectedValuePath="Code" DisplayMemberPath="Label" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_Recipient}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="260" Text="{Binding DispatchRecipient, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <Button Command="{Binding DispatchCommand}" Content="{lex:Loc Procurement_Dispatch}" Padding="14,4" />
                                    </WrapPanel>
                                    <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding Dispatches}" Margin="0,8,0,0" MaxHeight="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Channel}" Binding="{Binding ChannelText}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Recipient}" Binding="{Binding RecipientText}" Width="*" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Status}" Binding="{Binding StatusText}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_When}" Binding="{Binding WhenText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Supplier confirmation -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_ConfirmationSection}" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{lex:Loc Procurement_ConfirmationNumber}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="160" Text="{Binding ConfirmationNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_ConfirmedDate}" Style="{StaticResource FormLabel}" />
                                        <DatePicker SelectedDate="{Binding ConfirmationDate}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_PromisedDate}" Style="{StaticResource FormLabel}" />
                                        <DatePicker SelectedDate="{Binding PromisedDate}" />
                                    </WrapPanel>
                                    <TextBlock Text="{lex:Loc Procurement_Notes}" Style="{StaticResource FormLabel}" />
                                    <TextBox Text="{Binding ConfirmationNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" />
                                    <TextBlock Text="{lex:Loc Procurement_ConfirmationHint}" Style="{StaticResource MutedText}" Margin="0,6,0,4" TextWrapping="Wrap" />
                                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" ItemsSource="{Binding ConfirmationLines}" MaxHeight="220" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Description}" Binding="{Binding Label}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_OrderedQuantity}" Binding="{Binding OrderedText}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_ConfirmedQuantity}" Binding="{Binding ConfirmedQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_ConfirmedPrice}" Binding="{Binding ConfirmedPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Header="{lex:Loc Procurement_ConfirmedLineDate}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <DatePicker SelectedDate="{Binding ConfirmedDate, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Reason}" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Command="{Binding RecordConfirmationCommand}" Content="{lex:Loc Procurement_RecordConfirmation}" HorizontalAlignment="Left" Padding="14,4" />
                                    <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding Confirmations}" Margin="0,8,0,0" MaxHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{lex:Loc Procurement_ConfirmationNumber}" Binding="{Binding Number}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_When}" Binding="{Binding DateText}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Variance}" Binding="{Binding VarianceText}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_NeedsReview}" Binding="{Binding ReviewText}" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_VarianceLines}" Binding="{Binding LinesText}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Reminder log -->
                            <TextBlock Text="{lex:Loc Procurement_ReminderLog}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding Reminders}" MaxHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Level}" Binding="{Binding LevelText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Channel}" Binding="{Binding ChannelText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_DaysOverdue}" Binding="{Binding DaysText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_When}" Binding="{Binding WhenText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Dropshipment: DDT and delivery -->
            <TabItem Header="{lex:Loc Procurement_TabDropship}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{lex:Loc Procurement_Status}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="220" ItemsSource="{Binding DropshipFilters}" SelectedItem="{Binding SelectedDropshipFilter}" DisplayMemberPath="Label" />
                        </WrapPanel>
                        <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding Dropships}" SelectedItem="{Binding SelectedDropship}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{lex:Loc Procurement_Status}" Binding="{Binding StatusText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_RecipientName}" Binding="{Binding RecipientText}" Width="*" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_DdtNumber}" Binding="{Binding DdtText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_BillingAuthorized}" Binding="{Binding BillingText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Delivered}" Binding="{Binding DeliveredText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding HasSelectedDropship, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DropshipSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap" />

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_DdtSection}" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{lex:Loc Procurement_Carrier}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="160" Text="{Binding DdtCarrier, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_Tracking}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="160" Text="{Binding DdtTracking, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_Packages}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="60" Text="{Binding DdtPackagesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_Weight}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="80" Text="{Binding DdtWeightText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_TransportBy}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="120" Text="{Binding DdtTransportBy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_ShipmentDate}" Style="{StaticResource FormLabel}" />
                                        <DatePicker SelectedDate="{Binding DdtShipmentDate}" Margin="0,0,16,0" />
                                        <Button Command="{Binding IssueDdtCommand}" Content="{lex:Loc Procurement_IssueDdt}" Padding="14,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_DeliverySection}" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{lex:Loc Procurement_Delivered}" Style="{StaticResource FormLabel}" />
                                        <DatePicker SelectedDate="{Binding DeliveryDate}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_DeliveryProof}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="180" Text="{Binding DeliveryProof, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                        <TextBlock Text="{lex:Loc Procurement_SupplierShipmentReference}" Style="{StaticResource FormLabel}" />
                                        <TextBox Width="180" Text="{Binding DeliverySupplierReference, UpdateSourceTrigger=PropertyChanged}" />
                                    </WrapPanel>
                                    <TextBlock Text="{lex:Loc Procurement_DeliveryHint}" Style="{StaticResource MutedText}" Margin="0,6,0,4" TextWrapping="Wrap" />
                                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" ItemsSource="{Binding DeliveryLines}" MaxHeight="200" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{lex:Loc Procurement_Description}" Binding="{Binding Label}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_OpenQuantity}" Binding="{Binding OpenText}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="{lex:Loc Procurement_QuantityDelivered}" Binding="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Command="{Binding RecordDeliveryCommand}" Content="{lex:Loc Procurement_RecordDelivery}" HorizontalAlignment="Left" Padding="14,4" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{lex:Loc Procurement_Movements}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding Movements}" MaxHeight="140">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Direction}" Binding="{Binding DirectionText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_BaseQuantity}" Binding="{Binding QuantityText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_Value}" Binding="{Binding ValueText}" />
                                    <DataGridTextColumn Header="{lex:Loc Procurement_When}" Binding="{Binding WhenText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{lex:Loc Procurement_CreateSection}" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="{lex:Loc Procurement_SalesOrderId}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="280" Text="{Binding CreateSalesOrderIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                    <TextBlock Text="{lex:Loc Procurement_SupplierId}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="280" Text="{Binding CreateSupplierIdText, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Text="{lex:Loc Procurement_RecipientName}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="180" Text="{Binding CreateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                    <TextBlock Text="{lex:Loc Procurement_Street}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="180" Text="{Binding CreateStreet, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <TextBox Width="50" Text="{Binding CreateHouseNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                    <TextBlock Text="{lex:Loc Procurement_PostalCode}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="70" Text="{Binding CreatePostalCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                    <TextBlock Text="{lex:Loc Procurement_City}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="140" Text="{Binding CreateCity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                    <TextBlock Text="{lex:Loc Procurement_Country}" Style="{StaticResource FormLabel}" />
                                    <TextBox Width="40" MaxLength="2" Text="{Binding CreateCountry, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                    <Button Command="{Binding CreateDropshipCommand}" Content="{lex:Loc Procurement_CreateDropship}" Padding="14,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Pricing preview: cascade, dual UoM, currency -->
            <TabItem Header="{lex:Loc Procurement_TabPricing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <WrapPanel>
                            <TextBlock Text="{lex:Loc Procurement_PricingQuantity}" Style="{StaticResource FormLabel}" />
                            <TextBox Width="80" Text="{Binding PricingQuantityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                            <TextBlock Text="{lex:Loc Procurement_UnitPrice}" Style="{StaticResource FormLabel}" />
                            <TextBox Width="90" Text="{Binding PricingPriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                            <TextBlock Text="{lex:Loc Procurement_PricingCascade}" Style="{StaticResource FormLabel}" />
                            <TextBox Width="140" Text="{Binding PricingCascadeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                            <TextBlock Text="{lex:Loc Procurement_PricingFactor}" Style="{StaticResource FormLabel}" />
                            <TextBox Width="70" Text="{Binding PricingFactorText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                            <TextBlock Text="{lex:Loc Procurement_PricingRate}" Style="{StaticResource FormLabel}" />
                            <TextBox Width="70" Text="{Binding PricingRateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                            <TextBlock Text="{lex:Loc Procurement_PricingTax}" Style="{StaticResource FormLabel}" />
                            <TextBox Width="60" Text="{Binding PricingTaxText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                            <Button Command="{Binding PreviewPricingCommand}" Content="{lex:Loc Procurement_Preview}" Padding="14,4" />
                        </WrapPanel>
                        <TextBlock Text="{lex:Loc Procurement_PricingHint}" Style="{StaticResource MutedText}" Margin="0,6,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PricingNote}" Foreground="#D29922" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <WrapPanel Visibility="{Binding HasPricing, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_EffectiveDiscount}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding EffectiveDiscountText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_NetUnitPrice}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding NetUnitPriceText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_LineNet}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding LineNetText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_LineTax}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding LineTaxText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_LineTotal}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding LineTotalText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_QuantityBase}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding QuantityBaseText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_PricePerBase}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding PricePerBaseText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{lex:Loc Procurement_CompanyCurrency}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding CompanyCurrencyText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Offline queue -->
            <TabItem Header="{lex:Loc Procurement_TabQueue}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <Button Command="{Binding FlushQueueCommand}" Content="{lex:Loc Procurement_SendQueue}" HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,8" />
                        <TextBlock Text="{lex:Loc Procurement_Pending}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding PendingQueue}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{lex:Loc Procurement_ActionColumn}" Binding="{Binding ActionText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Reference}" Binding="{Binding Reference}" Width="*" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_When}" Binding="{Binding WhenText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Error}" Binding="{Binding ErrorText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{lex:Loc Procurement_Refused}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid Style="{StaticResource ReadGrid}" ItemsSource="{Binding ConflictQueue}" x:Name="ConflictGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{lex:Loc Procurement_ActionColumn}" Binding="{Binding ActionText}" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Reference}" Binding="{Binding Reference}" Width="*" />
                                <DataGridTextColumn Header="{lex:Loc Procurement_Error}" Binding="{Binding ErrorText}" />
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{lex:Loc Procurement_Dismiss}" Padding="10,2"
                                                    Command="{Binding DataContext.DismissConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
