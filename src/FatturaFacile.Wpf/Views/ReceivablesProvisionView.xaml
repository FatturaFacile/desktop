<UserControl
    x:Class="FatturaFacile.Wpf.Views.ReceivablesProvisionView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    xmlns:views="clr-namespace:FatturaFacile.Wpf.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:ReceivablesProvisionViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D29922" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultState}" Value="Good">
                    <Setter Property="Foreground" Value="#3FB950" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultState}" Value="Warn">
                    <Setter Property="Foreground" Value="#D29922" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultState}" Value="Bad">
                    <Setter Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="{lex:Loc Receivables_Refresh}" Padding="12,4" />
                <TextBlock Text="{lex:Loc Receivables_ProvisionTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding NoticeText}" Style="{StaticResource Notice}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Notice}" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc Receivables_ColBucket}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{lex:Loc Receivables_ColOpen}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="{lex:Loc Receivables_ColRate}" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="{lex:Loc Receivables_ColProvision}" Style="{StaticResource Caption}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding OpenText}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding ProvisionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,6" />
                    <WrapPanel>
                        <TextBlock Text="{lex:Loc Receivables_TotalOpen}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TotalOpenText}" FontWeight="SemiBold" Margin="0,0,16,0" />
                        <TextBlock Text="{lex:Loc Receivables_TotalProvision}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TotalProvisionText}" FontWeight="SemiBold" Foreground="#D29922" Margin="0,0,16,0" />
                        <TextBlock Text="{lex:Loc Receivables_Nrv}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding NetRealizableText}" FontWeight="SemiBold" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding SaveRatesCommand}" Content="{lex:Loc Receivables_SaveRates}" Padding="12,4" Margin="0,0,8,0" />
                        <Button Command="{Binding ResetDefaultsCommand}" Content="{lex:Loc Receivables_ResetRates}" Padding="12,4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource ResultText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Receivables_DsoTitle}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{lex:Loc Receivables_DsoPeriod}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding PeriodDaysText, UpdateSourceTrigger=LostFocus}" Width="60" />
                        <Button Command="{Binding RefreshCommand}" Content="{lex:Loc Receivables_Apply}" Padding="10,2" Margin="8,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DsoText}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DsoDetail}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
