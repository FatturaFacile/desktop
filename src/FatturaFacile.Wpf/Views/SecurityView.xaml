<UserControl
    x:Class="FatturaFacile.Wpf.Views.SecurityView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="clr-namespace:FatturaFacile.Wpf.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:viewModels="clr-namespace:FatturaFacile.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:SecurityViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Security_Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                    <!-- Local data encryption -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Security_Encryption_Header}" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding EncryptionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F85149" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                <Setter Property="Foreground" Value="#3FB950" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{lex:Loc Security_DatabaseEncrypted}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseEncryptedText}" Foreground="#E6EDF3" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="{lex:Loc Security_FieldEncryption}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FieldEncryptionText}" Foreground="#E6EDF3" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Text="{lex:Loc Security_KeyDpapi}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KeyDpapiText}" Foreground="#E6EDF3" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Text="{lex:Loc Security_Scheme}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProtectionScheme}" Foreground="#E6EDF3" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Text="{lex:Loc Security_Path}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DatabasePath}" Foreground="#8B949E" TextWrapping="Wrap" />
                            </Grid>
                            <Button Command="{Binding LoadCommand}" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <TextBlock Text="{lex:Loc Common_Refresh}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Session lock -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Security_Lock_Header}" Style="{StaticResource SectionHeader}" />
                            <CheckBox IsChecked="{Binding IdleLockEnabled}" Margin="0,0,0,10" Foreground="#E6EDF3">
                                <TextBlock Text="{lex:Loc Security_Lock_Enabled}" />
                            </CheckBox>
                            <TextBlock Text="{lex:Loc Security_Lock_Timeout}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LockTimeoutMinutes, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldBox}" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding LockHint}" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,2,0,10" />
                            <CheckBox IsChecked="{Binding RequirePinToUnlock}" Margin="0,0,0,10" Foreground="#E6EDF3">
                                <TextBlock Text="{lex:Loc Security_Lock_Pin}" />
                            </CheckBox>
                            <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left">
                                <TextBlock Text="{lex:Loc Common_Save}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Offline audit queue -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Security_Queue_Header}" Style="{StaticResource SectionHeader}" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="{lex:Loc Security_Queue_Pending}" Foreground="#8B949E" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding PendingCount}" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,24,0" />
                                <TextBlock Text="{lex:Loc Security_Queue_Synced}" Foreground="#8B949E" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SyncedCount}" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,24,0" />
                                <TextBlock Text="{lex:Loc Security_Queue_LastSync}" Foreground="#8B949E" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LastSyncText}" FontWeight="Bold" Foreground="#E6EDF3" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ChainStatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F85149" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChainIsIntact}" Value="True">
                                                <Setter Property="Foreground" Value="#3FB950" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding VerifyChainCommand}" Style="{StaticResource ToolbarButton}">
                                    <TextBlock Text="{lex:Loc Security_Queue_Verify}" />
                                </Button>
                                <Button Command="{Binding SyncAuditNowCommand}" Style="{StaticResource PrimaryButton}">
                                    <TextBlock Text="{lex:Loc Security_Queue_SyncNow}" />
                                </Button>
                            </StackPanel>
                            <syncfusion:SfDataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" AllowSorting="True" AllowResizingColumns="True" ColumnSizer="Auto" SelectionMode="Single" NavigationMode="Row" MaxHeight="320">
                                <syncfusion:SfDataGrid.Columns>
                                    <syncfusion:GridTextColumn MappingName="Sequence" HeaderText="{lex:Loc Security_Col_Sequence}" />
                                    <syncfusion:GridTextColumn MappingName="OccurredAt" HeaderText="{lex:Loc Security_Col_Occurred}" />
                                    <syncfusion:GridTextColumn MappingName="Entity" HeaderText="{lex:Loc Security_Col_Entity}" />
                                    <syncfusion:GridTextColumn MappingName="Action" HeaderText="{lex:Loc Security_Col_Action}" />
                                    <syncfusion:GridTextColumn MappingName="Status" HeaderText="{lex:Loc Security_Col_Status}" />
                                    <syncfusion:GridTextColumn MappingName="ServerReceivedAt" HeaderText="{lex:Loc Security_Col_Server}" />
                                </syncfusion:SfDataGrid.Columns>
                            </syncfusion:SfDataGrid>
                        </StackPanel>
                    </Border>

                    <!-- PII unmasking -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Security_Pii_Header}" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{lex:Loc Security_Pii_Hint}" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button Command="{Binding OpenUnmaskDialogCommand}" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left">
                                <TextBlock Text="{lex:Loc Security_Pii_Open}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- PII unmasking confirmation dialog -->
        <Grid Background="#CC0D1117" Visibility="{Binding IsUnmaskDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Padding="28" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Security_Pii_DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <TextBlock Text="{lex:Loc Security_Pii_Hint}" FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="{lex:Loc Security_Pii_EntityType}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UnmaskEntityType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                    <TextBlock Text="{lex:Loc Security_Pii_EntityId}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UnmaskEntityId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                    <TextBlock Text="{lex:Loc Security_Pii_Field}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UnmaskField, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                    <TextBlock Text="{Binding JustificationLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UnmaskJustification, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" />
                    <TextBlock Text="{Binding JustificationError}" Foreground="#F85149" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <StackPanel Visibility="{Binding HasRevealedValue, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,0">
                        <TextBlock Text="{lex:Loc Security_Pii_Revealed}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RevealedValue, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}" />
                        <Button Command="{Binding HideRevealedCommand}" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left">
                            <TextBlock Text="{lex:Loc Security_Pii_Hide}" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding UnmaskStatusMessage}" Foreground="#D29922" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding CancelUnmaskCommand}" Style="{StaticResource ToolbarButton}">
                            <TextBlock Text="{lex:Loc Security_Pii_Cancel}" />
                        </Button>
                        <Button Command="{Binding ConfirmUnmaskCommand}" Style="{StaticResource PrimaryButton}">
                            <TextBlock Text="{lex:Loc Security_Pii_Confirm}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
