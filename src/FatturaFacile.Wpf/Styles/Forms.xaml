<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared form styles for editors (dark Fluent palette) -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="#161B22" />
        <Setter Property="BorderBrush" Value="#30363D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#58A6FF" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#8B949E" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,12,10" />
    </Style>

    <Style x:Key="FieldCombo" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,12,10" />
    </Style>

    <Style x:Key="FieldPassword" TargetType="PasswordBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,12,10" />
    </Style>

    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#2D333B" />
        <Setter Property="Foreground" Value="#E6EDF3" />
        <Setter Property="BorderBrush" Value="#444C56" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Background" Value="#238636" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#3FB950" />
    </Style>
</ResourceDictionary>
