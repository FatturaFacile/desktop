<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>FatturaFacile.Wpf</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  
            <IsPackable>false</IsPackable>
    <Title>FatturaFacile.Wpf</Title>
    <Product>FatturaFacile.Wpf</Product>
    <Description>FatturaFacile.Wpf.</Description>
    <PackageId>FatturaFacile.Wpf</PackageId>
    <RootNamespace>FatturaFacile.Wpf</RootNamespace>
    <AssemblyName>FatturaFacile.Wpf</AssemblyName>
    <Namespace>FatturaFacile.Wpf</Namespace>                    <WindowsPackageType>MSIX</WindowsPackageType>
        <GenerateAppInstallerFile>true</GenerateAppInstallerFile>
         <UseWPF>true</UseWPF>   
      <NeutralLanguage>it-IT</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="FatturaFacile.UnitTests" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatturaFacile.Domain\FatturaFacile.Domain.csproj" />
    <ProjectReference Include="..\FatturaFacile.Application\FatturaFacile.Application.csproj" />
    <ProjectReference Include="..\FatturaFacile.Infrastructure\FatturaFacile.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="Syncfusion.PdfViewer.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.SfBusyIndicator.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.SfChart.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.DataGridExcelExport.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.SfInput.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Themes.FluentDark.WPF" Version="35.1.43" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\Strings.*.resx">
      <DependentUpon>Strings.resx</DependentUpon>
      <LogicalName>FatturaFacile.Wpf.Localization.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.322" />
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <PackageReference Update="StyleCop.Analyzers" Version="1.3.177-beta" />
  </ItemGroup>

</Project>
