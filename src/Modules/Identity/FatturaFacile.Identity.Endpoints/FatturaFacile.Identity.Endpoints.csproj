    <PackageId>FatturaFacile.Identity.Endpoints</PackageId>
    <RootNamespace>FatturaFacile.Identity.Endpoints</RootNamespace>
    <AssemblyName>FatturaFacile.Identity.Endpoints</AssemblyName>
    <Namespace>FatturaFacile.Identity.Endpoints</Namespace>
