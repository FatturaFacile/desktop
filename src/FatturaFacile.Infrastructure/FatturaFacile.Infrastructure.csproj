<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
        <Title>FatturaFacile.Infrastructure</Title>
        <Product>FatturaFacile.Infrastructure</Product>
        <Description>FatturaFacile.Infrastructure</Description>
        <PackageId>FatturaFacile.Infrastructure</PackageId>
        <RootNamespace>FatturaFacile.Infrastructure</RootNamespace>
        <AssemblyName>FatturaFacile.Infrastructure</AssemblyName>
        <UseWPF>true</UseWPF>
        <IsPackable>true</IsPackable>

    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FatturaFacile.Domain\FatturaFacile.Domain.csproj" />
        <ProjectReference Include="..\FatturaFacile.Application\FatturaFacile.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
        <PackageReference Include="QRCoder" Version="1.8.1" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="Syncfusion.DocIO.Wpf" Version="35.1.46" />
        <PackageReference Include="Syncfusion.DocToPDFConverter.Wpf" Version="35.1.46" />
        <PackageReference Include="Syncfusion.Pdf.Wpf" Version="35.1.46" />
        <PackageReference Include="Syncfusion.XlsIO.Wpf" Version="35.1.46" />
        <PackageReference Update="Microsoft.Extensions.StaticAnalysis" Version="11.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="Meziantou.Analyzer" Version="3.0.339">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
        <PackageReference Update="StyleCop.Analyzers" Version="1.3.180">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
