@namespace FatturaFacile.Modules.AgentsAPI

<div>
    @{
        var weatherData = GetWeatherFromFunctionCalls(functionCalls: Message.FunctionCalls);

        if (weatherData != null)
        {
            <div style="padding: 0.5rem 0 0.5rem 0;">
                <WeatherWidgetComponent WeatherData="@weatherData"/>
            </div>
        }

        if (!string.IsNullOrWhiteSpace(value: Message.Text))
        {
            <div>@ToHtml(markdown: Message.Text)</div>
        }

    }
</div>
