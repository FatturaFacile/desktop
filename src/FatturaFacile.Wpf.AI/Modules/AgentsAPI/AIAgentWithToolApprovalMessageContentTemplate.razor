@namespace FatturaFacile
@using FatturaFacile.Agents.ToolApprovals
@using Microsoft.Extensions.AI

<div>
    @{
        if (!string.IsNullOrEmpty(value: Message.Text))
        {
    <div class="tool-approval-text">@Message.Text</div>
    }

    ToolApprovalRequestBatch requestBatch = null;

    foreach (var content in Message.Contents)
    {
    var request = content as ToolApprovalRequestContent;

    if (request == null || !RequestToBatchMap.TryGetValue(key: request.RequestId, value: out requestBatch))
    continue;

    var toolCall = request.ToolCall as FunctionCallContent;

    var isResolved = requestBatch.IsRequestResolved(requestId: request.RequestId);
    var isRejected = requestBatch.IsRequestRejected(requestId: request.RequestId);
    var titleCss   = "tool-approval-title" + (isResolved ? (isRejected ? " is-rejected" : " is-approved") : "");

    <div class="tool-approval-card">
        <div class="@titleCss">
            @if (isResolved)
            {
            <span class="tool-approval-icon">@(isRejected ? "✖" : "✔")</span>
            }
            <span>@GetToolCallTitle(fc: toolCall)</span>
        </div>
        <div class="tool-approval-args">
            @foreach (var row in GetToolCallRows(fc: toolCall))
            {
            <div class="tool-approval-arg">
                <span class="tool-approval-arg-key">@row.Key</span>
                <span class="tool-approval-arg-value">@row.Value</span>
            </div>
            }
        </div>
        @if (!isResolved)
        {
        <div class="tool-approval-actions">
            <button class="tool-approval-btn tool-approval-btn-approve"
                    @onclick="() => Approve(requestId: request.RequestId, requestBatch: requestBatch)">Approve
            </button>
            <button class="tool-approval-btn tool-approval-btn-reject"
                    @onclick="() => Reject(requestId: request.RequestId, requestBatch: requestBatch)">Reject
            </button>
        </div>
        }
    </div>
    }

    var pendingRequestsCount = requestBatch?.CountPendingRequests() ?? -1;

    if (pendingRequestsCount > 0)
    {
    <div class="tool-approval-batch-status">
        Waiting for @pendingRequestsCount more decision(s) before sending...
    </div>
    }

    }
</div>

<style>
    .tool-approval-text {
        margin-bottom: 4px;
    }

    .tool-approval-card {
        margin: 0;
    }

    .tool-approval-title {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 0 12px;
        font-weight: 600;
        color: var(--dxds-color-content-neutral-default-rest, #212529);
    }

    .tool-approval-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .tool-approval-title.is-approved .tool-approval-icon {
        color: var(--dxds-color-surface-success-default-rest, #198754);
    }

    .tool-approval-title.is-rejected .tool-approval-icon {
        color: var(--dxds-color-surface-danger-default-rest, #dc3545);
    }

    .tool-approval-args {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 8px;
        row-gap: 4px;
        font-size: 0.85em;
        color: var(--dxds-color-content-neutral-default-rest, #495057);
    }

    .tool-approval-arg {
        display: contents;
    }

    .tool-approval-arg-key {
        white-space: nowrap;
    }

    .tool-approval-arg-value {
        word-break: break-word;
        font-weight: 600;
    }

    .tool-approval-actions {
        display: flex;
        gap: 8px;
        padding: 16px 0 0;
    }

    .tool-approval-btn {
        padding: 6px 16px;
        border: 1px solid transparent;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9em;
        font-weight: 500;
    }

    .tool-approval-btn-approve {
        background: var(--dxds-color-content-primary-default-rest, #0d6efd);
        color: #fff;
        border-color: var(--dxds-color-content-primary-default-rest, #0d6efd);
    }

    .tool-approval-btn-approve:hover {
        filter: brightness(0.92);
    }

    .tool-approval-btn-reject {
        background: var(--dxds-color-surface-neutral-default-rest, #e9ecef);
        color: var(--dxds-color-content-neutral-default-rest, #212529);
        border-color: var(--dxds-color-border-neutral-default-rest, #dee2e6);
    }

    .tool-approval-btn-reject:hover {
        filter: brightness(0.95);
    }

    .tool-approval-batch-status {
        margin-top: 8px;
        padding: 6px 10px;
        background: var(--dxds-color-surface-neutral-default-rest, #f8f9fa);
        border: 1px solid var(--dxds-color-border-neutral-default-rest, rgba(0, 0, 0, 0.1));
        border-radius: 6px;
        font-size: 0.85em;
        color: var(--dxds-color-content-neutral-subdued-rest, #6c757d);
    }
</style>

@code {

[Parameter] public BlazorChatMessage Message { get; set; } = default!;

[Parameter] public Dictionary<string, ToolApprovalRequestBatch> RequestToBatchMap { get; set; } = default!;

[Parameter] public Func<List<AIContent>, Task> SendResponsesAsync { get; set; } = default!;

async Task Approve(
string                   requestId,
ToolApprovalRequestBatch requestBatch)
{
requestBatch.ApproveRequest(requestId: requestId);
await TrySendBatchResponsesAsync(requestBatch: requestBatch);
}

async Task Reject(
string                   requestId,
ToolApprovalRequestBatch requestBatch)
{
requestBatch.RejectRequest(requestId: requestId);
await TrySendBatchResponsesAsync(requestBatch: requestBatch);
}

async Task TrySendBatchResponsesAsync(ToolApprovalRequestBatch requestBatch)
{
if (requestBatch.CountPendingRequests() != 0) return;

await SendResponsesAsync(arg: requestBatch.GenerateResponses());
}

static string Arg(
FunctionCallContent fc,
string              key) =>
fc?.Arguments?.TryGetValue(key: key, value: out var v) == true ? v?.ToString() ?? "" : "";

static string GetToolCallTitle(FunctionCallContent fc) =>
fc?.Name switch
{
"UpdateAccountTier" => $"Bulk update {Arg(fc: fc,               key: "accountCount")} accounts",
"SendBulkEmail"     => $"Send payment reminders to {Arg(fc: fc, key: "clientCount")} clients",
"ArchiveOrders"     => "Tidy up order history",
_                   => fc?.Name ?? "Tool Call"
};

static IEnumerable<(string Key, string Value)> GetToolCallRows(FunctionCallContent fc)
{
switch (fc?.Name)
{
case "UpdateAccountTier":
var isActive = bool.TryParse(value: Arg(fc: fc, key: "isActive"), result: out var a) && a;

yield return ("State:", Arg(fc: fc, key: "state"));
yield return ("Filter:", isActive ? "Active accounts" : "Inactive accounts");
yield return ("Service level:", Arg(fc: fc, key: "newTier"));

break;
case "SendBulkEmail":
yield return ("Template:", Arg(fc: fc,      key: "template"));
yield return ("Total balance:", Arg(fc: fc, key: "totalBalance"));

break;
case "ArchiveOrders":
var recCount = int.TryParse(s: Arg(fc: fc, key: "recordCount"), result: out var rc)
? $"{rc:N0} Orders"
: $"{Arg(fc: fc, key: "recordCount")} Orders";

yield return ("Date Range:", $"{Arg(fc: fc, key: "startYear")}–{Arg(fc: fc, key: "year")}");
yield return ("Record Count:", recCount);
yield return ("Destination:", Arg(fc: fc, key: "destination"));

break;
default:
if (fc?.Arguments is not null)
{
foreach (var arg in fc.Arguments)
yield return (arg.Key + ":", arg.Value?.ToString() ?? "");
}

break;
}
}

}
