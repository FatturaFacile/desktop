    <Description>Shared application contracts, CQRS abstractions, MediatR pipeline behaviors, and error localization services for FatturaFacile.</Description>
    <PackageId>FatturaFacile.Application.Shared</PackageId>
    <RootNamespace>FatturaFacile.Application.Shared</RootNamespace>
    <AssemblyName>FatturaFacile.Application.Shared</AssemblyName>
