<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>FatturaFacile.Infrastructure.Common</Title>
    <Product>FatturaFacile.Infrastructure.Common</Product>
    <Description>Shared infrastructure services, EF Core interceptors, transactional outbox storage, and multi-tenant persistence infrastructure for FatturaFacile.</Description>
    <PackageId>FatturaFacile.Infrastructure.Common</PackageId>
    <RootNamespace>FatturaFacile.Infrastructure.Common</RootNamespace>
    <AssemblyName>FatturaFacile.Infrastructure.Common</AssemblyName>
    <Namespace>FatturaFacile.Infrastructure.Common</Namespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FatturaFacile.Application.Shared\FatturaFacile.Application.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Update="StyleCop.Analyzers" Version="1.3.171-beta">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
