<UserControl x:Class="FatturaFacile.Desktop.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="#0B0F19" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header & Action -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Localizer[Nav.Dashboard]}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Executive financial metrics and transaction overview" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Localizer[Header.NewInvoice]}" Command="{Binding CreateInvoiceCommand}"
                        Padding="16,10" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand"/>
                <Button Content="{Binding Localizer[Nav.Invoices]}" Command="{Binding NavigateToInvoicesCommand}"
                        Padding="16,10" Background="#1E293B" Foreground="#E2E8F0" FontWeight="SemiBold" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- KPI Cards Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Revenue -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Localizer[Dashboard.TotalSales]}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalRevenue}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,8,0,0"/>
                    <TextBlock Text="+12.4% vs last quarter" FontSize="11" Foreground="#4ADE80" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Open Invoices -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="20" Margin="6,0,6,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Localizer[Dashboard.OpenInvoices]}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OpenInvoicesTotal}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,8,0,0"/>
                    <TextBlock Text="8 pending collections" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Overdue Invoices -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="20" Margin="6,0,6,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Localizer[Dashboard.OverdueInvoices]}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OverdueInvoicesTotal}" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,8,0,0"/>
                    <TextBlock Text="2 overdue > 30 days" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Active Customers -->
            <Border Grid.Column="3" Background="#1E293B" CornerRadius="10" Padding="20" Margin="12,0,0,0" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Localizer[Dashboard.ActiveCustomers]}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveCustomersCount}" FontSize="22" FontWeight="Bold" Foreground="#A78BFA" Margin="0,8,0,0"/>
                    <TextBlock Text="Switzerland &amp; EU clients" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recent Activity Feed -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="20" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Localizer[Dashboard.RecentActivity]}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

                <ListView Grid.Row="1" ItemsSource="{Binding RecentActivities}" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Customer}" Foreground="#F1F5F9"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#4ADE80"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Time}" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
