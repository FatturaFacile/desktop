<UserControl x:Class="FatturaFacile.Desktop.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:converters="clr-namespace:FatturaFacile.Desktop.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#0F172A">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="460" Background="#1E293B" CornerRadius="12" Padding="36"
                BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Logo & Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="⚡ FatturaFacile ERP" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Localizer[Login.Subtitle]}" FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error Alert -->
                <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="12"
                        Margin="0,0,0,16" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="12" Margin="0,0,0,10"
                           HorizontalAlignment="Center" Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>

                <!-- Tenant Code -->
                <TextBlock Text="{Binding Localizer[Login.Tenant]}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBox Text="{Binding TenantSlug, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,8"
                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" FontSize="14" Margin="0,0,0,16"/>

                <!-- Email -->
                <TextBlock Text="{Binding Localizer[Login.Email]}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,8"
                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" FontSize="14" Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="{Binding Localizer[Login.Password]}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <PasswordBox x:Name="UserPasswordBox" Height="38" Padding="10,8"
                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" FontSize="14" Margin="0,0,0,24"
                             PasswordChanged="OnPasswordChanged"/>

                <!-- Sign In Button -->
                <Button Content="{Binding Localizer[Login.SignInButton]}" Command="{Binding SignInCommand}" Height="42"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>

                <!-- Offline notice -->
                <TextBlock Text="🔒 Compliant with Swiss nLPD / FADP | Argon2id Offline Security"
                           FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
