<UserControl x:Class="FatturaFacile.Desktop.Wpf.Views.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:converters="clr-namespace:FatturaFacile.Desktop.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:SwissCurrencyConverter x:Key="SwissCurrency"/>
    </UserControl.Resources>

    <Grid Background="#0B0F19" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Localizer[Invoices.Title]}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Manage sales invoices, credit notes and Swiss QR billing" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Localizer[Invoices.New]}" Command="{Binding CreateInvoiceCommand}"
                        Padding="16,10" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="{Binding Localizer[Invoices.Refresh]}" Command="{Binding RefreshCommand}"
                        Padding="14,10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="{Binding Localizer[Invoices.ExportExcel]}" Command="{Binding ExportExcelCommand}"
                        Padding="14,10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="{Binding Localizer[Invoices.ExportPdf]}" Command="{Binding ExportPdfCommand}"
                        Padding="14,10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- Search / Filter Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="🔍" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#F8FAFC"
                         BorderThickness="0" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Syncfusion SfDataGrid for Invoices -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
            <syncfusion:SfDataGrid ItemsSource="{Binding Invoices}"
                                   SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                                   AutoGenerateColumns="False"
                                   AllowSorting="True"
                                   AllowFiltering="True"
                                   SelectionMode="Single"
                                   Background="#0F172A"
                                   Foreground="#F1F5F9"
                                   RowHeight="38"
                                   HeaderRowHeight="42">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="InvoiceNumber" HeaderText="Invoice #" Width="140"/>
                    <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="Date" Pattern="ShortDate" Width="110"/>
                    <syncfusion:GridDateTimeColumn MappingName="DueDate" HeaderText="Due Date" Pattern="ShortDate" Width="110"/>
                    <syncfusion:GridTextColumn MappingName="CustomerName" HeaderText="Customer" Width="200"/>
                    <syncfusion:GridCurrencyColumn MappingName="TotalNet" HeaderText="Net" CurrencySymbol="CHF" Width="120"/>
                    <syncfusion:GridCurrencyColumn MappingName="TotalTax" HeaderText="VAT" CurrencySymbol="CHF" Width="100"/>
                    <syncfusion:GridCurrencyColumn MappingName="RoundingAmount" HeaderText="CHF 5c Round" CurrencySymbol="" Width="110"/>
                    <syncfusion:GridCurrencyColumn MappingName="TotalGross" HeaderText="Gross Total" CurrencySymbol="CHF" Width="130"/>
                    <syncfusion:GridTextColumn MappingName="Currency" HeaderText="Cur" Width="60"/>
                    <syncfusion:GridTextColumn MappingName="PaymentStatus" HeaderText="Status" Width="110"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Border>
    </Grid>
</UserControl>
