<UserControl x:Class="FatturaFacile.Desktop.Wpf.Views.InvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:converters="clr-namespace:FatturaFacile.Desktop.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0B0F19">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Action Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Localizer[InvoiceDetail.Title]}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Edit invoice lines, apply VAT, and inspect Swiss QR-Bill" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Localizer[InvoiceDetail.Save]}" Command="{Binding SaveInvoiceCommand}"
                            Padding="16,10" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="{Binding Localizer[InvoiceDetail.GenerateQrBill]}" Command="{Binding ToggleQrPreviewCommand}"
                            Padding="14,10" Background="#0D9488" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="{Binding Localizer[InvoiceDetail.Cancel]}" Command="{Binding CancelCommand}"
                            Padding="14,10" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>

            <!-- Status message -->
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="13" Margin="0,0,0,16"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>

            <!-- Header Info Panel -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Invoice # -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="{Binding Localizer[Invoices.InvoiceNumber]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF"
                                 BorderBrush="#475569" BorderThickness="1" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <!-- Date -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,6,12">
                        <TextBlock Text="{Binding Localizer[Invoices.Date]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding Date}" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Due Date -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="6,0,6,12">
                        <TextBlock Text="{Binding Localizer[Invoices.DueDate]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DueDate}" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Currency -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="12,0,0,12">
                        <TextBlock Text="{Binding Localizer[Invoices.Currency]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF"
                                 BorderBrush="#475569" BorderThickness="1" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <!-- Customer Guid -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Localizer[Invoices.Customer]}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ContactId}" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,0,0,0">
                        <TextBlock Text="Notes / Payment Terms" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Line Items Table -->
            <Border Grid.Row="3" Background="#1E293B" CornerRadius="10" Padding="20" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Localizer[InvoiceDetail.Items]}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Button Content="{Binding Localizer[InvoiceDetail.AddItem]}" Command="{Binding AddItemCommand}"
                                DockPanel.Dock="Right" Padding="12,6" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"/>
                    </DockPanel>

                    <!-- Line Items List -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Description -->
                                    <TextBox Grid.Column="0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="6" Margin="0,0,6,0"/>

                                    <!-- Quantity -->
                                    <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="6" Margin="0,0,6,0" TextAlignment="Right"/>

                                    <!-- Unit Price -->
                                    <TextBox Grid.Column="2" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="6" Margin="0,0,6,0" TextAlignment="Right"/>

                                    <!-- Tax Rate -->
                                    <TextBox Grid.Column="3" Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="6" Margin="0,0,6,0" TextAlignment="Right"/>

                                    <!-- Discount -->
                                    <TextBox Grid.Column="4" Text="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1" Padding="6" Margin="0,0,6,0" TextAlignment="Right"/>

                                    <!-- Line Total -->
                                    <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}"
                                               Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="6" Content="✖" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Height="28"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="#334155" Margin="0,16,0,16"/>

                    <!-- Summary Totals with Swiss 5c rounding -->
                    <StackPanel HorizontalAlignment="Right" Width="300">
                        <DockPanel Margin="0,4">
                            <TextBlock Text="{Binding Localizer[Invoices.TotalNet]}" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalNet, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="{Binding Localizer[Invoices.TotalTax]}" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalTax, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="{Binding Localizer[Invoices.Rounding]}" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding RoundingAmount, StringFormat='{}{0:+0.00;-0.00;0.00}'}" HorizontalAlignment="Right" Foreground="#F59E0B" FontWeight="SemiBold"/>
                        </DockPanel>

                        <Separator Background="#475569" Margin="0,8"/>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="{Binding Localizer[Invoices.TotalGross]}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalGross, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="18" FontWeight="Bold"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Swiss QR-Bill Preview Panel -->
            <Border Grid.Row="4" Background="#1E293B" CornerRadius="10" Padding="20" BorderBrush="#0D9488" BorderThickness="2"
                    Visibility="{Binding ShowQrPreview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="🇨🇭 Swiss QR-Bill Live Preview (SIX Swiss Interbank Clearing Standards)"
                               FontSize="16" FontWeight="Bold" Foreground="#2DD4BF" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding QrBillText}" FontFamily="Consolas" FontSize="13" Background="#0F172A" Foreground="#F8FAFC"
                             IsReadOnly="True" TextWrapping="Wrap" Padding="14" BorderBrush="#334155" BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
