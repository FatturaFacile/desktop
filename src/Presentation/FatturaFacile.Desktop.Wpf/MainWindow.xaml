<Window x:Class="FatturaFacile.Desktop.Wpf.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FatturaFacile.Desktop.Wpf.Converters"
        xmlns:views="clr-namespace:FatturaFacile.Desktop.Wpf.Views"
        xmlns:viewmodels="clr-namespace:FatturaFacile.Desktop.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- DataTemplate mappings for dynamic view resolution -->
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InvoiceListViewModel}">
            <views:InvoiceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InvoiceDetailViewModel}">
            <views:InvoiceDetailView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Unauthenticated Login View Container -->
        <ContentControl Content="{Binding CurrentContent}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

        <!-- Authenticated Shell Container -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <!-- Top Header Bar -->
                <RowDefinition Height="*"/>
                <!-- Main Workspace (Sidebar + Content) -->
                <RowDefinition Height="32"/>
                <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER BAR (Dynamics / SAP Style) -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,0">
                <DockPanel LastChildFill="True">
                    <!-- Brand & Sidebar Toggle -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0"
                                Foreground="#38BDF8" FontSize="18" Padding="6,4" Margin="0,0,12,0" Cursor="Hand" Content="☰"/>
                        <TextBlock Text="⚡ FatturaFacile ERP" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Active Tenant Dropdown -->
                    <Border DockPanel.Dock="Left" Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="24,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏢" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveTenantName}" Foreground="#F1F5F9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- User Profile & Language Switcher -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Action New Invoice -->
                        <Button Content="{Binding Localizer[Header.NewInvoice]}" Command="{Binding QuickNewInvoiceCommand}"
                                Padding="12,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand"/>

                        <!-- Language Selector (EN, IT, DE, FR) -->
                        <ComboBox SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" SelectedValuePath="Tag"
                                  Width="70" Height="30" Margin="0,0,16,0" Background="#1E293B" Foreground="#000000" VerticalAlignment="Center">
                            <ComboBoxItem Content="EN" Tag="en"/>
                            <ComboBoxItem Content="IT" Tag="it"/>
                            <ComboBoxItem Content="DE" Tag="de"/>
                            <ComboBoxItem Content="FR" Tag="fr"/>
                        </ComboBox>

                        <!-- User Profile Badge -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveUserName}" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Sign Out -->
                        <Button Content="{Binding Localizer[Header.SignOut]}" Command="{Binding SignOutCommand}"
                                Padding="10,6" Background="Transparent" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Global Search Box -->
                    <Border Background="#1E293B" CornerRadius="6" Margin="24,10" VerticalAlignment="Center" Padding="10,4" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <TextBlock Text="🔍" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" VerticalAlignment="Center"
                                     ToolTip="{Binding Localizer[Header.GlobalSearch]}"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 2. MAIN WORKSPACE (SIDEBAR + CONTENT TABS) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Collapsible Left Navigation Drawer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Document Workspace Region -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Drawer -->
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"
                        MinWidth="250">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavigationGroups}" Margin="12,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Header}" IsExpanded="True" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,8">
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="16,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Title}"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Destination}"
                                                            Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                                            HorizontalContentAlignment="Left" Padding="8,6" Margin="0,2" Cursor="Hand"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Active Content Region -->
                <Border Grid.Column="1" Background="#0B0F19">
                    <ContentControl Content="{Binding CurrentContent}"/>
                </Border>
            </Grid>

            <!-- 3. BOTTOM STATUS BAR -->
            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Localizer[Status.OfflineReady]}" Foreground="#94A3B8" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="|" Foreground="#334155" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Localizer[Status.Ready]}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding Localizer[Status.BackgroundTasks]}" Foreground="#94A3B8" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="|" Foreground="#334155" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Localizer[Status.Version]}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
