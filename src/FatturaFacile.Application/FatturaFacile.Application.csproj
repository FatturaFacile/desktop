<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>FatturaFacile.Application</Title>
        <Product>FatturaFacile.Application</Product>
        <Description>FatturaFacile.Application</Description>
        <PackageId>FatturaFacile.Application</PackageId>
        <RootNamespace>FatturaFacile.Application</RootNamespace>
        <AssemblyName>FatturaFacile.Application</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FatturaFacile.Domain\FatturaFacile.Domain.csproj" />
    </ItemGroup>


    <ItemGroup>
        <Compile Update="Resources\GenericResource.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>GenericResource.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\ValidationResource.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>ValidationResource.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\ErrorResource.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>ErrorResource.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\GenericResource.de.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\GenericResource.en.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
        </EmbeddedResource>
