<dx:ThemedWindow x:Class="FatturaFacile.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                 xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
                 xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:vm="clr-namespace:FatturaFacile.ViewModels;assembly=FatturaFacile.Wpf.Modules"
                 xmlns:views="clr-namespace:FatturaFacile.Views;assembly=FatturaFacile.Wpf.Modules"
                 xmlns:loc="clr-namespace:FatturaFacile.Markup;assembly=FatturaFacile.Wpf.Common"
                 mc:Ignorable="d"
                 Title="{loc:Translate App.Title}"
                 Height="850"
                 Width="1350"
                 MinHeight="700"
                 MinWidth="1050"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource AppBackgroundBrush}">

    <dxmvvm:Interaction.Behaviors>
        <!-- Servizio modale per il ViewModel -->
        <dx:DXMessageBoxService />
    </dxmvvm:Interaction.Behaviors>

    <dx:ThemedWindow.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoicesViewModel}">
            <views:InvoicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TireHotelViewModel}">
            <views:TireHotelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeTrackingViewModel}">
            <views:TimeTrackingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocalizationAdminViewModel}">
            <views:LocalizationAdminView />
        </DataTemplate>
    </dx:ThemedWindow.Resources>

    <Grid>
        <!-- Layout dell'Applicazione -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Top Header Bar -->
                <RowDefinition Height="Auto" />
                <!-- Ribbon Bar -->
                <RowDefinition Height="*" />
                <!-- Workspace Docking Area -->
            </Grid.RowDefinitions>

            <!-- 1. Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand / Logo -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{DynamicResource NavButtonStyle}"
                                Command="{Binding ToggleSidebarCommand}"
                                Padding="8"
                                Margin="0,0,12,0"
                                ToolTip="Espandi/Comprimi Sidebar">
                            <Path Data="{StaticResource IconBars}"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="FatturaFacile"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Background="{DynamicResource SwissAccentBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="IT / CH"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Tenant, Lingua, Tema, Profilo -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Header.Tenant}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Tenants}"
                                  SelectedItem="{Binding CurrentTenant}"
                                  DisplayMemberPath="Code"
                                  Width="130"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center" />

                        <TextBlock Text="{loc:Translate Header.Language}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding CurrentLanguage}"
                                  Width="65"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center" />

                        <Button Style="{DynamicResource NavButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                Margin="0,0,16,0"
                                Padding="8"
                                ToolTip="Cambia Tema">
                            <Path Data="{StaticResource IconSun}"
                                  Fill="{DynamicResource WarningBrush}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform" />
                        </Button>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="16"
                                Padding="10,4"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUser}"
                                      Fill="{DynamicResource PrimaryBrush}"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentUsername}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <Border Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserRole}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Style="{DynamicResource NavButtonStyle}"
                                Command="{Binding LockSessionCommand}"
                                Padding="8"
                                Margin="0,0,6,0"
                                ToolTip="{loc:Translate Header.LockSession}">
                            <Path Data="{StaticResource IconLock}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Style="{DynamicResource NavButtonStyle}"
                                Command="{Binding LogoutCommand}"
                                Padding="8"
                                ToolTip="{loc:Translate Header.Logout}">
                            <Path Data="{StaticResource IconSignOut}"
                                  Fill="{DynamicResource DangerBrush}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Ribbon Bar per controlli di finestra e layout -->
            <dxr:RibbonControl Grid.Row="1"
                               RibbonStyle="Office2019"
                               ShowApplicationButton="False">
                <dxr:RibbonDefaultPageCategory>
                    <dxr:RibbonPage Caption="Visualizza">
                        <dxr:RibbonPageGroup Caption="Layout e Finestre">
                            <dxb:BarButtonItem
                                Content="Ripristina Layout"
                                Glyph="{dx:DXImage 'SvgImages/Spreadsheet/ResetView.svg'}"
                                LargeGlyph="{dx:DXImage 'SvgImages/Spreadsheet/ResetView.svg'}"
                                Command="{Binding ResetLayoutCommand}" />
                        </dxr:RibbonPageGroup>
                    </dxr:RibbonPage>
                </dxr:RibbonDefaultPageCategory>
            </dxr:RibbonControl>

            <!-- 3. DockLayoutManager con persistenza e retrocompatibilità -->
            <dxdo:DockLayoutManager Grid.Row="2"
                                    x:Name="MainDockManager"
                                    dx:DXSerializer.SerializationID="MainDockManager"
                                    dx:DXSerializer.LayoutVersion="1.1"
                                    dx:DXSerializer.LayoutUpgrade="MainDockManager_OnLayoutUpgrade"
                                    dxdo:RestoreLayoutOptions.RemoveOldPanels="True"
                                    dxdo:RestoreLayoutOptions.AddNewPanels="True">
                <dxdo:LayoutGroup Orientation="Horizontal">
                    <!-- Pannello di Navigazione Moduli -->
                    <dxdo:LayoutPanel x:Name="NavigationPanel"
                                      Caption="Navigazione"
                                      ItemWidth="240"
                                      AllowClose="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,10,6,0">
                                <Button Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NavigateToDashboardCommand}"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDashboard}"
                                              Fill="{DynamicResource PrimaryBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Margin="4,0,10,0" />
                                        <TextBlock Text="{loc:Translate Nav.Dashboard}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NavigateToClientsCommand}"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClients}"
                                              Fill="{DynamicResource SuccessBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Margin="4,0,10,0" />
                                        <TextBlock Text="{loc:Translate Nav.Clients}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NavigateToInvoicesCommand}"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconInvoice}"
                                              Fill="{DynamicResource SwissAccentBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Margin="4,0,10,0" />
                                        <TextBlock Text="{loc:Translate Nav.Invoices}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NavigateToTireHotelCommand}"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCar}"
                                              Fill="{DynamicResource WarningBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Margin="4,0,10,0" />
                                        <TextBlock Text="{loc:Translate Nav.TireHotel}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NavigateToTimeTrackingCommand}"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClock}"
                                              Fill="{DynamicResource PrimaryBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Margin="4,0,10,0" />
                                        <TextBlock Text="{loc:Translate Nav.TimeTracking}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Separator Background="{DynamicResource BorderBrush}"
                                           Margin="0,8,0,8" />
                                <Button Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NavigateToLocalizationAdminCommand}"
                                        Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGlobe}"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Margin="4,0,10,0" />
                                        <TextBlock Text="{loc:Translate Nav.Localization}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </dxdo:LayoutPanel>

                    <!-- Document Group / Contenuto Principale -->
                    <dxdo:DocumentGroup x:Name="DocumentsGroup">
                        <dxdo:DocumentPanel x:Name="WorkspacePanel"
                                            Caption="Area di Lavoro"
                                            AllowClose="False">
                            <ContentControl Content="{Binding CurrentViewModel}" />
                        </dxdo:DocumentPanel>
                    </dxdo:DocumentGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>

        <!-- Overlay: Sessione Bloccata -->
        <Border Background="#E60B0F19"
                Visibility="{Binding IsSessionLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Style="{DynamicResource CardBorderStyle}"
                    Width="380"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconLock}"
                          Fill="{DynamicResource SwissAccentBrush}"
                          Width="40"
                          Height="40"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16" />
                    <TextBlock Text="Sessione Bloccata"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CurrentUsername}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />
                    <Button Content="Sblocca Sessione"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding UnlockSessionCommand}"
                            Height="38" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Overlay: Login Obbligatorio -->
        <views:LoginDialog DataContext="{Binding LoginVM}">
            <views:LoginDialog.Style>
                <Style TargetType="views:LoginDialog">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}"
                                     Value="False">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LoginDialog.Style>
        </views:LoginDialog>
    </Grid>
</dx:ThemedWindow>
