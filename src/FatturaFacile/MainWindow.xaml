<dx:ThemedWindow
    x:Class="FatturaFacile.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxaichat="http://schemas.devexpress.com/winfx/2008/xaml/aichat"
    Title="MainWindow"
        Height="800"
        Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <dxe:ComboBoxEdit
            x:Name="filesFilterEdit"
            SelectedIndexChanged="FilesFilterEdit_OnSelectedIndexChanged"
            NullText="Select the files to search in. Default is all files."
            ItemsSource="{Binding ItemsSource}">
            <dxe:ComboBoxEdit.StyleSettings>
                <dxe:CheckedComboBoxStyleSettings/>
            </dxe:ComboBoxEdit.StyleSettings>
        </dxe:ComboBoxEdit>

        <dxaichat:AIChatControl
            x:Name="aiChatControl"
            Grid.Row="1"
            Initialized="AiChatControl_Initialized"
            ContentFormat="Markdown"
            MarkdownConvert="AiChatControl_MarkdownConvert"
            UseStreaming="True"
            InputEnabled="True"/>
    </Grid>
</dx:ThemedWindow>




