<Window x:Class="FatturaFacile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
        xmlns:views="clr-namespace:FatturaFacile.Views"
        xmlns:loc="clr-namespace:FatturaFacile.Markup"
        mc:Ignorable="d"
        Title="{loc:Translate App.Title}"
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoicesViewModel}">
            <views:InvoicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TireHotelViewModel}">
            <views:TireHotelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeTrackingViewModel}">
            <views:TimeTrackingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocalizationAdminViewModel}">
            <views:LocalizationAdminView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Main Application Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" /> <!-- Top Header Bar -->
                <RowDefinition Height="*" />  <!-- Workspace Body -->
            </Grid.RowDefinitions>

            <!-- 1. Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Hamburger & Logo -->
                        <ColumnDefinition Width="*" />    <!-- Spacer -->
                        <ColumnDefinition Width="Auto" /> <!-- Controls & User Profile -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sidebar Toggle & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource NavButtonStyle}" Command="{Binding ToggleSidebarCommand}"
                                Padding="8" Margin="0,0,12,0" ToolTip="Espandi/Comprimi Sidebar">
                            <Path Data="{StaticResource IconBars}" Fill="{DynamicResource TextPrimaryBrush}" Width="16"
                                  Height="16" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="FatturaFacile" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Background="{DynamicResource SwissAccentBrush}" CornerRadius="4" Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="IT / CH" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Tenant, Language, Theme, User Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dynamic Tenant Switcher -->
                        <TextBlock Text="{loc:Translate Header.Tenant}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Tenants}"
                                  SelectedItem="{Binding CurrentTenant}"
                                  DisplayMemberPath="Code"
                                  Width="140" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <!-- Dynamic Language Switcher -->
                        <TextBlock Text="{loc:Translate Header.Language}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding CurrentLanguage}"
                                  Width="70" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <!-- Theme Toggle Button -->
                        <Button Style="{DynamicResource NavButtonStyle}" Command="{Binding ToggleThemeCommand}"
                                Margin="0,0,16,0" Padding="8" ToolTip="Cambia Tema Scuro/Chiaro">
                            <Path Data="{StaticResource IconSun}" Fill="{DynamicResource WarningBrush}" Width="16"
                                  Height="16" Stretch="Uniform" />
                        </Button>

                        <!-- User Profile Badge -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="16" Padding="10,4"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUser}" Fill="{DynamicResource PrimaryBrush}" Width="12"
                                      Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentUsername}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="4,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserRole}" FontSize="9" FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Lock Session Button -->
                        <Button Style="{DynamicResource NavButtonStyle}" Command="{Binding LockSessionCommand}"
                                Padding="8" Margin="0,0,6,0" ToolTip="{loc:Translate Header.LockSession}">
                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Logout Button -->
                        <Button Style="{DynamicResource NavButtonStyle}" Command="{Binding LogoutCommand}" Padding="8"
                                ToolTip="{loc:Translate Header.Logout}">
                            <Path Data="{StaticResource IconSignOut}" Fill="{DynamicResource DangerBrush}" Width="14"
                                  Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Workspace Body: Sidebar + Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Collapsible Sidebar -->
                    <ColumnDefinition Width="*" />    <!-- Content Canvas -->
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel
                        Width="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Width" Value="240" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Width" Value="64" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Margin="10,16,10,0">
                            <!-- Dashboard -->
                            <Button Style="{DynamicResource NavButtonStyle}"
                                    Command="{Binding NavigateToDashboardCommand}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDashboard}" Fill="{DynamicResource PrimaryBrush}"
                                          Width="16" Height="16" Stretch="Uniform" Margin="4,0,14,0" />
                                    <TextBlock Text="{loc:Translate Nav.Dashboard}" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Clients -->
                            <Button Style="{DynamicResource NavButtonStyle}"
                                    Command="{Binding NavigateToClientsCommand}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClients}" Fill="{DynamicResource SuccessBrush}"
                                          Width="16" Height="16" Stretch="Uniform" Margin="4,0,14,0" />
                                    <TextBlock Text="{loc:Translate Nav.Clients}" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Invoices -->
                            <Button Style="{DynamicResource NavButtonStyle}"
                                    Command="{Binding NavigateToInvoicesCommand}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInvoice}" Fill="{DynamicResource SwissAccentBrush}"
                                          Width="16" Height="16" Stretch="Uniform" Margin="4,0,14,0" />
                                    <TextBlock Text="{loc:Translate Nav.Invoices}" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Tire Hotel -->
                            <Button Style="{DynamicResource NavButtonStyle}"
                                    Command="{Binding NavigateToTireHotelCommand}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCar}" Fill="{DynamicResource WarningBrush}"
                                          Width="16" Height="16" Stretch="Uniform" Margin="4,0,14,0" />
                                    <TextBlock Text="{loc:Translate Nav.TireHotel}" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- Time Tracking -->
                            <Button Style="{DynamicResource NavButtonStyle}"
                                    Command="{Binding NavigateToTimeTrackingCommand}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClock}" Fill="{DynamicResource PrimaryBrush}"
                                          Width="16" Height="16" Stretch="Uniform" Margin="4,0,14,0" />
                                    <TextBlock Text="{loc:Translate Nav.TimeTracking}" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,12" />

                            <!-- Dynamic Localization Admin -->
                            <Button Style="{DynamicResource NavButtonStyle}"
                                    Command="{Binding NavigateToLocalizationAdminCommand}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGlobe}" Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="16" Height="16" Stretch="Uniform" Margin="4,0,14,0" />
                                    <TextBlock Text="{loc:Translate Nav.Localization}" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Active Content Frame -->
                <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>

        <!-- Session Lock Overlay -->
        <Border Background="#E60B0F19"
                Visibility="{Binding IsSessionLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Style="{DynamicResource CardBorderStyle}" Width="380" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconLock}" Fill="{DynamicResource SwissAccentBrush}" Width="40"
                          Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="Sessione Bloccata per Inattività" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CurrentUsername}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,20" />
                    <Button Content="Sblocca Sessione" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding UnlockSessionCommand}" Height="38" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Mandatory Login View Overlay -->
        <views:LoginDialog DataContext="{Binding LoginVM}">
            <views:LoginDialog.Style>
                <Style TargetType="views:LoginDialog">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LoginDialog.Style>
        </views:LoginDialog>
    </Grid>
</Window>








