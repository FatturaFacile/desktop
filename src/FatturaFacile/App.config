<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup
                name="userSettings"
                type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section
                    name="Properties.Settings"
                    type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                    allowExeDefinition="MachineToLocalUser"
                    requirePermission="false" />
        </sectionGroup>

        <sectionGroup
                name="userSettings"
                type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section
                    name="DXThemeManager"
                    type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                    allowExeDefinition="MachineToLocalUser"
                    requirePermission="false" />
            <section
                    name="DevExpress.DevAV.Properties.Settings"
                    type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                    allowExeDefinition="MachineToLocalUser"
                    requirePermission="false" />
        </sectionGroup>
        <sectionGroup
                name="userSettings"
                type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
        <section
                name="Properties.Settings"
                type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                allowExeDefinition="MachineToLocalUser"
                requirePermission="false" />
        <sectionGroup
                name="userSettings"
                type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section
                    name="DXThemeManager"
                    type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                    allowExeDefinition="MachineToLocalUser"
                    requirePermission="false" />
            <section
                    name="DevExpress.DevAV.Properties.Settings"
                    type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                    allowExeDefinition="MachineToLocalUser"
                    requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup>
        <supportedRuntime
                version="v4.0"
                sku=".NETFramework,Version=v4.6.2" />
    </startup>
    <runtime>
        <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
    </runtime>
    <appSettings>
        <!-- Azure OpenAI: resource endpoint, for example: https://<resource>.openai.azure.com -->
        <add
                key="AzureOpenAI.Endpoint"
                value="https://api.devexpress.com/demo-openai" />
        <!-- Azure OpenAI: API key for authentication -->
        <add
                key="AzureOpenAI.Key"
                value="demo" />
        <!-- Azure OpenAI: deployment name of the model to be used -->
        <add
                key="AzureOpenAI.Deployment"
                value="demo" />
        <!-- Azure OpenAI: deployment name of the embeddings model to be used -->
        <add
                key="AzureOpenAI.EmbeddingsDeployment"
                value="text-embedding-3-small" />
        <!-- Ollama: server endpoint URL (for example: http://localhost:11434) -->
        <add
                key="Ollama.Uri"
                value="" />
        <!-- Ollama: model name (for example: llama3.2) -->
        <add
                key="Ollama.Model"
                value="" />

        <!-- OpenAI: API key from https://platform.openai.com/api-keys -->
        <add
                key="OpenAI.Key"
                value="" />
        <!-- OpenAI: model name (for example: gpt-4o-mini) -->
        <add
                key="OpenAI.Model"
                value="" />
    </appSettings>
    <connectionStrings configSource="connectionStrings.config" />
    <userSettings>
        <DevExpress.DevAV.Properties.Settings>
            <setting
                    name="TasksCustomFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>All</Name>
                            <FilterCriteria />
                            <ImageUri />
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="EmployeesCustomFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>On probation </Name>
                            <FilterCriteria>Not IsNull([ProbationReason])</FilterCriteria>
                            <ImageUri>Resources/Accordion/OnProbation.svg</ImageUri>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="CustomersCustomFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>Active</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.CustomerStatus,Active#</FilterCriteria>
                            <ImageUri>Resources/Accordion/Active.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Suspended</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.CustomerStatus,Suspended#</FilterCriteria>
                            <ImageUri>Resources/Accordion/Suspended.svg</ImageUri>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="CustomersStaticFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>All</Name>
                            <ImageUri>Resources/Accordion/All.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Stores &gt; 10 Locations</Name>
                            <FilterCriteria>[TotalStores] &gt; 10</FilterCriteria>
                            <ImageUri>Resources/Accordion/Store.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Revenues &gt; 100 Billion</Name>
                            <FilterCriteria>[AnnualRevenue] &gt; 100000000000.0m</FilterCriteria>
                            <ImageUri>Resources/Accordion/Revenues.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Employees &gt; 10000</Name>
                            <FilterCriteria>[TotalEmployees] &gt; 10000</FilterCriteria>
                            <ImageUri>Resources/Accordion/Employees.svg</ImageUri>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="ProductsCustomFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>Discontinued</Name>
                            <ImageUri>Resources/Accordion/Discontinued.svg</ImageUri>
                            <FilterCriteria>[Available] = False</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Out of Stock</Name>
                            <ImageUri>Resources/Accordion/OutOfStock.svg</ImageUri>
                            <FilterCriteria>[CurrentInventory] = 0</FilterCriteria>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="ProductsStaticFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>All</Name>
                            <ImageUri>Resources/Accordion/All.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Video Players</Name>
                            <ImageUri>Resources/Accordion/VideoPlayer.svg</ImageUri>
                            <FilterCriteria>[Category] =
                                ##Enum#DevExpress.DevAV.ProductCategory,VideoPlayers#</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Automation</Name>
                            <ImageUri>Resources/Accordion/Automation.svg</ImageUri>
                            <FilterCriteria>[Category] =
                                ##Enum#DevExpress.DevAV.ProductCategory,Automation#</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Monitors</Name>
                            <ImageUri>Resources/Accordion/Monitor.svg</ImageUri>
                            <FilterCriteria>[Category] =
                                ##Enum#DevExpress.DevAV.ProductCategory,Monitors#</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Projectors</Name>
                            <ImageUri>Resources/Accordion/Projector.svg</ImageUri>
                            <FilterCriteria>[Category] =
                                ##Enum#DevExpress.DevAV.ProductCategory,Projectors#</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Televisions</Name>
                            <ImageUri>Resources/Accordion/Television.svg</ImageUri>
                            <FilterCriteria>[Category] =
                                ##Enum#DevExpress.DevAV.ProductCategory,Televisions#</FilterCriteria>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="OrdersCustomFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>Sales &gt; $5000</Name>
                            <FilterCriteria>[TotalAmount] &gt; 5000.0m</FilterCriteria>
                            <ImageUri>Resources/Accordion/SalesAsc.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Sales &lt; $5000</Name>
                            <FilterCriteria>[TotalAmount] &lt; 5000.0m</FilterCriteria>
                            <ImageUri>Resources/Accordion/SalesDesc.svg</ImageUri>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="OrdersStaticFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>All</Name>
                            <ImageUri>Resources/Accordion/All.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Today</Name>
                            <ImageUri>Resources/Accordion/Today.svg</ImageUri>
                            <FilterCriteria>IsOutlookIntervalToday([OrderDate])</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Yesterday</Name>
                            <ImageUri>Resources/Accordion/Yesterday.svg</ImageUri>
                            <FilterCriteria>IsOutlookIntervalYesterday([OrderDate])</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>This Month</Name>
                            <ImageUri>Resources/Accordion/ThisMonth.svg</ImageUri>
                            <FilterCriteria>IsOutlookIntervalEarlierThisMonth([OrderDate])</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>This Year</Name>
                            <ImageUri>Resources/Accordion/ThisYear.svg</ImageUri>
                            <FilterCriteria>IsOutlookIntervalEarlierThisYear([OrderDate])</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Unpaid Orders</Name>
                            <ImageUri>Resources/Accordion/Unpaid.svg</ImageUri>
                            <FilterCriteria>[PaymentTotal] = 0.0m</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Refunds</Name>
                            <ImageUri>Resources/Accordion/Refund.svg</ImageUri>
                            <FilterCriteria>[PaymentTotal] &gt; 0.0m AND [RefundTotal]  =
                                [PaymentTotal]</FilterCriteria>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="QuotesStaticFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>All</Name>
                            <ImageUri>Resources/Accordion/All.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Last Year</Name>
                            <ImageUri>Resources/Accordion/LastYear.svg</ImageUri>
                            <FilterCriteria>GetYear([Date])=(GetYear(LocalDateTimeNow())-1)</FilterCriteria>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>This Year</Name>
                            <ImageUri>Resources/Accordion/ThisYear.svg</ImageUri>
                            <FilterCriteria>IsOutlookIntervalEarlierThisYear([Date])</FilterCriteria>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="EmployeesStaticFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <FilterInfo>
                            <Name>All</Name>
                            <ImageUri>Resources/Accordion/All.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Salaried</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.EmployeeStatus,Salaried#</FilterCriteria>
                            <ImageUri>Resources/Accordion/Salaried.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Commission</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.EmployeeStatus,Commission#</FilterCriteria>
                            <ImageUri>Resources/Accordion/Commission.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Contract</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.EmployeeStatus,Contract#</FilterCriteria>
                            <ImageUri>Resources/Accordion/Contract.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Terminated</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.EmployeeStatus,Terminated#</FilterCriteria>
                            <ImageUri>Resources/Accordion/Terminated.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>On Leave</Name>
                            <FilterCriteria>[Status] =
                                ##Enum#DevExpress.DevAV.EmployeeStatus,OnLeave#</FilterCriteria>
                            <ImageUri>Resources/Accordion/OnLeave.svg</ImageUri>
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
            <setting
                    name="TasksStaticFilters"
                    serializeAs="Xml">
                <value>
                    <ArrayOfFilterInfo
                            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <FilterInfo>
                            <Name>All</Name>
                            <FilterCriteria />
                            <ImageUri>Resources/Accordion/All.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Overdue Tasks</Name>
                            <ImageUri>Resources/Accordion/OverdueTask.svg</ImageUri>
                            <FilterCriteria>(Not IsNull([DueDate]))AND([DueDate] &lt;
                                LocalDateTimeNow())AND(Not([Status] =
                                ##Enum#DevExpress.DevAV.EmployeeTaskStatus,Completed#))</FilterCriteria>
                            <ImageUri />
                        </FilterInfo>
                        <FilterInfo>
                            <Name>Incomplete Tasks</Name>
                            <FilterCriteria>Not([Status] =
                                ##Enum#DevExpress.DevAV.EmployeeTaskStatus,Completed#)</FilterCriteria>
                            <ImageUri>Resources/Accordion/IncompleteTask.svg</ImageUri>
                        </FilterInfo>
                        <FilterInfo>
                            <Name>High Priority Tasks</Name>
                            <ImageUri>Resources/Accordion/HighPriorityTask.svg</ImageUri>
                            <FilterCriteria>[Priority] =
                                ##Enum#DevExpress.DevAV.EmployeeTaskPriority,High#</FilterCriteria>
                            <ImageUri />
                        </FilterInfo>
                    </ArrayOfFilterInfo>
                </value>
            </setting>
        </DevExpress.DevAV.Properties.Settings>
        <Properties.Settings>
            <setting name="LogicalState" serializeAs="String">
                <value />
            </setting>
            <setting name="VisualState" serializeAs="String">
                <value />
            </setting>
        </Properties.Settings>
    </userSettings>
</configuration>
