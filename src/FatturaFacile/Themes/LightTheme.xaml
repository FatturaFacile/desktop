<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E2E8F0" />

    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#F8FAFC" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Brand & Accent Colors -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SwissAccentBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

    <!-- Inputs & Tables -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="#F8FAFC" />

</ResourceDictionary>
