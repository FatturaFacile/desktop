<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#334155" />
    
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#1E293B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <!-- Brand & Accent Colors -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" /> <!-- Azure -->
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SwissAccentBrush" Color="#E11D48" /> <!-- Crimson -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

    <!-- Inputs & Tables -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="#131D2E" />

</ResourceDictionary>
