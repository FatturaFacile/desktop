{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=FatturaFacile.db"
  },
  "AI": {
    "AzureOpenAI": {
      "Endpoint": "https://api.devexpress.com/demo-openai",
      "Key": "demo",
      "Deployment": "demo",
      "EmbeddingsDeployment": "text-embedding-3-small"
    },
    "Ollama": {
      "Uri": "",
      "Model": ""
    },
    "OpenAI": {
      "Key": "",
      "Model": ""
    }
  },
  "DevAVFilters": {
    "TasksCustomFilters": [
      {
        "Name": "All",
        "FilterCriteria": "",
        "ImageUri": ""
      }
    ],
    "EmployeesCustomFilters": [
      {
        "Name": "On probation",
        "FilterCriteria": "Not IsNull([ProbationReason])",
        "ImageUri": "Resources/Accordion/OnProbation.svg"
      }
    ],
    "CustomersCustomFilters": [
      {
        "Name": "Active",
        "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.CustomerStatus,Active#",
        "ImageUri": "Resources/Accordion/Active.svg"
      },
      {
        "Name": "Suspended",
        "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.CustomerStatus,Suspended#",
        "ImageUri": "Resources/Accordion/Suspended.svg"
      }
    ],
    "CustomersStaticFilters": [
      { "Name": "All", "ImageUri": "Resources/Accordion/All.svg" },
      { "Name": "Stores > 10 Locations", "FilterCriteria": "[TotalStores] > 10", "ImageUri": "Resources/Accordion/Store.svg" },
      { "Name": "Revenues > 100 Billion", "FilterCriteria": "[AnnualRevenue] > 100000000000.0m", "ImageUri": "Resources/Accordion/Revenues.svg" },
      { "Name": "Employees > 10000", "FilterCriteria": "[TotalEmployees] > 10000", "ImageUri": "Resources/Accordion/Employees.svg" }
    ],
    "ProductsCustomFilters": [
      { "Name": "Discontinued", "FilterCriteria": "[Available] = False", "ImageUri": "Resources/Accordion/Discontinued.svg" },
      { "Name": "Out of Stock", "FilterCriteria": "[CurrentInventory] = 0", "ImageUri": "Resources/Accordion/OutOfStock.svg" }
    ],
    "ProductsStaticFilters": [
      { "Name": "All", "ImageUri": "Resources/Accordion/All.svg" },
      { "Name": "Video Players", "FilterCriteria": "[Category] = ##Enum#DevExpress.DevAV.ProductCategory,VideoPlayers#", "ImageUri": "Resources/Accordion/VideoPlayer.svg" },
      { "Name": "Automation", "FilterCriteria": "[Category] = ##Enum#DevExpress.DevAV.ProductCategory,Automation#", "ImageUri": "Resources/Accordion/Automation.svg" },
      { "Name": "Monitors", "FilterCriteria": "[Category] = ##Enum#DevExpress.DevAV.ProductCategory,Monitors#", "ImageUri": "Resources/Accordion/Monitor.svg" },
      { "Name": "Projectors", "FilterCriteria": "[Category] = ##Enum#DevExpress.DevAV.ProductCategory,Projectors#", "ImageUri": "Resources/Accordion/Projector.svg" },
      { "Name": "Televisions", "FilterCriteria": "[Category] = ##Enum#DevExpress.DevAV.ProductCategory,Televisions#", "ImageUri": "Resources/Accordion/Television.svg" }
    ],
    "OrdersCustomFilters": [
      { "Name": "Sales > $5000", "FilterCriteria": "[TotalAmount] > 5000.0m", "ImageUri": "Resources/Accordion/SalesAsc.svg" },
      { "Name": "Sales < $5000", "FilterCriteria": "[TotalAmount] < 5000.0m", "ImageUri": "Resources/Accordion/SalesDesc.svg" }
    ],
    "OrdersStaticFilters": [
      { "Name": "All", "ImageUri": "Resources/Accordion/All.svg" },
      { "Name": "Today", "FilterCriteria": "IsOutlookIntervalToday([OrderDate])", "ImageUri": "Resources/Accordion/Today.svg" },
      { "Name": "Yesterday", "FilterCriteria": "IsOutlookIntervalYesterday([OrderDate])", "ImageUri": "Resources/Accordion/Yesterday.svg" },
      { "Name": "This Month", "FilterCriteria": "IsOutlookIntervalEarlierThisMonth([OrderDate])", "ImageUri": "Resources/Accordion/ThisMonth.svg" },
      { "Name": "This Year", "FilterCriteria": "IsOutlookIntervalEarlierThisYear([OrderDate])", "ImageUri": "Resources/Accordion/ThisYear.svg" },
      { "Name": "Unpaid Orders", "FilterCriteria": "[PaymentTotal] = 0.0m", "ImageUri": "Resources/Accordion/Unpaid.svg" },
      { "Name": "Refunds", "FilterCriteria": "[PaymentTotal] > 0.0m AND [RefundTotal] = [PaymentTotal]", "ImageUri": "Resources/Accordion/Refund.svg" }
    ],
    "QuotesStaticFilters": [
      { "Name": "All", "ImageUri": "Resources/Accordion/All.svg" },
      { "Name": "Last Year", "FilterCriteria": "GetYear([Date])=(GetYear(LocalDateTimeNow())-1)", "ImageUri": "Resources/Accordion/LastYear.svg" },
      { "Name": "This Year", "FilterCriteria": "IsOutlookIntervalEarlierThisYear([Date])", "ImageUri": "Resources/Accordion/ThisYear.svg" }
    ],
    "EmployeesStaticFilters": [
      { "Name": "All", "ImageUri": "Resources/Accordion/All.svg" },
      { "Name": "Salaried", "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.EmployeeStatus,Salaried#", "ImageUri": "Resources/Accordion/Salaried.svg" },
      { "Name": "Commission", "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.EmployeeStatus,Commission#", "ImageUri": "Resources/Accordion/Commission.svg" },
      { "Name": "Contract", "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.EmployeeStatus,Contract#", "ImageUri": "Resources/Accordion/Contract.svg" },
      { "Name": "Terminated", "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.EmployeeStatus,Terminated#", "ImageUri": "Resources/Accordion/Terminated.svg" },
      { "Name": "On Leave", "FilterCriteria": "[Status] = ##Enum#DevExpress.DevAV.EmployeeStatus,OnLeave#", "ImageUri": "Resources/Accordion/OnLeave.svg" }
    ],
    "TasksStaticFilters": [
      { "Name": "All", "FilterCriteria": "", "ImageUri": "Resources/Accordion/All.svg" },
      { "Name": "Overdue Tasks", "FilterCriteria": "(Not IsNull([DueDate]))AND([DueDate] < LocalDateTimeNow())AND(Not([Status] = ##Enum#DevExpress.DevAV.EmployeeTaskStatus,Completed#))", "ImageUri": "Resources/Accordion/OverdueTask.svg" },
      { "Name": "Incomplete Tasks", "FilterCriteria": "Not([Status] = ##Enum#DevExpress.DevAV.EmployeeTaskStatus,Completed#)", "ImageUri": "Resources/Accordion/IncompleteTask.svg" },
      { "Name": "High Priority Tasks", "FilterCriteria": "[Priority] = ##Enum#DevExpress.DevAV.EmployeeTaskPriority,High#", "ImageUri": "Resources/Accordion/HighPriorityTask.svg" }
    ]
  }
}
