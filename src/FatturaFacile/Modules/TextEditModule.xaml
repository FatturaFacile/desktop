<dxdb:DemoModule x:Class="AIDemo.TextEditModule"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:dxai="http://schemas.devexpress.com/winfx/2008/xaml/ai"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 mc:Ignorable="d"
                 d:DesignHeight="500" d:DesignWidth="600">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Margin="20,16" Width="400">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                <Run Text="Edit Documents with Artificial Intelligence (AI)-powered Assistance"
                     FontSize="16" FontWeight="Bold"/>
                <LineBreak/>
                <LineBreak/><Run Text="Speed - up User Input with Smart Autocomplete: use predictions and relevant text suggestions in real - time to boost productivity and accuracy during manual text entry."/>
                <LineBreak/>
                <LineBreak/>
                <LineBreak/><Run Text="Start to use AI with opening context menu and choosing the function which we deliver for you"
                     FontWeight="Bold" />
            </TextBlock>
            <Image VerticalAlignment="Center" x:Name="image" />
            <TextBox x:Name="textBox" Visibility="Collapsed" />
        </StackPanel>
        <dx:ThemedBorder Background="{Binding ElementName=textBox, Path=Background}"
                         BorderThickness="0,0,1,0">
            <dxe:TextEdit x:Name="mainTextEdit"
                          DockPanel.Dock="Left"
                          VerticalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Top"
                          TextWrapping="Wrap"
                          ShowBorder="False"
                          AcceptsReturn="True">
                <dxmvvm:Interaction.Behaviors>
                    <dxai:ExpandBehavior />
                    <dxai:ShortenBehavior/>
                    <dxai:SummarizeBehavior/>
                    <dxai:ExplainBehavior/>
                    <dxai:ChangeToneBehavior />
                    <dxai:ProofreadBehavior/>
                    <dxai:ChangeStyleBehavior/>
                    <dxai:TranslateBehavior>
                        <dxai:LanguageInfo Culture="en-US"/>
                        <dxai:LanguageInfo Culture="de-DE"/>
                        <dxai:LanguageInfo Culture="fr-FR"/>
                    </dxai:TranslateBehavior>
                    <dxai:CustomRequestBehavior/>
                </dxmvvm:Interaction.Behaviors>
            </dxe:TextEdit>
        </dx:ThemedBorder>
    </DockPanel>
</dxdb:DemoModule>