<dxdb:DemoModule x:Class="AIDemo.AIChatFileAttachmentsModule"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                 xmlns:dxaichat="http://schemas.devexpress.com/winfx/2008/xaml/aichat"
                 xmlns:local="clr-namespace:AIDemo"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      x:Name="PART_Options"
                      DockPanel.Dock="Right"
                      dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                      Focusable="False">
            <dxlc:LayoutControl Width="210"
                                Margin="12,0,12,12">
                <dxlc:LayoutGroup ItemSpace="8" Orientation="Vertical">
                    <dxlc:LayoutItem Label="Selected File Type"
                                     LabelPosition="Top">
                        <dxe:ComboBoxEdit x:Name="selectedFileTypeEdit"
                                          ItemsSource="{dxe:EnumItemsSource EnumType={x:Type local:FileAttachmentType}}"
                                          EditValue="{x:Static local:FileAttachmentType.Images}"
                                          IsTextEditable="False"
                                          EditValueChanged="OnSelectedFileTypeChanged" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem>
                        <dxe:CheckEdit Content="Use Streaming"
                                       IsChecked="{Binding ElementName=aiChatControl, Path=UseStreaming, Mode=TwoWay}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
        </ScrollViewer>
        <dxaichat:AIChatControl x:Name="aiChatControl"
                                FileUploadEnabled="True"
                                UseStreaming="True"
                                ShowHeader="True"
                                HeaderText="AI Assistant"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Initialized="OnAIChatControlInitialized" />
    </DockPanel>
</dxdb:DemoModule>