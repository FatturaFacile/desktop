<dxdb:DemoModule x:Class="AIDemo.PdfViewerModule"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
            xmlns:dxpdf="http://schemas.devexpress.com/winfx/2008/xaml/pdf"
            xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
            xmlns:dxai="http://schemas.devexpress.com/winfx/2008/xaml/ai">
    <dxpdf:PdfViewerControl x:Name="pdfViewerControl">
        <dxmvvm:Interaction.Behaviors>
            <dxai:DocumentSummarizeBehavior/>
            <dxai:DocumentTranslateBehavior>
                <dxai:LanguageInfo Culture="en-US"/>
                <dxai:LanguageInfo Culture="de-DE"/>
                <dxai:LanguageInfo Culture="fr-FR"/>
            </dxai:DocumentTranslateBehavior>
            <dxai:CustomRequestBehavior/>
        </dxmvvm:Interaction.Behaviors>
    </dxpdf:PdfViewerControl>
</dxdb:DemoModule>