<dxdb:DemoModule x:Class="AIDemo.SmartAutoCompleteModule"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:dxai="http://schemas.devexpress.com/winfx/2008/xaml/ai"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                 xmlns:aiDemo="clr-namespace:AIDemo"
                 mc:Ignorable="d"
                 d:DesignHeight="500" d:DesignWidth="600">
    <DockPanel LastChildFill="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Name="PART_Options"
                      DockPanel.Dock="Right"
                      dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                      Focusable="False">
            <StackPanel Margin="12,0,12,12" Width="210">
                <dxlc:LayoutControl>
                    <dxlc:LayoutGroup ItemSpace="8" Margin="0,5" Orientation="Vertical">
                        <dxlc:LayoutItem Label="User role" LabelPosition="Top">
                            <dxe:ComboBoxEdit x:Name="userRoleComboBox" IsTextEditable="False" DisplayMember="DisplayText"
                                              SelectedIndex="0">
                                <aiDemo:UserRoleItem DisplayText="Technical support agent"
                                                     UserRole="Technical support service agent responding to a customer's question" />
                                <aiDemo:UserRoleItem DisplayText="Sales manager"
                                                     UserRole="Sales manager responding to a client's request for a product quote" />
                                <aiDemo:UserRoleItem DisplayText="Customer Success Manager"
                                                     UserRole="Customer Success Manager onboarding a new client" />
                                <aiDemo:UserRoleItem DisplayText="Product Manager"
                                                     UserRole="Product Manager announcing new feature updates to existing users" />
                                <aiDemo:UserRoleItem DisplayText="Marketing Specialist"
                                                     UserRole="Marketing Specialist drafting a promotional email for a limited-time offer" />
                            </dxe:ComboBoxEdit>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <TextBlock x:Name="userRoleTextBlock" TextWrapping="Wrap" Opacity="0.5"
                           Text="{Binding ElementName=userRoleComboBox, Path=SelectedItem.UserRole}" />
                <TextBox x:Name="textBox" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <dx:ThemedBorder Background="{Binding ElementName=textBox, Path=Background}">
            <dxe:TextEdit DockPanel.Dock="Left" VerticalScrollBarVisibility="Auto"
                          NullText="Begin typing to display AI-powered suggestions."
                          VerticalContentAlignment="Top"
                          TextWrapping="Wrap"
                          AcceptsReturn="True"
                          ShowBorder="False">
                <dxmvvm:Interaction.Behaviors>
                    <dxai:SmartAutoCompleteBehavior UserRole="{Binding ElementName=userRoleTextBlock, Path=Text}" />
                </dxmvvm:Interaction.Behaviors>
            </dxe:TextEdit>
        </dx:ThemedBorder>
    </DockPanel>
</dxdb:DemoModule>