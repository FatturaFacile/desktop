<dxdb:DemoModule x:Class="AIDemo.ReportDesignerModule"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxdai="http://schemas.devexpress.com/winfx/2008/xaml/dataaccess/internal">

    <DockPanel HorizontalAlignment="Center"
               VerticalAlignment="Center"
               LastChildFill="True"
               Margin="32">

        <TextBlock Text="AI-powered Report Designer"
                   DockPanel.Dock="Top"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold" />

        <dx:SimpleButton Content="Run Designer"
                         DockPanel.Dock="Bottom"
                         Click="ButtonBase_OnClick"
                         HorizontalAlignment="Center" />

        <ListBox ItemsSource="{Binding Module.FeatureItems}"
                 Margin="16"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 SelectionMode="Single">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <dxdai:AlignWrapPanel Orientation="Horizontal" HorizontalContentAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="16">
                        <StackPanel MaxWidth="250">
                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" />
                            <dx:DXImage Source="{Binding ThumbImage}"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Margin="0,16,0,24" />
                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center" />
                            <dxe:HyperlinkEdit Text="Learn More"
                                               AllowAutoNavigate="True"
                                               NavigationUrl="{Binding Link}"
                                               HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </DockPanel>

</dxdb:DemoModule>