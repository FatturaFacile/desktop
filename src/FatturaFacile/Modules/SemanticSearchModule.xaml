<dxdb:DemoModule x:Class="AIDemo.SemanticSearchModule"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:dxai="http://schemas.devexpress.com/winfx/2008/xaml/ai">
    <DockPanel LastChildFill="True">
        <ScrollViewer Name="PART_Options" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      DockPanel.Dock="Right" dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" Focusable="False">
            <StackPanel Margin="12,0,12,12" Width="250">
                <DockPanel Margin="0 5" LastChildFill="False" >
                    <TextBlock Text="Grid Search Behavior" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <RadioButton Content="Search" GroupName="GridSearchBehavior" DockPanel.Dock="Right"
                                 VerticalAlignment="Center"/>
                    <RadioButton Content="Filter" GroupName="GridSearchBehavior" VerticalAlignment="Center"
                                 IsChecked="{Binding ElementName=gridControl, Path=View.SearchPanelAllowFilter}"
                                 DockPanel.Dock="Right" Margin="10 5" />
                </DockPanel>
                <TextBlock Margin="0 5" Text="Similarity Threshold:"/>
                <dxe:TrackBarEdit x:Name="scoreThresholdTrackBarEdit"
                                  Minimum="0" Maximum="1" Value="0.75" SmallStep="0.1"
                                  TickItemDisplayMode="TickAndText" TickPlacement="BottomRight" TickFrequency="0.25" />
            </StackPanel>
        </ScrollViewer>
        <dxg:GridControl x:Name="gridControl" ShowBorder="False">
            <dxg:GridControl.View>
                <dxg:TableView ShowColumnHeaders="False" ShowBandsPanel="False" AutoWidth="True"
                               SearchPanelPosition="OverGroupPanel" ShowSearchPanelMode="Always"
                               ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                               ShowGroupPanel="False" SearchPanelNullText="Enter text to search..."
                               ShowSearchPanelNavigationButtons="True" ShowSearchPanelResultInfo="True" />
            </dxg:GridControl.View>
            <dxmvvm:Interaction.Behaviors>
                <dxai:SemanticSearchBehavior ScoreThreshold="{Binding ElementName=scoreThresholdTrackBarEdit, Path=EditValue}"
                                             VectorCollectionName="Movies"
                                             DataSourceKeyField="Id"
                                             ScoreThresholdFilter="LessOrEqual"
                                             SearchResultCount="20"
                                             SearchMode="Semantic"
                                             AllowChangeSearchMode="True" />
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.Bands>
                <dxg:GridControlBand>
                    <dxg:GridColumn AllowEditing="False" FixedWidth="True">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxg:RowControl}}, Path=BorderBrush}">
                                    <Image Source="{Binding Row.Photo}" MaxWidth="75" />
                                </Border>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
                <dxg:GridControlBand>
                    <dxg:GridColumn FieldName="Title" AllowEditing="False" dxg:BandBase.GridRow="0" AllowFocus="False" FixedWidth="True" Width="200">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit Name="PART_Editor" FontWeight="Bold" Height="28" Margin="0,0,0,8" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Directors" AllowEditing="False" dxg:BandBase.GridRow="1" AllowFocus="False">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit Name="PART_Editor" Height="28" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Release" AllowEditing="False" dxg:BandBase.GridRow="2" AllowFocus="False">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxg:RowControl}}, Path=BorderBrush}">
                                    <dxe:TextEdit Name="PART_Editor" Height="28" />
                                </Border>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
                <dxg:GridControlBand>
                    <dxg:GridColumn FieldName="Genre" AllowEditing="False" AllowFocus="False" >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit Name="PART_Editor" Height="28" VerticalAlignment="Center" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Plot" AllowEditing="False" dxg:BandBase.GridRow="1" AllowFocus="False">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" Margin="0,0,-5,0"
                                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxg:RowControl}}, Path=BorderBrush}">
                                    <dxe:TextEdit Name="PART_Editor" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControlBand>
            </dxg:GridControl.Bands>
        </dxg:GridControl>
    </DockPanel>
</dxdb:DemoModule>