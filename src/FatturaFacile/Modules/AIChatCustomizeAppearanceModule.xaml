<dxdb:DemoModule x:Class="AIDemo.AIChatCustomizeAppearanceModule"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                 xmlns:dxaichat="http://schemas.devexpress.com/winfx/2008/xaml/aichat"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel LastChildFill="True">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      x:Name="PART_Options"
                      DockPanel.Dock="Right"
                      dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                      Focusable="False">
            <dxlc:LayoutControl Width="210">
                <dxlc:LayoutGroup ItemSpace="8" Orientation="Vertical">
                    <dxlc:LayoutItem>
                        <dxe:CheckEdit Content="Show Header"
                                       IsChecked="{Binding ElementName=aiChatControl, Path=ShowHeader, Mode=TwoWay}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem>
                        <dxe:CheckEdit Content="Allow Resize Input"
                                       IsChecked="{Binding ElementName=aiChatControl, Path=AllowResizeInput, Mode=TwoWay}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem>
                        <dxe:CheckEdit x:Name="customMessageAppearanceCheckEdit"
                                       Content="Custom Message Appearance"
                                       IsChecked="True"
                                       EditValueChanged="OnCustomMessageAppearanceChanged" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem>
                        <dxe:CheckEdit x:Name="richFormattedResponsesCheckEdit"
                                       Content="Rich Formatted Responses"
                                       IsChecked="True"
                                       EditValueChanged="OnRichFormattedResponsesChanged" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem>
                        <dxe:CheckEdit Content="Use Streaming"
                                       IsChecked="{Binding ElementName=aiChatControl, Path=UseStreaming, Mode=TwoWay}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="State Placeholder Text" LabelPosition="Top">
                        <dxe:TextEdit EditValue="{Binding ElementName=aiChatControl, Path=EmptyStateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Label="Input Placeholder Text" LabelPosition="Top">
                        <dxe:TextEdit EditValue="{Binding ElementName=aiChatControl, Path=InputBoxNullText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
        </ScrollViewer>
        <dxaichat:AIChatControl x:Name="aiChatControl"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                UseStreaming="True"
                                ShowHeader="True"
                                EmptyStateText="AI assistant is ready"
                                InputBoxNullText="Enter your question..."
                                HeaderText="AI Assistant"
                                ContentFormat="Markdown" />
    </DockPanel>
</dxdb:DemoModule>