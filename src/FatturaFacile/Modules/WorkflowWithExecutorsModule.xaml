<local:AgentModuleBase x:Class="AIDemo.WorkflowWithExecutorsModule"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:dxaichat="http://schemas.devexpress.com/winfx/2008/xaml/aichat"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:local="clr-namespace:AIDemo"
                       mc:Ignorable="d"
                       d:DesignHeight="450"
                       d:DesignWidth="800">
    <DockPanel>
        <dxaichat:AIChatControl x:Name="aiChatControl"
                                ShowHeader="True"
                                UseStreaming="True"
                                IncludeFunctionCallInfo="True"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                HeaderText="AI Assistant" />
    </DockPanel>
</local:AgentModuleBase>