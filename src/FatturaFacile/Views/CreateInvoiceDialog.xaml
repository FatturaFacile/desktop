<Window x:Class="FatturaFacile.Wpf.Views.CreateInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:FatturaFacile.Wpf.Localization"
        xmlns:conv="clr-namespace:FatturaFacile.Wpf.Converters"
        mc:Ignorable="d"
        Title="{loc:Translate Common_NewInvoice}" 
        Height="680" Width="850" 
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Translate Common_NewInvoice}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Calcolo imposte e arrotondamento svizzero a 5 centesimi (CHF 0.05)" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <!-- Form Top: Customer, Date, Currency -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Customer Dropdown -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Translate Invoice_Customer}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="DisplayName" Height="36" Padding="6,4"/>
                </StackPanel>

                <!-- Invoice Date -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Translate Common_Date}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding Date}" Height="36"/>
                </StackPanel>

                <!-- Due Date -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Translate Common_DueDate}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding DueDate}" Height="36"/>
                </StackPanel>

                <!-- Currency -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="{loc:Translate Common_Currency}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox SelectedValue="{Binding Currency, Mode=TwoWay}" SelectedValuePath="Content" Height="36" Width="80">
                        <ComboBoxItem Content="CHF" IsSelected="True"/>
                        <ComboBoxItem Content="EUR"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Line Items Editor -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Descrizione" FontWeight="SemiBold" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" Text="Quantità" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="Prezzo Unit." FontWeight="SemiBold" FontSize="11" Foreground="#64748B" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Aliquota %" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Sconto %" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="Totale Riga" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text=" " Width="30"/>
                </Grid>

                <!-- Items List -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" Padding="6,4"/>
                                <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" Padding="6,4" TextAlignment="Right"/>
                                <TextBox Grid.Column="2" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" Padding="6,4" TextAlignment="Right"/>
                                <TextBox Grid.Column="3" Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" Padding="6,4" TextAlignment="Right"/>
                                <TextBox Grid.Column="4" Text="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" Padding="6,4" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat=N2}" Margin="2,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>

                                <Button Grid.Column="6" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" 
                                        Content="✕" Width="28" Height="28" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Line Button -->
                <Button Grid.Row="2" Command="{Binding AddItemCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Background="#F1F5F9" BorderThickness="0" Foreground="#0288D1" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    <TextBlock Text="+ Aggiungi Riga"/>
                </Button>
            </Grid>
        </Border>

        <!-- Totals Summary & Rounding Display -->
        <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Note Documento:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,4,16,0" Padding="6" Background="White" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" MinWidth="260">
                    <Grid Margin="0,2">
                        <TextBlock Text="{loc:Translate Invoice_Net}" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalNet, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="{loc:Translate Invoice_Tax}" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalTax, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="{loc:Translate Invoice_Rounding}" Foreground="#0288D1" FontSize="11"/>
                        <TextBlock Text="{Binding RoundingAmount, StringFormat=N2}" HorizontalAlignment="Right" Foreground="#0288D1" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                    <Separator Margin="0,6"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="{loc:Translate Invoice_Gross}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Currency}" FontWeight="Bold" FontSize="15" Foreground="#0288D1" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding TotalGross, StringFormat=N2}" FontWeight="Bold" FontSize="15" Foreground="#0288D1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="CancelButton_Click" Height="40" Padding="16,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                <TextBlock Text="{loc:Translate Common_Cancel}"/>
            </Button>
            <Button Command="{Binding SaveInvoiceCommand}" Height="40" Padding="20,0" Background="#0288D1" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                <TextBlock Text="{loc:Translate Common_Save}"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
