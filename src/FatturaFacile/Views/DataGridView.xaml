<UserControl x:Class="FatturaFacile.Views.DataGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:DataGridViewModel}}">
    <mvvm:Interaction.Behaviors>
        <mvvm:EventToCommand EventName="Loaded"
                             Command="{Binding InitCommand}"
                             DispatcherPriority="Loaded"/>
    </mvvm:Interaction.Behaviors>
    <DockPanel>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           DockPanel.Dock="Top">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Command="{Binding ElementName=tableView, Path=Commands.ShowPrintPreviewDialog}"
                                       Style="{StaticResource printRibbonButton}"/>
                    <dxb:BarButtonItem Command="{Binding ElementName=tableView, Path=Commands.DeleteFocusedRow}"
                                       Style="{StaticResource deleteRibbonButton}"/>
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>
        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,0,6">
            <dxg:GridControl ItemsSource="{Binding Customers}"
                             ShowBorder="False">
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem FieldName="Id"
                                         SummaryType="Count"
                                         Alignment="Right"/>
                </dxg:GridControl.TotalSummary>
                <dxg:GridColumn FieldName="Id"
                                Width="50">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric"
                                              Mask="d"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="FirstName"/>
                <dxg:GridColumn FieldName="LastName"/>
                <dxg:GridColumn FieldName="Country"/>
                <dxg:GridColumn FieldName="City"/>
                <dxg:GridColumn FieldName="Address"
                                Width="200"/>
                <dxg:GridColumn FieldName="Phone"
                                Width="150"/>
                <dxg:GridColumn FieldName="PostalCode"/>
                <dxg:GridControl.View>
                    <dxg:TableView NewItemRowPosition="Top"
                                   Name="tableView"
                                   ShowVerticalLines="True"
                                   ShowFixedTotalSummary="True"
                                   AllowHeaderNavigation="True"
                                   ScrollBarAnnotationMode="SearchResult"
                                   SearchPanelAllowFilter="False"
                                   ShowSearchPanelNavigationButtons="True"/>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Border>
    </DockPanel>
</UserControl>
