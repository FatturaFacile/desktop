<Window x:Class="FatturaFacile.Wpf.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:FatturaFacile.Wpf.Localization"
        xmlns:conv="clr-namespace:FatturaFacile.Wpf.Converters"
        xmlns:vm="clr-namespace:FatturaFacile.Wpf.ViewModels"
        xmlns:views="clr-namespace:FatturaFacile.Wpf.Views"
        mc:Ignorable="d"
        Title="{loc:Translate App_Title}" 
        Height="800" Width="1240" 
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- MVVM DataTemplates for View Switching -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoicesListViewModel}">
            <views:InvoicesListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupSettingsViewModel}">
            <views:BackupSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!-- Navigation Button Style -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Collapsible Navigation Sidebar -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid Width="{Binding IsNavExpanded, Converter={x:Static conv:ConvertersHelper.NotNullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand & Toggle -->
                <Grid Grid.Row="0" Margin="16,20,16,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#0288D1" Margin="0,0,12,0">
                            <TextBlock Text="FF" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fattura Facile" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Offline Client" FontSize="10" Foreground="#0288D1"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ToggleNavCommand}" Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" Padding="4">
                        <TextBlock Text="◀" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Nav Menu Items -->
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,14,0"/>
                            <TextBlock Text="{loc:Translate Nav_Dashboard}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateInvoicesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="16" Margin="0,0,14,0"/>
                            <TextBlock Text="{loc:Translate Nav_Invoices}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateCustomersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="16" Margin="0,0,14,0"/>
                            <TextBlock Text="{loc:Translate Nav_Customers}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateProductsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="16" Margin="0,0,14,0"/>
                            <TextBlock Text="{loc:Translate Nav_Products}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateBackupsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" Margin="0,0,14,0"/>
                            <TextBlock Text="{loc:Translate Nav_Backups}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,14,0"/>
                            <TextBlock Text="{loc:Translate Nav_Settings}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Tenant Badge in Sidebar Footer -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="12,12,12,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#0288D1" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentTenant.Initials}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTenant.Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentTenant.DefaultCurrency, StringFormat=Valuta: {0}}" FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <!-- Top Toolbar -->
                <RowDefinition Height="56"/>
                <!-- View Content Host -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Shell Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Tenant Pill & Switcher -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="20" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢 " FontSize="12"/>
                                <TextBlock Text="{Binding CurrentTenant.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <Border Background="#0288D1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CurrentTenant.DefaultCurrency}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding SwitchTenantCommand}" Height="32" Padding="10,0" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <TextBlock Text="{loc:Translate Common_SwitchTenant}"/>
                        </Button>
                    </StackPanel>

                    <!-- Right Quick Utilities: Language Selector & Theme Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Language flags -->
                        <Button Command="{Binding SetLanguageCommand}" CommandParameter="it-CH" ToolTip="Italiano" Content="🇮🇹" Background="Transparent" BorderThickness="0" FontSize="15" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Command="{Binding SetLanguageCommand}" CommandParameter="de-CH" ToolTip="Deutsch" Content="🇩🇪" Background="Transparent" BorderThickness="0" FontSize="15" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Command="{Binding SetLanguageCommand}" CommandParameter="fr-CH" ToolTip="Français" Content="🇫🇷" Background="Transparent" BorderThickness="0" FontSize="15" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Command="{Binding SetLanguageCommand}" CommandParameter="en-US" ToolTip="English" Content="🇬🇧" Background="Transparent" BorderThickness="0" FontSize="15" Margin="0,0,12,0" Cursor="Hand"/>

                        <!-- Theme Toggle Button -->
                        <Button Command="{Binding ToggleThemeCommand}" ToolTip="Cambia Tema Chiaro / Scuro" Height="34" Width="34" Background="#F1F5F9" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                            <TextBlock Text="🌓" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content Presenter -->
            <ContentPresenter Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
