<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             x:Class="FatturaFacile.Views.RichEditView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:RichEditViewModel}}">
    <mvvm:Interaction.Behaviors>
        <mvvm:EventToCommand EventName="Loaded"
                             Command="{Binding InitCommand}"
                             DispatcherPriority="Loaded"/>
        <mvvm:EventToCommand EventName="DocumentLoaded"
                             SourceName="richEdit"
                             Command="{Binding HideSplashScreenCommand}"
                             DispatcherPriority="Loaded"/>
        <dx:SplashScreenManagerService Owner="{Binding ElementName=spreadSheet}"
                                       PredefinedSplashScreenType="WaitIndicator"
                                       x:Name="splashScreenService"/>
    </mvvm:Interaction.Behaviors>
    <Grid>

        <dxre:RichEditControl CommandBarStyle="Ribbon"
                              DocumentSource="{Binding DocumentPath}"
                              Name="richEdit"/>

    </Grid>
</UserControl>
