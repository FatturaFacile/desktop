<UserControl x:Class="FatturaFacile.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:FatturaFacile.Markup"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header Section -->
            <TextBlock Text="{loc:Translate Dashboard.Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Executive Cross-Border Dashboard (Italia &amp; Svizzera)"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,24" />

            <!-- KPI Tiles Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,24">
                <!-- EUR Revenue Card -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dashboard.RevenueEur}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KpiSummary.TotalRevenueEur, StringFormat='{}{0:N2} EUR'}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="Fatture elettroniche emesse SDI" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- CHF Revenue Card -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dashboard.RevenueChf}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KpiSummary.TotalRevenueChf, StringFormat='{}{0:N2} CHF'}"
                                   Foreground="{DynamicResource SwissAccentBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="Swiss QR-Bills (Arrotondamento 0.05 CHF)"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Pending Receivables Card -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dashboard.PendingReceivables}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KpiSummary.PendingReceivablesEur, StringFormat='{}{0:N2} EUR'}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="Scadenze incasso a 30/60 giorni" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Second Row KPIs -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- VAT Liability -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dashboard.VatLiability}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KpiSummary.PendingVatLiabilityEur, StringFormat='{}{0:N2} EUR'}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="22" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="IVA a debito calcolata per liquidazione periodica"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Tax Deadline -->
                <Border Style="{DynamicResource CardBorderStyle}" Margin="6" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dashboard.NextTaxDeadline}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KpiSummary.NextTaxDeadline, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="22" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock Text="F24 telematico Italia / Rendiconto IVA AFC Berna"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Operational Activity Counters -->
            <Border Style="{DynamicResource CardBorderStyle}" Margin="6">
                <StackPanel>
                    <TextBlock Text="Attività Operative in Corso" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding KpiSummary.ActiveClientsCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Clienti Attivi Transfrontalieri" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding KpiSummary.PendingInvoicesCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="Fatture in Attesa SDI" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding KpiSummary.StoredTireSetsCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="Treni Gomme a Magazzino" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
