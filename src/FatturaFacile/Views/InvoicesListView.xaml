<UserControl x:Class="FatturaFacile.Wpf.Views.InvoicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
             xmlns:loc="clr-namespace:FatturaFacile.Wpf.Localization"
             xmlns:conv="clr-namespace:FatturaFacile.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Translate Nav_Invoices}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Gestione emissione, ciclo attivo e arrotondamento svizzero CHF 0.05" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadInvoicesCommand}" Height="38" Padding="14,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    <TextBlock Text="{loc:Translate Common_Refresh}"/>
                </Button>

                <Button Command="{Binding OpenNewInvoiceDialogCommand}" Height="38" Padding="18,0" Background="#0288D1" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    <TextBlock Text="{loc:Translate Common_NewInvoice}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- KPI Mini Cards & Search -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,4" MaxWidth="400" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" Margin="4,4,8,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" Background="Transparent" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- KPI Totals Summary Pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E0F2FE" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Totale Lordo: " FontSize="12" Foreground="#0369A1"/>
                        <TextBlock Text="{Binding Currency}" FontSize="12" FontWeight="Bold" Foreground="#0288D1" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalGrossSum, StringFormat=N2}" FontSize="13" FontWeight="Bold" Foreground="#0288D1"/>
                    </StackPanel>
                </Border>

                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Documenti: " FontSize="12" Foreground="#475569"/>
                        <TextBlock Text="{Binding InvoicesCount}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Syncfusion SfDataGrid Table -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <syncfusion:SfDataGrid ItemsSource="{Binding Invoices}" 
                                   SelectedItem="{Binding SelectedInvoice}"
                                   AutoGenerateColumns="False" 
                                   AllowSorting="True" 
                                   AllowFiltering="True"
                                   ColumnSizer="Star"
                                   SelectionMode="Single"
                                   NavigationMode="Row"
                                   RowHeight="44"
                                   HeaderRowHeight="42"
                                   BorderThickness="0">

                <syncfusion:SfDataGrid.Columns>
                    <!-- Number -->
                    <syncfusion:GridTextColumn MappingName="InvoiceNumber" 
                                               HeaderText="{loc:Translate Invoice_Number}" 
                                               Width="150"/>

                    <!-- Customer -->
                    <syncfusion:GridTextColumn MappingName="CustomerName" 
                                               HeaderText="{loc:Translate Invoice_Customer}" 
                                               Width="240"/>

                    <!-- Date -->
                    <syncfusion:GridTextColumn MappingName="FormattedDate" 
                                               HeaderText="{loc:Translate Common_Date}" 
                                               Width="110" 
                                               TextAlignment="Center"/>

                    <!-- Due Date -->
                    <syncfusion:GridTextColumn MappingName="FormattedDueDate" 
                                               HeaderText="{loc:Translate Common_DueDate}" 
                                               Width="110" 
                                               TextAlignment="Center"/>

                    <!-- Net Subtotal -->
                    <syncfusion:GridTextColumn MappingName="FormattedTotalNet" 
                                               HeaderText="{loc:Translate Invoice_Net}" 
                                               Width="130" 
                                               TextAlignment="Right"/>

                    <!-- Tax / VAT -->
                    <syncfusion:GridTextColumn MappingName="FormattedTotalTax" 
                                               HeaderText="{loc:Translate Invoice_Tax}" 
                                               Width="120" 
                                               TextAlignment="Right"/>

                    <!-- Gross Total -->
                    <syncfusion:GridTextColumn MappingName="FormattedTotalGross" 
                                               HeaderText="{loc:Translate Invoice_Gross}" 
                                               Width="140" 
                                               TextAlignment="Right"/>

                    <!-- Status Badge -->
                    <syncfusion:GridTemplateColumn HeaderText="{loc:Translate Common_Status}" Width="130">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrush}}" 
                                        CornerRadius="6" 
                                        Padding="8,3" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PaymentStatus}" 
                                               Foreground="{Binding StatusBadgeColor, Converter={StaticResource HexToBrush}}" 
                                               FontWeight="SemiBold" 
                                               FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Border>
    </Grid>
</UserControl>
