<UserControl x:Class="FatturaFacile.Views.TreeListBasicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:local="clr-namespace:FatturaFacile.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:TreeListBasicViewModel}}">
    <mvvm:Interaction.Behaviors>
        <mvvm:EventToCommand EventName="Loaded"
                             Command="{Binding InitCommand}"
                             DispatcherPriority="Loaded"/>
    </mvvm:Interaction.Behaviors>
    <DockPanel>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           DockPanel.Dock="Top">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Command="{Binding ElementName=treeListView, Path=Commands.ShowPrintPreviewDialog}"
                                       Style="{StaticResource printRibbonButton}"/>
                    <dxb:BarButtonItem Command="{Binding ElementName=treeListView, Path=Commands.DeleteFocusedRow}"
                                       Style="{StaticResource deleteRibbonButton}"/>
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>
        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,0,6">
            <dxg:TreeListControl ItemsSource="{Binding Employees}"
                                 ShowBorder="False">
                <dxg:TreeListControl.TotalSummary>
                    <dxg:TreeListSummaryItem FieldName="Id"
                                             SummaryType="Count"
                                             Alignment="Right"/>
                </dxg:TreeListControl.TotalSummary>
                <dxg:TreeListColumn FieldName="FirstName" />
                <dxg:TreeListColumn FieldName="LastName"/>
                <dxg:TreeListColumn FieldName="JobTitle"  Width="170"/>
                <dxg:TreeListColumn FieldName="GroupName" Width="230"/>
                <dxg:TreeListColumn FieldName="Email" Width="180"/>
                <dxg:TreeListColumn FieldName="Phone"/>
                <dxg:TreeListControl.View>
                    <dxg:TreeListView Name="treeListView"
                                      KeyFieldName="Id"
                                      AutoExpandAllNodes="True"
                                      ParentFieldName="ParentId"
                                      NewItemRowPosition="Top"
                                      ShowVerticalLines="True"
                                      ShowFixedTotalSummary="True"
                                      AllowHeaderNavigation="True"/>
                </dxg:TreeListControl.View>
            </dxg:TreeListControl>
        </Border>
    </DockPanel>
</UserControl>
