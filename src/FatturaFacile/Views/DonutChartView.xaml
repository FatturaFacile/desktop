<UserControl x:Class="FatturaFacile.Views.DonutChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:local="clr-namespace:FatturaFacile.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:DonutChartViewModel}}">
    <UserControl.Resources>
        <DataTemplate x:Key="labelTemplate">
            <StackPanel>
                <TextBlock Text="{Binding SeriesPoint.ActualArgument}"
                           FontSize="14"
                           Style="{StaticResource mutedSurfaceText}"/>
                <TextBlock Text="{Binding Text}"
                           FontSize="28"
                           Style="{StaticResource secondarySurfaceText}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="totalLabelTemplate">
            <Grid>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Left"
                               Text="TOTAL"
                               FontSize="14"/>
                    <TextBlock HorizontalAlignment="Center"
                               Text="{Binding}"
                               FontSize="28"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*"
                              MaxWidth="400" />
        </Grid.ColumnDefinitions>

        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           Grid.ColumnSpan="2">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Style="{StaticResource exportToJpegButton}"
                                       Command="{Binding ElementName=chartControl, Path=Commands.ExportToJpegCommand}" />
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>
        <!--Chart Panel-->
        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,8,6"
                Grid.Row="1">
            <dxc:ChartControl Name="chartControl"
                              DataSource="{Binding ChartData}"
                              SelectionMode="Single"
                              SelectedItem="{Binding SelectedSegment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AnimationMode="OnLoad"
                              BorderThickness="0"
                              Margin="6"
                              Background="{x:Null}">
                <dxc:SimpleDiagram2D>
                    <dxc:PieSeries2D x:Name="series"
                                     DisplayName="Sales"
                                     ArgumentDataMember="Argument"
                                     ValueDataMember="Value"
                                     LabelsVisibility="True"
                                     HoleRadiusPercent="55">
                        <dxc:PieSeries2D.TotalLabel>
                            <!--TV stands for Total Value, C0 is a currenty format-->
                            <dxc:PieTotalLabel TextPattern="{}{TV:C0}"
                                               FontSize="25"
                                               ContentTemplate="{StaticResource totalLabelTemplate}"/>
                        </dxc:PieSeries2D.TotalLabel>
                        <!--VP stands for Values as Percentages, P0 is a percentage format-->
                        <dxc:PieSeries2D.Label>
                            <dxc:SeriesLabel TextPattern="{}{VP:P0}"
                                             dxc:PieSeries.LabelPosition="Outside"
                                             ConnectorVisible="false"
                                             ElementTemplate="{StaticResource labelTemplate}">
                            </dxc:SeriesLabel>
                        </dxc:PieSeries2D.Label>
                        <dxc:PieSeries2D.SeriesAnimation>
                            <dxc:Pie2DZoomInAnimation/>
                        </dxc:PieSeries2D.SeriesAnimation>
                    </dxc:PieSeries2D>
                </dxc:SimpleDiagram2D>
                <dxc:ChartControl.Titles>
                    <dxc:Title Content="Sales by Country"
                               HorizontalAlignment="Center"
                               FontSize="24"
                               Margin="0,0,0,20"/>
                </dxc:ChartControl.Titles>
            </dxc:ChartControl>
        </Border>
        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,0,6"
                VerticalAlignment="Top"
                Grid.Column="1"
                Grid.Row="1">
            <StackPanel>
                <TextBlock Text="{Binding SelectedSegment.Argument, StringFormat='Details ({0})', FallbackValue='Details (All)'}"
                           FontSize="24"
                           Margin="14,20,0,0"/>
                <TextBlock Text="Total Amount"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="14,20,0,0"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat=C0}"
                           FontSize="14"
                           Margin="14,10,0,20"/>
                <TextBlock Text="Number of Orders"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="14,20,0,0"/>
                <TextBlock Text="{Binding NumberOfOrders}"
                           FontSize="14"
                           Margin="14,10,0,20"/>
                <TextBlock Text="Best Selling Product"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="14,20,0,0"/>
                <TextBlock Text="{Binding BestSellingProduct}"
                           FontSize="14"
                           Margin="14,10,0,20"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
