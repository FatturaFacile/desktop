<UserControl x:Class="FatturaFacile.Views.GridSideDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:GridSideDetailViewModel}}" >
    <mvvm:Interaction.Behaviors>
        <mvvm:EventToCommand EventName="Loaded"
                             Command="{Binding InitCommand}"
                             DispatcherPriority="Loaded"/>
    </mvvm:Interaction.Behaviors>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"
                              MaxWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           Grid.ColumnSpan="2">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Command="{Binding ElementName=tableView, Path=Commands.ShowPrintPreviewDialog}"
                                       Style="{StaticResource printRibbonButton}"/>
                    <dxb:BarButtonItem Command="{Binding ElementName=tableView, Path=Commands.DeleteFocusedRow}"
                                       Style="{StaticResource deleteRibbonButton}"/>
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>

        <!--Main Data Grid-->

        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,8,6"
                Grid.Row="1">
            <dxg:GridControl ItemsSource="{Binding Customers}"
                             CurrentItem="{Binding SelectedCustomer}"
                             ShowBorder="False">
                <dxg:GridColumn FieldName="Id"
                                Width="50">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric"
                                              Mask="d"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="FirstName"/>
                <dxg:GridColumn FieldName="LastName"/>
                <dxg:GridColumn FieldName="Country"/>
                <dxg:GridColumn FieldName="City"/>
                <dxg:GridColumn FieldName="Address"/>
                <dxg:GridColumn FieldName="Phone"/>
                <dxg:GridColumn FieldName="PostalCode"/>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem FieldName="Id"
                                         SummaryType="Count"
                                         Alignment="Right"/>
                </dxg:GridControl.TotalSummary>
                <dxg:GridControl.View>
                    <dxg:TableView Name="tableView"
                                   AllowHeaderNavigation="True"
                                   ShowFixedTotalSummary="True"/>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Border>

        <!--Detail Panel-->
        <Grid Grid.Row="1"
              Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding SelectedCustomer.FullName}"
                       Margin="0,10,10,0"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Foreground="#FF1A1A1A"/>
            <Border CornerRadius="5"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Margin="0,10,0,0"
                    Grid.Row="1">
                <Image Source="{dx:DXImage 'SvgImages/Business Objects/BO_Employee.svg'}"/>
            </Border>
            <UniformGrid Grid.Row="2"
                         Margin="0,10,0,0"
                         Rows="1">
                <dx:SimpleButton Content="Send Email"
                                 Command="{Binding ActionCommand}"
                                 CommandParameter="{Binding SelectedCustomer.FullName}"
                                 Margin="0,0,5,0"/>
                <dx:SimpleButton Content="Assign"
                                 Command="{Binding ActionCommand}"
                                 CommandParameter="{Binding SelectedCustomer.FullName}"
                                 Margin="5,0,0,0"
                                 Style="{StaticResource accentButton}"/>
            </UniformGrid>
            <TextBlock Text="Orders"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0"
                       Grid.Row="3"/>
            <Border Style="{StaticResource roundPanelBorder}"
                    Margin="0,10,0,6"
                    Grid.Row="4">
                <dxg:GridControl ItemsSource="{Binding SelectedCustomer.Orders}"
                                 ShowBorder="False">
                    <dxg:GridColumn FieldName="OrderDate" Width="*"/>
                    <dxg:GridColumn FieldName="ItemsCount" Width="*"/>
                    <dxg:GridColumn FieldName="TotalAmount" Width="*">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings Mask="c"
                                              MaskType="Numeric"
                                              MaskUseAsDisplayFormat="True"/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridControl.View>
                        <dxg:TableView ShowGroupPanel="False"
                                       ShowIndicator="False"
                                       NavigationStyle="Row"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
