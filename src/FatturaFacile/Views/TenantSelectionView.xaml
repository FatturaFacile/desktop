<Window x:Class="FatturaFacile.Wpf.Views.TenantSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:FatturaFacile.Wpf.Localization"
        xmlns:conv="clr-namespace:FatturaFacile.Wpf.Converters"
        mc:Ignorable="d"
        Title="{loc:Translate Tenant_SelectTitle}" 
        Height="520" Width="500" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Translate Tenant_SelectTitle}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{loc:Translate Tenant_SelectSubtitle}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tenant Cards List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="16" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0288D1"/>
                                        <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Initials Badge -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#0288D1" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Tenant Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding TaxIdDisplay}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Currency & Country Pill -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding DefaultCurrency}" FontSize="12" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                            <TextBlock Text="{Binding Country}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Confirm Button -->
        <Button Grid.Row="2" Command="{Binding ConfirmSelectionCommand}" Height="44" Background="#0288D1" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Margin="0,16,0,0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
            <TextBlock Text="{loc:Translate Tenant_Confirm}"/>
        </Button>
    </Grid>
</Window>
