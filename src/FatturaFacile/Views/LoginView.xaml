<Window x:Class="FatturaFacile.Wpf.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:FatturaFacile.Wpf.Localization"
        xmlns:conv="clr-namespace:FatturaFacile.Wpf.Converters"
        mc:Ignorable="d"
        Title="{loc:Translate Login_Title}" 
        Height="540" Width="440" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="16" Background="#0288D1" Margin="0,0,0,12" HorizontalAlignment="Center">
                <TextBlock Text="FF" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{loc:Translate App_Title}" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Translate Login_Subtitle}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- Error Alert -->
        <Border Grid.Row="1" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                Visibility="{Binding ErrorMessage, Converter={x:Static conv:ConvertersHelper.NotNullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Credentials Form -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <!-- Username -->
            <TextBlock Text="{loc:Translate Login_Username}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,16">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="8,4" FontSize="14" Background="Transparent"/>
            </Border>

            <!-- Domain -->
            <TextBlock Text="{loc:Translate Login_Domain}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,16">
                <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="8,4" FontSize="14" Background="Transparent"/>
            </Border>

            <!-- Password -->
            <TextBlock Text="{loc:Translate Login_Password}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,24">
                <PasswordBox x:Name="PwdBox" PasswordChanged="PasswordBox_PasswordChanged" BorderThickness="0" Padding="8,4" FontSize="14" Background="Transparent"/>
            </Border>

            <!-- Login Button -->
            <Button Command="{Binding AuthenticateCommand}" Height="44" Background="#0288D1" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <Grid>
                    <TextBlock Text="{loc:Translate Login_Button}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                    <TextBlock Text="{Binding BusyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="#E0F2FE"/>
                </Grid>
            </Button>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="100% Standalone Offline Enterprise Client" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</Window>
