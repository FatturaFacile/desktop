<UserControl x:Class="FatturaFacile.Views.SchedulerCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxsch="http://schemas.devexpress.com/winfx/2008/xaml/scheduling"
             xmlns:dxscht="http://schemas.devexpress.com/winfx/2008/xaml/scheduling/themekeys"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:local="clr-namespace:FatturaFacile.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type=vm:SchedulerCalendarViewModel}">
    <mvvm:Interaction.Behaviors>
        <mvvm:EventToCommand EventName="Loaded"
                             Command="{Binding InitCommand}"
                             DispatcherPriority="Loaded" />
    </mvvm:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <!--Ribbon-->
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           dxsch:SchedulerControl.Scheduler="{Binding ElementName=scheduler}"
                           Grid.ColumnSpan="2">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Style="{DynamicResource {dxscht:SchedulerCommandBarThemeKey ResourceKey=Groups_Home_GroupBy}}">
                    <dxb:BarCheckItem Style="{DynamicResource {dxscht:SchedulerCommandBarThemeKey ResourceKey=Items_Home_GroupBy_GroupByNone}}" />
                    <dxb:BarCheckItem Style="{DynamicResource {dxscht:SchedulerCommandBarThemeKey ResourceKey=Items_Home_GroupBy_GroupByDate}}" />
                    <dxb:BarCheckItem Style="{DynamicResource {dxscht:SchedulerCommandBarThemeKey ResourceKey=Items_Home_GroupBy_GroupByResource}}" />
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>


        <!--Main Shceduling Area-->
        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,6,6"
                Grid.Row="1"
                Grid.RowSpan="2">
            <dxsch:SchedulerControl x:Name="scheduler"
                                    GroupType="None"
                                    FirstDayOfWeek="Monday"
                                    ActiveViewType="WeekView"
                                    SelectedInterval="{Binding SelectedInterval}"
                                    ShowBorder="False"
                                    Margin="6">
                <dxsch:SchedulerControl.DataSource>
                    <dxsch:DataSource ResourcesSource="{Binding Calendars}"
                                      AppointmentsSource="{Binding AppointmentsSource}">
                        <dxsch:DataSource.ResourceMappings>
                            <dxsch:ResourceMappings Caption="Name"
                                                    Id="Id"
                                                    Group="Group"
                                                    Visible="IsVisible" />
                        </dxsch:DataSource.ResourceMappings>
                        <dxsch:DataSource.AppointmentMappings>
                            <dxsch:AppointmentMappings Id="Id"
                                                       Start="StartTime"
                                                       End="EndTime"
                                                       Subject="Subject"
                                                       ResourceId="ResourceId"
                                                       LabelId="LabelId"
                                                       StatusId="StatusId"
                                                       RecurrenceInfo="RecurrenceInfo"
                                                       Description="Notes">
                            </dxsch:AppointmentMappings>
                        </dxsch:DataSource.AppointmentMappings>
                    </dxsch:DataSource>
                </dxsch:SchedulerControl.DataSource>
                <dxsch:SchedulerControl.DateNavigationPanelStyle>
                    <Style TargetType="dxsch:DateNavigationPanel">
                        <Setter Property="ShowViewSelector"
                                Value="True" />
                    </Style>
                </dxsch:SchedulerControl.DateNavigationPanelStyle>
            </dxsch:SchedulerControl>
        </Border>

        <!--Calendar Side Navigation Panel-->
        <dxe:DateNavigator x:Name="dateNavigator"
                           ShowTodayButton="False"
                           ShowWeekNumbers="False"
                           IsMultiSelect="True"
                           Grid.Row="1"
                           Grid.Column="1">
            <dxe:DateNavigator.StyleSettings>
                <dxsch:SchedulerDateNavigatorStyleSettings x:Name="dateNavigatorSettings"
                                                           Scheduler="{Binding ElementName=scheduler}" />
            </dxe:DateNavigator.StyleSettings>
        </dxe:DateNavigator>
        <dxsch:ResourceTreeControl Scheduler="{Binding ElementName=scheduler}"
                                   AutoExpandAllNodes="True"
                                   Margin="-1,0,-1,-1"
                                   Grid.Row="2"
                                   Grid.Column="1" />
    </Grid>
</UserControl>
