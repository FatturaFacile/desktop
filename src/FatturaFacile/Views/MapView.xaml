<UserControl x:Class="FatturaFacile.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:local="clr-namespace:FatturaFacile.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:MapViewModel}}">
    <UserControl.Resources>
        <XmlDataProvider x:Key="dataProvider"
                         Source="pack://application:,,,/Resources/EuropeEnergyStatictics.xml"
                         XPath="/NewDataSet"/>
    </UserControl.Resources>
    <DockPanel>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           DockPanel.Dock="Top">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Style="{StaticResource infoRibbonButton}" />
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>
        <dxm:MapControl Margin="0,20,0,0"
                        ZoomLevel="5">
            <dxm:MapControl.CenterPoint>
                <dxm:GeoPoint Latitude="50" Longitude="10"/>
            </dxm:MapControl.CenterPoint>
            <!--A layer to draw countries from Countries.shp-->
            <dxm:VectorLayer x:Name="mapLayer"
                             EnableHighlighting="False"
                             EnableSelection="False">
                <dxm:ShapefileDataAdapter FileUri="/Resources/Countries.shp"/>
            </dxm:VectorLayer>
            <!--A layer to draw pie charts from Resources/EuropeEnergyStatictics.xml-->
            <dxm:VectorLayer x:Name="pieChartLayer">
                <dxm:PieChartDataAdapter DataSource="{Binding Source={StaticResource dataProvider}, XPath=Countries}"
                                         ItemIdDataMember="Country"
                                         ItemMaxSize="25"
                                         x:Name="pieAdapter">
                    <dxm:PieChartDataAdapter.MeasureRules>
                        <dxm:MeasureRules RangeStops="1 10 25 50 100 150"/>
                    </dxm:PieChartDataAdapter.MeasureRules>
                    <dxm:PieChartDataAdapter.AttributeMappings>
                        <dxm:MapItemAttributeMapping Member="Country"
                                                     Name="Country"/>
                    </dxm:PieChartDataAdapter.AttributeMappings>
                    <dxm:PieChartDataAdapter.Mappings>
                        <dxm:MapPieMappingInfo Longitude="Longitude"
                                               Latitude="Latitude"
                                               SegmentId="EnergyType"
                                               SegmentValue="Production"/>
                    </dxm:PieChartDataAdapter.Mappings>
                </dxm:PieChartDataAdapter>
                <!--Colors in the pie chart-->
                <dxm:VectorLayer.Colorizer>
                    <dxm:KeyColorColorizer>
                        <dxm:KeyColorColorizer.ItemKeyProvider>
                            <dxm:IdItemKeyProvider/>
                        </dxm:KeyColorColorizer.ItemKeyProvider>
                        <dxm:KeyColorColorizer.Colors>
                            <Color>#005fba</Color>
                            <Color>#00b0ce</Color>
                            <Color>#E99876</Color>
                            <Color>#8163b6</Color>
                            <Color>#f9f871</Color>
                        </dxm:KeyColorColorizer.Colors>
                        <dxm:KeyColorColorizer.Keys>
                            <dxm:ColorizerKeyItem Key="Gases" Name="Gases"/>
                            <dxm:ColorizerKeyItem Key="Nuclear" Name="Nuclear"/>
                            <dxm:ColorizerKeyItem Key="Petroleum Products" Name="Petroleum Products"/>
                            <dxm:ColorizerKeyItem Key="Renewables" Name="Renewables"/>
                            <dxm:ColorizerKeyItem Key="Solid Fuels" Name="Solid Fuels"/>
                        </dxm:KeyColorColorizer.Keys>
                    </dxm:KeyColorColorizer>
                </dxm:VectorLayer.Colorizer>
            </dxm:VectorLayer>
            <dxm:MapControl.Legends>
                <dxm:ColorListLegend Header="Europ Energy Production"
                                     Layer="{Binding ElementName=pieChartLayer}"/>
            </dxm:MapControl.Legends>
        </dxm:MapControl>
    </DockPanel>
</UserControl>
