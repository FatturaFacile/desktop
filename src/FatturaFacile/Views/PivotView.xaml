<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:dxpg="http://schemas.devexpress.com/winfx/2008/xaml/pivotgrid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="FatturaFacile.Views.PivotView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:PivotViewModel}}">
    <mvvm:Interaction.Behaviors>
        <mvvm:EventToCommand EventName="Loaded"
                             Command="{Binding InitCommand}"
                             DispatcherPriority="Loaded"/>
    </mvvm:Interaction.Behaviors>
    <DockPanel>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True"
                           DockPanel.Dock="Top">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Command="{x:Static dxpg:PivotGridCommands.ShowPrintPreviewDialog}"
                                       CommandParameter="{Binding ElementName=pivotGrid}"
                                       Style="{StaticResource printRibbonButton}"/>
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>
        <dxpg:PivotGridControl x:Name="pivotGrid"
                               DataSource="{Binding Orders}"
                               DataProcessingEngine="Optimized"
                               UseAsyncMode="True"
                               ShowFilterHeaders="False"
                               RowTreeWidth="120">
            <dxpg:PivotGridControl.Fields>
                <dxpg:PivotGridField FieldName="Customer.Country"
                                     Caption="Country"
                                     Area="RowArea"/>
                <dxpg:PivotGridField FieldName="OrderDate"
                                     Caption="Order Month"
                                     GroupInterval="DateMonthYear"
                                     Area="ColumnArea"/>
                <dxpg:PivotGridField FieldName="TotalAmount"
                                     CellFormat="c0"
                                     Area="DataArea"/>
            </dxpg:PivotGridControl.Fields>
        </dxpg:PivotGridControl>
    </DockPanel>
</UserControl>
