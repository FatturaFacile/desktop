<UserControl x:Class="FatturaFacile.Views.KanbanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:v="clr-namespace:FatturaFacile.Views"
             xmlns:local="clr-namespace:FatturaFacile.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:KanbanViewModel}}">
    <UserControl.Resources>
        <Style TargetType="dx:SimpleButton" x:Key="cardButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="100"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{LWThemeValue Win11=Brush.Button.Background}"/>
                    <Setter Property="BorderBrush" Value="{LWThemeValue Win11=Brush.Button.CheckedBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{LWThemeValue Win11=Brush.Editor.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Style="{StaticResource infoRibbonButton}" />
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>
        <!--Kanban area-->
        <v:PanScrollViewer Focusable="False"
                           VerticalScrollBarVisibility="Disabled"
                           HorizontalScrollBarVisibility="Auto"
                           IgnoredElementName="groupKanbanBorder"
                           x:Name="scrollViewer"
                           Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Groups}"
                          Margin="8,0,0,0"
                          Background="{LWThemeValue Win11=Brush.Editor.Background}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <dx:DXVirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource roundPanelBorder}"
                                Margin="6,8"
                                VerticalAlignment="Top"
                                Background="{LWThemeValue Win11=Brush.PanelBackground}"
                                x:Name="groupKanbanBorder">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition  Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Caption}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="20,16,20,10"/>
                                <dxg:GridControl ItemsSource="{Binding Items}"
                                                 ShowBorder="False"
                                                 Width="270"
                                                 MinHeight="20"
                                                 Background="Transparent"
                                                 VerticalAlignment="Top"
                                                 dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                                                 Grid.Row="1">
                                    <dxg:GridControl.View>
                                        <dxg:TableView ShowIndicator="False"
                                                       AllowDragDrop="True"
                                                       ShowGroupPanel="False"
                                                       ShowColumnHeaders="False"
                                                       DragRecordOver="OnDragRecordOver"
                                                       ShowHorizontalLines="False"
                                                       FadeSelectionOnLostFocus="False"
                                                       VerticalScrollbarVisibility="Auto"
                                                       AllowLeaveFocusOnTab="True">
                                            <dxg:TableView.DragDropHintTemplate>
                                                <DataTemplate>
                                                    <dx:SimpleButton Content="{Binding Records[0].Caption}"
                                                                     Style="{StaticResource cardButton}"
                                                                     BorderThickness="1"
                                                                     BorderBrush="LightGray"
                                                                     Width="250"/>
                                                </DataTemplate>
                                            </dxg:TableView.DragDropHintTemplate>
                                            <dxg:TableView.RowStyle>
                                                <Style TargetType="dxg:RowControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </dxg:TableView.RowStyle>
                                            <dxg:TableView.DataRowTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <dx:SimpleButton Content="{Binding Row.Caption}"
                                                                         Style="{StaticResource cardButton}"
                                                                         Margin="6,3"
                                                                         Click="OnCardClick"/>
                                                        <dxe:CheckEdit IsChecked="{Binding Row.IsComplete}"
                                                                       VerticalAlignment="Top"
                                                                       HorizontalAlignment="Right"
                                                                       Margin="16,10"
                                                                       Visibility="Collapsed"
                                                                       Name="isCompleteCheck"/>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" TargetName="isCompleteCheck"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Row.IsComplete}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" TargetName="isCompleteCheck"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </dxg:TableView.DataRowTemplate>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                                <dx:SimpleButton Content="+  Add card"
                                                 Click="AddCardClick"
                                                 FontWeight="SemiBold"
                                                 FontSize="14"
                                                 Background="Transparent"
                                                 Foreground="{LWThemeValue Win11=Brush.Foreground.Secondary}"
                                                 HorizontalContentAlignment="Left"
                                                 BorderThickness="0"
                                                 Grid.Row="2"
                                                 Padding="7"
                                                 Margin="8,2,8,8"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </v:PanScrollViewer>
        <Border x:Name="fadeBorder"
                Visibility="Collapsed"
                Background="#60c9c9c9"
                PreviewMouseDown="OnFadePreviewMouseDown"
                Margin="0,0,20,0"
                Grid.Row="1"/>
        <!--Side panel-->
        <dx:DXExpander x:Name="expander"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       FlowDirection="LeftToRight"
                       VerticalExpand="None"
                       Duration="60"
                       HorizontalExpand="FromRightToLeft"
                       IsExpanded="False"
                       Grid.Row="1">
            <Border Width="700"
                    Style="{StaticResource roundPanelBorder}"
                    Background="{LWThemeValue Win11=Brush.Editor.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <dxe:CheckEdit VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   EditValue="{Binding IsComplete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <dxe:TextEdit EditValue="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="20"
                                  AcceptsReturn="True"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,0"
                                  BorderThickness="0"
                                  BorderBrush="Transparent"
                                  Grid.Column="1"/>
                    <dx:SimpleButton Content="Delete"
                                     Foreground="Red"
                                     Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Delete.svg'}"
                                     GlyphHeight="24"
                                     HorizontalAlignment="Right"
                                     BorderThickness="0"
                                     Margin="6"
                                     Click="OnDeleteButtonClick"
                                     Grid.Column="1"/>
                    <Image Source="{dx:DXImage 'SvgImages/DiagramIcons/TextAlignment/textAlignment1.svg'}"
                           Grid.Row="2"
                           VerticalAlignment="Top"
                           Width="24"
                           Height="24"
                           Margin="0,10"/>
                    <dxe:TextEdit EditValue="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="16"
                                  AcceptsReturn="True"
                                  VerticalContentAlignment="Top"
                                  Padding="0,6"
                                  BorderThickness="0"
                                  BorderBrush="Transparent"
                                  Grid.Row="2"
                                  Grid.Column="1"/>
                </Grid>
            </Border>
        </dx:DXExpander>
    </Grid>
</UserControl>
