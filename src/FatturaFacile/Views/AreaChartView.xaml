<UserControl x:Class="FatturaFacile.Views.AreaChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FatturaFacile.ViewModels"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxfui="http://schemas.devexpress.com/winfx/2008/xaml/core/filteringui"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
             xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
             xmlns:mvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:local="clr-namespace:FatturaFacile.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{mvvm:Ioc Type={x:Type vm:AreaChartViewModel}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition/>
        </Grid.RowDefinitions>
        <dxr:RibbonControl RibbonStyle="Office2019"
                           IsSimplified="True">
            <dxr:RibbonPage Caption="Home">
                <dxr:RibbonPageGroup Caption="Common">
                    <dxb:BarButtonItem Style="{StaticResource exportToJpegButton}"
                                       Command="{Binding ElementName=chartControl, Path=Commands.ExportToJpegCommand}" />
                </dxr:RibbonPageGroup>
            </dxr:RibbonPage>
        </dxr:RibbonControl>

        <!--Date Filter Panel-->
        <Border Style="{StaticResource roundPanelBorder}"
                HorizontalAlignment="Right"
                Margin="0,0,0,8"
                Grid.Row="1">
            <mvvm:Interaction.Behaviors>
                <dxfui:FilterBehavior x:Name="filterBehavior"
                                      ItemsSource="{Binding ElementName=chartControl, Path=DataSource}"/>
            </mvvm:Interaction.Behaviors>
            <dxfui:DateRangeFilterElement FieldName="OrderDate"
                                          HorizontalAlignment="Center"
                                          HorizontalContentAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="10"/>
        </Border>
        <!--Chart Panel-->
        <Border Style="{StaticResource roundPanelBorder}"
                Margin="0,0,0,6"
                Grid.Row="2">
            <dxc:ChartControl Name="chartControl"
                              Background="{LWThemeValue Win11=Brush.Editor.Background}"
                              DataSource="{Binding Orders}"
                              BoundDataChanged="chartControl_BoundDataChanged"
                              BorderThickness="0"
                              Margin="6">
                <dxc:XYDiagram2D x:Name="diagram"
                                 SeriesDataMember="Customer.Country">
                    <dxc:XYDiagram2D.SeriesTemplate>
                        <dxc:AreaSeries2D ArgumentDataMember="OrderDate"
                                          ValueDataMember="TotalAmount"
                                          FilterCriteria="{Binding ElementName=filterBehavior, Path=ActualFilterCriteria}"
                                          CrosshairLabelPattern="{}{S}: {V:C0}"
                                          Transparency="0.5"
                                          MarkerVisible="True"
                                          MarkerSize="10"
                                          CheckedInLegend="False">
                        </dxc:AreaSeries2D>
                    </dxc:XYDiagram2D.SeriesTemplate>
                    <dxc:XYDiagram2D.DefaultPane>
                        <dxc:Pane DomainBorderBrush="Transparent" />
                    </dxc:XYDiagram2D.DefaultPane>
                    <dxc:XYDiagram2D.AxisX>
                        <dxc:AxisX2D>
                            <dxc:AxisX2D.WholeRange>
                                <dxc:Range SideMarginsValue="0.5"
                                           AutoSideMargins="False"/>
                            </dxc:AxisX2D.WholeRange>
                            <dxc:AxisX2D.VisualRange>
                                <dxc:Range MinValue="{Binding ElementName=dateRangeControl, Path=Start, Mode=TwoWay}"
                                           MaxValue="{Binding ElementName=dateRangeControl, Path=End, Mode=TwoWay}"/>
                            </dxc:AxisX2D.VisualRange>
                            <dxc:AxisX2D.DateTimeScaleOptions>
                                <dxc:ManualDateTimeScaleOptions MeasureUnit="Month"
                                                                AggregateFunction="Sum"
                                                                GridAlignment="Month"
                                                                AutoGrid="False"
                                                                GridSpacing="2"/>
                            </dxc:AxisX2D.DateTimeScaleOptions>
                        </dxc:AxisX2D>
                    </dxc:XYDiagram2D.AxisX>
                    <dxc:XYDiagram2D.AxisY>
                        <dxc:AxisY2D Interlaced="False"
                                     Brush="Transparent">
                            <dxc:AxisY2D.Title>
                                <dxc:AxisTitle Content="Revenue ($)"
                                               Alignment="Center"/>
                            </dxc:AxisY2D.Title>
                        </dxc:AxisY2D>
                    </dxc:XYDiagram2D.AxisY>
                </dxc:XYDiagram2D>
                <dxc:ChartControl.Legends>
                    <dxc:Legend MarkerMode="CheckBox"
                                HorizontalPosition="Center"
                                VerticalPosition="TopOutside"
                                Orientation="Horizontal"/>
                </dxc:ChartControl.Legends>
                <dxc:ChartControl.Titles>
                    <dxc:Title Content="Sales by Country"
                               HorizontalAlignment="Center"
                               FontSize="24"/>
                </dxc:ChartControl.Titles>
            </dxc:ChartControl>
        </Border>
    </Grid>
</UserControl>
