        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="Moq" Version="4.21.0"/>

        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100-rc.2.26504.105"/>
        <PackageReference Update="Roslynator.Analyzers" Version="5.0.1"/>
        <PackageReference Update="Roslynator.CodeFixes" Version="5.0.1"/>
        <PackageReference Update="StyleCop.Analyzers" Version="1.3.151-beta"/>
