<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Title>FatturaFacile.Domain.Tests</Title>
    <Product>FatturaFacile.Domain.Tests</Product>
    <Description>Domain unit tests verifying invoice calculations, VAT totals, Swiss cash rounding, and business aggregate invariants for FatturaFacile.</Description>
    <PackageId>FatturaFacile.Domain.Tests</PackageId>
    <RootNamespace>FatturaFacile.Domain.Tests</RootNamespace>
    <AssemblyName>FatturaFacile.Domain.Tests</AssemblyName>
    <Namespace>FatturaFacile.Domain.Tests</Namespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Update="StyleCop.Analyzers" Version="1.3.171-beta">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\FatturaFacile.Domain.Shared\FatturaFacile.Domain.Shared.csproj" />
    <ProjectReference Include="..\..\src\Modules\Invoicing\FatturaFacile.Invoicing.Domain\FatturaFacile.Invoicing.Domain.csproj" />
  </ItemGroup>
</Project>
