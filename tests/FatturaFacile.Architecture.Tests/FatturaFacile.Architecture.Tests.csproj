<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Title>FatturaFacile.Architecture.Tests</Title>
    <Product>FatturaFacile.Architecture.Tests</Product>
    <Description>Architecture and code rule enforcement tests verifying Clean Architecture, CQRS, and dependency conventions for FatturaFacile.</Description>
    <PackageId>FatturaFacile.Architecture.Tests</PackageId>
    <RootNamespace>FatturaFacile.Architecture.Tests</RootNamespace>
    <AssemblyName>FatturaFacile.Architecture.Tests</AssemblyName>
    <Namespace>FatturaFacile.Architecture.Tests</Namespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FatturaFacile\FatturaFacile.csproj" />
  </ItemGroup>
</Project>
